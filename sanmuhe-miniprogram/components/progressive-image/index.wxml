<view class="progressive-image {{loaded ? 'is-loaded' : ''}} {{failed ? 'is-failed' : ''}}">
  <view class="image-placeholder" aria-hidden="{{true}}">
    <view class="placeholder-sheen"></view>
  </view>
  <image
    wx:if="{{src && !failed}}"
    class="image-content"
    src="{{src}}"
    mode="{{mode}}"
    lazy-load="{{lazyLoad}}"
    webp="{{webp}}"
    bindload="handleLoad"
    binderror="handleError"
    aria-role="img"
    aria-label="{{ariaLabel}}"
  ></image>
  <image
    wx:elif="{{fallbackSrc}}"
    class="image-fallback"
    src="{{fallbackSrc}}"
    mode="aspectFit"
    aria-hidden="{{true}}"
  ></image>
</view>
