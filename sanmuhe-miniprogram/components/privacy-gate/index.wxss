.privacy-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10050;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: rgba(18, 24, 20, 0.55);
  box-sizing: border-box;
}

.privacy-card {
  width: 100%;
  max-width: 620rpx;
  max-height: 80vh;
  overflow-x: hidden;
  overflow-y: auto;
  border-radius: 22rpx;
  padding: 28rpx 24rpx 22rpx;
  background: #fffdf8;
  box-shadow: 0 18rpx 48rpx rgba(28, 35, 30, 0.18);
  box-sizing: border-box;
}

.privacy-title {
  color: #273427;
  font-size: 30rpx;
  font-weight: 700;
}

.privacy-copy {
  margin-top: 14rpx;
  color: #687466;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-word;
}

.privacy-link {
  margin-top: 14rpx;
  color: #526b45;
  font-size: 24rpx;
  font-weight: 600;
}

/* 纵向按钮：避开微信 button 默认 min-width 导致横排溢出 */
.privacy-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
  width: 100%;
  box-sizing: border-box;
}

.privacy-cancel,
.privacy-primary {
  display: block;
  width: 100% !important;
  max-width: 100%;
  min-width: 0 !important;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
  padding: 0 20rpx !important;
  margin: 0 !important;
  box-sizing: border-box;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.privacy-primary {
  order: 1;
  color: #fffdf8;
  background: #526b45;
}

.privacy-cancel {
  order: 2;
  color: #526b45;
  background: #f2eee3;
}

.privacy-cancel::after,
.privacy-primary::after {
  border: 0;
}
