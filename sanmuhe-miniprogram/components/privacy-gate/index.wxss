.privacy-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10050;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  background: rgba(18, 24, 20, 0.55);
  box-sizing: border-box;
}

.privacy-card {
  width: 100%;
  max-width: 560rpx;
  border-radius: 22rpx;
  padding: 28rpx 26rpx 22rpx;
  background: #fffdf8;
  box-shadow: 0 18rpx 48rpx rgba(28, 35, 30, 0.18);
  box-sizing: border-box;
}

.privacy-title {
  color: #273427;
  font-size: 30rpx;
  font-weight: 700;
}

.privacy-copy {
  margin-top: 14rpx;
  color: #687466;
  font-size: 24rpx;
  line-height: 1.55;
}

.privacy-link {
  margin-top: 14rpx;
  color: #526b45;
  font-size: 24rpx;
  font-weight: 600;
}

.privacy-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 22rpx;
}

.privacy-cancel,
.privacy-primary {
  width: 100%;
  min-width: 0;
  height: 64rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
  padding: 0 12rpx;
  margin: 0;
}

.privacy-cancel {
  color: #526b45;
  background: #f2eee3;
}

.privacy-primary {
  color: #fffdf8;
  background: #526b45;
}

.privacy-cancel::after,
.privacy-primary::after {
  border: 0;
}
