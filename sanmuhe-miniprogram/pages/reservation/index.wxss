.reservation-page {
  min-height: 100vh;
  padding: 88rpx 0 calc(52rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 92% 18%, rgba(183, 138, 75, 0.09), transparent 28%),
    #efe8dc;
}

.page-nav {
  height: 88rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 140rpx;
  align-items: center;
  padding: 0 28rpx;
  border-bottom: 1rpx solid rgba(93, 77, 57, 0.08);
  background: rgba(250, 246, 238, 0.98);
}

.back-mark {
  color: #1f1b17;
  font-size: 52rpx;
  line-height: 1;
}

.nav-title {
  text-align: center;
}

.nav-title view {
  color: #1f1b17;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.1;
}

.nav-title text {
  display: block;
  margin-top: 6rpx;
  color: #8a8379;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 16rpx;
  letter-spacing: 0.08em;
}

.nav-capsule {
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  justify-self: end;
  padding: 0 12rpx;
  border: 1rpx solid #e6e0d4;
  border-radius: 999rpx;
  background: #fff;
}

.nav-capsule text {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #1f1b17;
}

.nav-capsule view {
  width: 32rpx;
  height: 32rpx;
  margin-left: 10rpx;
  border: 5rpx solid #1f1b17;
  border-radius: 50%;
}

.hero-section {
  position: relative;
  height: 520rpx;
  overflow: hidden;
  background: #8f826d;
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(27, 23, 18, 0) 62%, rgba(27, 23, 18, 0.34) 100%),
    linear-gradient(90deg, rgba(27, 23, 18, 0.12), transparent 38%);
}

.booking-panel {
  position: relative;
  z-index: 2;
  margin: -78rpx 24rpx 0;
  padding: 44rpx 32rpx 34rpx;
  overflow: hidden;
  border: 1rpx solid rgba(122, 101, 74, 0.12);
  border-radius: 34rpx 34rpx 16rpx 16rpx;
  background:
    linear-gradient(rgba(246, 240, 229, 0.94), rgba(246, 240, 229, 0.94)),
    repeating-linear-gradient(0deg, rgba(66, 55, 41, 0.025) 0, rgba(66, 55, 41, 0.025) 1rpx, transparent 1rpx, transparent 5rpx);
  box-shadow: 0 22rpx 60rpx rgba(56, 42, 28, 0.12);
}

.panel-art {
  position: absolute;
  top: 48rpx;
  right: -22rpx;
  width: 250rpx;
  height: 220rpx;
  opacity: 0.34;
  pointer-events: none;
}

.panel-art image {
  width: 100%;
  height: 100%;
  display: block;
}

.room-head {
  position: relative;
  z-index: 1;
  padding-right: 146rpx;
}

.room-overline {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
  color: #8c6a3c;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 17rpx;
  letter-spacing: 0.14em;
  line-height: 1;
}

.room-overline view {
  width: 38rpx;
  height: 1rpx;
  background: rgba(140, 106, 60, 0.5);
}

.room-name {
  color: #2a241d;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.2;
}

.room-city {
  margin-top: 10rpx;
  color: #756b5e;
  font-size: 24rpx;
  line-height: 1.3;
}

.address-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 18rpx;
}

.address-row image {
  width: 28rpx;
  height: 28rpx;
  margin-top: 4rpx;
  flex: 0 0 28rpx;
}

.address-row text {
  flex: 1;
  min-width: 0;
  color: #4a433b;
  font-size: 24rpx;
  line-height: 1.45;
}

.perk-row {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 30rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(111, 92, 68, 0.14);
  border-bottom: 1rpx solid rgba(111, 92, 68, 0.14);
}

.perk-item {
  padding: 0 10rpx;
  color: #5f574d;
  border-right: 1rpx solid rgba(111, 92, 68, 0.18);
  font-size: 22rpx;
  text-align: center;
  line-height: 1.2;
}

.perk-item:last-child {
  border-right: 0;
}

.section-block {
  position: relative;
  z-index: 1;
  margin-top: 38rpx;
}

.section-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-index {
  color: #b78a4b;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 18rpx;
  line-height: 1;
}

.block-title {
  color: #2a241d;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.2;
}

.section-hint {
  flex-shrink: 0;
  color: #9a9288;
  font-size: 22rpx;
}

.date-scroll {
  width: 100%;
  margin-top: 18rpx;
  white-space: nowrap;
}

.date-card {
  width: 110rpx;
  height: 118rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  color: #2c2822;
  border: 1rpx solid #e5dfd3;
  border-radius: 12rpx;
  background: rgba(255, 253, 248, 0.74);
  vertical-align: top;
  box-sizing: border-box;
}

.date-card.active {
  color: #f8f1e5;
  border-color: #344b38;
  background: #344b38;
  box-shadow: 0 10rpx 22rpx rgba(52, 75, 56, 0.18);
}

.date-week {
  font-size: 24rpx;
  line-height: 1.2;
}

.date-num {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.date-card.more image {
  width: 30rpx;
  height: 30rpx;
  display: block;
  margin-bottom: 8rpx;
}

.date-card.more text {
  font-size: 22rpx;
}

.period-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.period-chip {
  min-width: 0;
  min-height: 122rpx;
  padding: 22rpx 22rpx;
  color: #2c2822;
  border: 1rpx solid #e5dfd3;
  border-radius: 12rpx;
  background: rgba(255, 253, 248, 0.74);
  box-sizing: border-box;
}

.period-chip.active {
  color: #f8f1e5;
  border-color: #344b38;
  background: linear-gradient(145deg, #3f5b43 0%, #2f4734 100%);
  box-shadow: 0 12rpx 26rpx rgba(52, 75, 56, 0.18);
}

.period-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.period-label {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
}

.period-price {
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.period-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.3;
  opacity: 0.78;
}

.time-picker-card {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e5dfd3;
  border-radius: 12rpx;
  background: rgba(255, 253, 248, 0.78);
}

.time-start-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto;
  align-items: center;
  gap: 8rpx;
  min-height: 154rpx;
  padding: 24rpx 22rpx 24rpx 26rpx;
}

.time-col {
  min-width: 0;
}

.time-col.is-end {
  text-align: right;
}

.time-caption {
  display: block;
  color: #8f877c;
  font-size: 22rpx;
  line-height: 1.2;
}

.time-value {
  display: block;
  margin-top: 10rpx;
  color: #1f1b17;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.time-value.soft {
  color: #4a433b;
  font-weight: 500;
}

.time-divider {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 72rpx;
}

.time-line {
  width: 100%;
  height: 1rpx;
  background: #e2dbcf;
}

.time-plus {
  color: #3f5834;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.time-chevron {
  color: #b0a89d;
  font-size: 36rpx;
  line-height: 1;
  padding-left: 4rpx;
}

.fee-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #efe9de;
  background: rgba(218, 204, 179, 0.2);
}

.fee-left {
  min-width: 0;
}

.fee-label {
  display: block;
  color: #5c544b;
  font-size: 24rpx;
  font-weight: 500;
}

.fee-sub {
  display: block;
  margin-top: 6rpx;
  color: #958c81;
  font-size: 21rpx;
  line-height: 1.3;
}

.fee-price {
  flex-shrink: 0;
  color: #344b38;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.next-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  min-height: 102rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 32rpx;
  padding: 16rpx 20rpx;
  color: #fffaf0;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #3d5941 0%, #2f4734 100%);
  box-shadow: 0 14rpx 30rpx rgba(47, 71, 52, 0.2);
  box-sizing: border-box;
}

.next-btn::after {
  border: none;
}

.next-main {
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.1;
}

.next-sub {
  font-size: 22rpx;
  opacity: 0.88;
  line-height: 1.2;
}

.booking-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 19, 0.4);
}

.booking-sheet {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: 16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background:
    linear-gradient(rgba(246, 240, 229, 0.98), rgba(246, 240, 229, 0.98)),
    repeating-linear-gradient(0deg, rgba(66, 55, 41, 0.025) 0, rgba(66, 55, 41, 0.025) 1rpx, transparent 1rpx, transparent 5rpx);
  box-sizing: border-box;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 4rpx auto 18rpx;
  border-radius: 999rpx;
  background: #ddd5c8;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.sheet-head-copy {
  min-width: 0;
}

.sheet-title {
  color: #1f1b17;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.2;
}

.sheet-sub {
  margin-top: 8rpx;
  color: #7a7268;
  font-size: 24rpx;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5c544b;
  border-radius: 50%;
  background: #efe9de;
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
}

.summary-card {
  margin-top: 22rpx;
  padding: 8rpx 22rpx;
  border: 1rpx solid #e5dfd3;
  border-radius: 12rpx;
  background: rgba(255, 253, 248, 0.76);
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 72rpx;
  border-bottom: 1rpx solid #f0ebe2;
}

.summary-row:last-child {
  border-bottom: 0;
}

.summary-k {
  flex-shrink: 0;
  color: #8a8278;
  font-size: 24rpx;
}

.summary-v {
  min-width: 0;
  color: #2a241e;
  font-size: 26rpx;
  font-weight: 500;
  text-align: right;
}

.summary-v.price {
  color: #3f5834;
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-section {
  margin-top: 26rpx;
}

.people-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.sheet-label {
  color: #1f1b17;
  font-size: 28rpx;
  font-weight: 500;
}

.sheet-label-hint {
  margin-left: 10rpx;
  color: #9a9288;
  font-size: 22rpx;
  font-weight: 400;
}

.people-stepper {
  display: grid;
  grid-template-columns: 60rpx 68rpx 60rpx;
  overflow: hidden;
  border: 1rpx solid #e5dfd3;
  border-radius: 12rpx;
  background: rgba(255, 253, 248, 0.82);
}

.people-stepper view,
.people-stepper text {
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1f1b17;
  font-size: 28rpx;
}

.people-stepper view {
  background: #f4efe6;
}

.form-fields {
  display: grid;
  gap: 14rpx;
}

.field,
.textarea-field {
  width: 100%;
  padding: 0 22rpx;
  color: #1f1b17;
  border: 1rpx solid #e5dfd3;
  border-radius: 12rpx;
  background: rgba(255, 253, 248, 0.82);
  box-sizing: border-box;
  font-size: 28rpx;
}

.field {
  height: 84rpx;
}

.textarea-field {
  min-height: 140rpx;
  padding: 18rpx 22rpx;
  line-height: 1.45;
}

.booking-note {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  color: #746a5c;
  border-radius: 14rpx;
  background: rgba(63, 88, 52, 0.06);
  font-size: 23rpx;
  line-height: 1.5;
}

.submit-reserve {
  width: 100%;
  min-height: 90rpx;
  margin-top: 24rpx;
  color: #fffaf0;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #3d5941 0%, #2f4734 100%);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 26rpx rgba(53, 81, 45, 0.22);
}

.submit-reserve::after {
  border: none;
}
