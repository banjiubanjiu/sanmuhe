.reservation-page {
  padding: 88rpx 28rpx calc(230rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.back-mark {
  color: #111;
  font-size: 46rpx;
  line-height: 1;
}

.page-title {
  text-align: center;
  color: #111;
  font-size: 32rpx;
  font-weight: 800;
}

.filter-row {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
  overflow-x: auto;
}

.filter-pill {
  flex: 0 0 auto;
  min-height: 58rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  color: #333;
  border: 1rpx solid #eeeeee;
  border-radius: 999rpx;
  background: #fff;
  font-size: 24rpx;
}

.room-list {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  margin-top: 30rpx;
}

.room-card {
  display: flex;
  gap: 30rpx;
  min-height: 208rpx;
  padding: 14rpx 22rpx 14rpx 0;
  text-align: left;
  border: 1rpx solid #f0f0f0;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
}

.room-card.active {
  border-color: #eeeeee;
}

.room-image {
  flex: 0 0 269rpx;
  width: 269rpx;
  height: 197rpx;
  border-radius: 10rpx;
  background: #eee;
}

.room-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.room-title {
  overflow: hidden;
  color: #111;
  font-size: 32rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.room-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
}

.room-price {
  color: #111;
  font-size: 28rpx;
  font-weight: 800;
}

.room-price text {
  color: #777;
  font-size: 20rpx;
  font-weight: 500;
}

.bookable {
  color: #4f7d43;
  font-size: 24rpx;
}

.bookable.full {
  color: #888;
}

.reserve-bar {
  position: fixed;
  right: 28rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  color: #fff;
  border-radius: 18rpx;
  background: #223529;
  box-shadow: 0 18rpx 36rpx rgba(23, 44, 30, 0.22);
}

.reserve-title {
  max-width: 430rpx;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reserve-meta {
  margin-top: 4rpx;
  color: #dbe7d6;
  font-size: 22rpx;
}

.reserve-btn {
  min-width: 168rpx;
  min-height: 64rpx;
  color: #244f2a;
  border-radius: 999rpx;
  background: #fff;
  font-size: 26rpx;
  font-weight: 800;
}

.booking-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 19, 0.36);
}

.booking-sheet {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
}

.sheet-head,
.people-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  color: #111;
  font-size: 34rpx;
  font-weight: 900;
}

.sheet-close {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #555;
  border-radius: 50%;
  background: #f4f4f0;
  font-size: 40rpx;
}

.sheet-section {
  margin-top: 28rpx;
}

.sheet-label {
  margin-bottom: 16rpx;
  color: #111;
  font-size: 28rpx;
  font-weight: 800;
}

.option-scroll {
  white-space: nowrap;
}

.option-pill {
  display: inline-flex;
  min-height: 58rpx;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  padding: 0 22rpx;
  color: #555;
  border: 1rpx solid #e5e5e5;
  border-radius: 999rpx;
  background: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.option-pill.active {
  color: #4f7d43;
  border-color: #4f7d43;
  background: #f2f8ee;
}

.time-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.time-grid .option-pill {
  margin-right: 0;
}

.people-stepper {
  display: grid;
  grid-template-columns: 62rpx 72rpx 62rpx;
  overflow: hidden;
  border: 1rpx solid #e5e5e5;
  border-radius: 10rpx;
}

.people-stepper view,
.people-stepper text {
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111;
  font-size: 28rpx;
}

.people-stepper view {
  background: #f6f6f2;
}

.form-fields {
  display: grid;
  gap: 16rpx;
}

.submit-reserve {
  width: 100%;
  min-height: 86rpx;
  margin-top: 26rpx;
  color: #fff;
  border-radius: 999rpx;
  background: #4f7d43;
  font-size: 30rpx;
  font-weight: 900;
}
