<view class="page reservation-page">
  <view class="page-nav">
    <view class="back-mark" bindtap="goBack">‹</view>
    <view class="nav-title">
      <view>茶室预定</view>
      <text>TEA ROOM BOOKING</text>
    </view>
    <view class="nav-capsule">
      <text></text>
      <text></text>
      <text></text>
      <view></view>
    </view>
  </view>

  <view class="hero-section">
    <image class="hero-image" src="/assets/images/reservation-hero.jpg" mode="widthFix"></image>
  </view>

  <view class="booking-panel">
    <view class="panel-art">
      <image src="/assets/images/reservation-mountain.jpg" mode="aspectFit"></image>
    </view>

    <view class="room-name">{{selectedRoom.displayName}}</view>
    <view class="room-city">{{selectedRoom.city}}</view>

    <view class="address-row">
      <image src="/assets/icons/home-location.png" mode="aspectFit"></image>
      <view>{{selectedRoom.address}}</view>
    </view>

    <view class="block-title">选择日期</view>
    <scroll-view scroll-x class="date-scroll" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{visibleDays}}"
        wx:key="value"
        class="date-card {{selectedDay === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="chooseDay"
      >
        <view>{{item.label}}</view>
        <text>{{item.slashDisplay}}</text>
      </view>
      <view wx:if="{{visibleDays.length < days.length}}" class="date-card more" bindtap="showMoreDates">
        <image src="/assets/icons/home-calendar.png" mode="aspectFit"></image>
        <text>更多日期</text>
      </view>
    </scroll-view>

    <view class="time-head">
      <view class="block-title">选择时间</view>
      <text>每次体验时长 2 小时</text>
    </view>

    <view class="time-grid">
      <view
        wx:for="{{timeOptions}}"
        wx:key="value"
        class="time-card {{selectedTime === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="chooseTime"
      >
        <view>{{item.value}}</view>
        <text>剩余 {{item.seats}} 席</text>
      </view>
    </view>

    <button class="next-btn" bindtap="openBooking">下一步 <text>→</text></button>
  </view>

  <view wx:if="{{bookingOpen}}" class="booking-mask" bindtap="closeBooking">
    <view class="booking-sheet" catchtap="noop">
      <view class="sheet-head">
        <view>
          <view class="sheet-title">{{selectedRoom.displayName}} · {{selectedRoom.city}}</view>
          <view class="muted">{{selectedDayText}} {{selectedTime}} · {{people}}人</view>
        </view>
        <view class="sheet-close" bindtap="closeBooking">×</view>
      </view>

      <view class="sheet-section people-line">
        <view class="sheet-label">到店人数</view>
        <view class="people-stepper">
          <view data-step="-1" bindtap="setPeople">−</view>
          <text>{{people}}</text>
          <view data-step="1" bindtap="setPeople">+</view>
        </view>
      </view>

      <view class="sheet-section form-fields">
        <input class="field" placeholder="联系人" data-field="name" value="{{name}}" bindinput="onInput" />
        <input class="field" placeholder="手机号" type="number" data-field="phone" value="{{phone}}" bindinput="onInput" />
        <textarea class="textarea-field" placeholder="备注，如茶具需求、到店时间说明" data-field="note" value="{{note}}" bindinput="onInput"></textarea>
      </view>

      <view class="booking-note">预约提交后由门店人工确认；如时段冲突，后台会拦截并提示重新选择。</view>

      <button class="submit-reserve" bindtap="submitReservation">提交预约</button>
    </view>
  </view>
</view>
