<view class="page reservation-page">
  <view class="page-nav">
    <view class="back-mark" bindtap="goBack">‹</view>
    <view class="nav-title">
      <view>茶室预定</view>
      <text>TEA ROOM BOOKING</text>
    </view>
    <view class="nav-capsule">
      <text></text>
      <text></text>
      <text></text>
      <view></view>
    </view>
  </view>

  <view class="hero-section">
    <image class="hero-image" src="{{selectedRoom.image || '/assets/images/reservation-hero.jpg'}}" mode="aspectFill"></image>
    <view class="hero-shade"></view>
  </view>

  <view class="booking-panel">
    <view class="panel-art">
      <image src="/assets/images/reservation-mountain.jpg" mode="aspectFit"></image>
    </view>

    <view class="room-head">
      <view class="room-overline">
        <text>PRIVATE TEA ROOM</text>
        <view></view>
        <text>{{rooms.length > 1 ? '选席' : '01'}}</text>
      </view>
      <view class="room-name">{{selectedRoom.displayName}}</view>
      <view class="room-city">{{selectedRoom.city}}</view>
      <view class="address-row">
        <image src="/assets/icons/home-location.png" mode="aspectFit"></image>
        <text>{{selectedRoom.address}}</text>
      </view>
    </view>

    <view wx:if="{{rooms.length > 1}}" class="room-picker">
      <view class="section-label">
        <view class="section-title-group">
          <text class="section-index">00</text>
          <view class="block-title">选择茶室</view>
        </view>
      </view>
      <scroll-view scroll-x class="room-scroll" enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{rooms}}"
          wx:key="id"
          class="room-chip {{selectedRoomId === item.id ? 'active' : ''}} {{item.available ? '' : 'disabled'}}"
          data-id="{{item.id}}"
          bindtap="selectRoom"
        >
          <text class="room-chip-name">{{item.displayName}}</text>
          <text class="room-chip-meta">{{item.capacity || item.status}}</text>
        </view>
      </scroll-view>
    </view>

    <view class="perk-row">
      <view class="perk-item" wx:for="{{roomPerks}}" wx:key="*this">{{item}}</view>
      <view class="perk-item" wx:if="{{!roomPerks.length}}">满 {{minHours}} 小时起</view>
    </view>

    <view class="section-block">
      <view class="section-label">
        <view class="section-title-group">
          <text class="section-index">01</text>
          <view class="block-title">选择日期</view>
        </view>
      </view>
      <scroll-view scroll-x class="date-scroll" enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{visibleDays}}"
          wx:key="value"
          class="date-card {{selectedDay === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="chooseDay"
        >
          <view class="date-week">{{item.label}}</view>
          <text class="date-num">{{item.slashDisplay}}</text>
        </view>
        <view wx:if="{{visibleDays.length < days.length}}" class="date-card more" bindtap="showMoreDates">
          <image src="/assets/icons/home-calendar.png" mode="aspectFit"></image>
          <text>更多</text>
        </view>
      </scroll-view>
    </view>

    <view class="section-block">
      <view class="section-label">
        <view class="section-title-group">
          <text class="section-index">02</text>
          <view class="block-title">选择开始与结束</view>
        </view>
        <text class="section-hint">半小时一档 · 满 {{minHours}} 小时</text>
      </view>

      <view class="slot-legend">
        <text class="leg start">开始</text>
        <text class="leg end">结束</text>
        <text class="leg range">已选</text>
        <text class="leg busy">已约</text>
      </view>

      <view class="slot-grid">
        <view
          wx:for="{{slotCells}}"
          wx:key="time"
          class="slot-cell status-{{item.status}} {{item.disabled ? 'is-disabled' : ''}}"
          data-time="{{item.time}}"
          data-status="{{item.status}}"
          bindtap="onTapSlot"
        >
          <text class="slot-time">{{item.time}}</text>
          <text wx:if="{{item.tag}}" class="slot-tag">{{item.tag}}</text>
        </view>
      </view>

      <view class="slot-tip">
        <block wx:if="{{pickMode === 'start' || !selectedTime}}">先点开始时刻，再点结束时刻</block>
        <block wx:elif="{{pickMode === 'end'}}">已选开始 {{selectedTime}}，请再选结束（至少满 {{minHours}} 小时）</block>
        <block wx:else>已选 {{selectedSlotLabel}} · 该时段归您使用</block>
      </view>
    </view>

    <view class="fee-bar">
      <view class="fee-left">
        <text class="fee-label">本场费用</text>
        <text class="fee-sub">{{feeLabel || '满 2 小时按价带计，超出每 30 分钟加价'}}</text>
      </view>
      <text class="fee-price" wx:if="{{priceReady}}">¥{{selectedPrice}}</text>
      <text class="fee-price soft" wx:else>—</text>
    </view>

    <button class="next-btn" hover-class="none" bindtap="openBooking">
      <text class="next-main">下一步</text>
      <text class="next-sub" wx:if="{{priceReady}}">{{selectedSlotLabel}} · ¥{{selectedPrice}}</text>
      <text class="next-sub" wx:else>选满 {{minHours}} 小时后继续</text>
    </button>
  </view>

  <view wx:if="{{bookingOpen}}" class="booking-mask" bindtap="closeBooking">
    <view class="booking-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view class="sheet-head-copy">
          <view class="sheet-title">确认预约信息</view>
          <view class="sheet-sub">{{selectedRoom.displayName}}</view>
        </view>
        <view class="sheet-close" bindtap="closeBooking">×</view>
      </view>

      <view class="summary-card">
        <view class="summary-row">
          <text class="summary-k">日期</text>
          <text class="summary-v">{{selectedDayText}}</text>
        </view>
        <view class="summary-row">
          <text class="summary-k">时段</text>
          <text class="summary-v">{{selectedSlotLabel}} · {{selectedPeriodLabel}}</text>
        </view>
        <view class="summary-row">
          <text class="summary-k">时长</text>
          <text class="summary-v">{{durationHoursLabel}} 小时（满 {{minHours}} 小时起）</text>
        </view>
        <view class="summary-row">
          <text class="summary-k">费用</text>
          <text class="summary-v price">¥{{selectedPrice}}</text>
        </view>
      </view>

      <view class="sheet-section people-line">
        <view class="sheet-label">到店人数
          <text class="sheet-label-hint">限 {{maxPeople}} 位以内</text>
        </view>
        <view class="people-stepper">
          <view data-step="-1" bindtap="setPeople">−</view>
          <text>{{people}}</text>
          <view data-step="1" bindtap="setPeople">+</view>
        </view>
      </view>

      <view class="sheet-section form-fields">
        <input class="field" placeholder="联系人" data-field="name" value="{{name}}" bindinput="onInput" />
        <view class="phone-row">
          <input
            class="field phone-input"
            placeholder="手机号"
            type="number"
            maxlength="11"
            data-field="phone"
            value="{{phone}}"
            bindinput="onInput"
          />
          <button
            class="phone-auth-btn"
            open-type="getPhoneNumber"
            loading="{{phoneResolving}}"
            disabled="{{phoneResolving}}"
            bindgetphonenumber="handlePhoneAuth"
          >微信获取</button>
        </view>
        <textarea class="textarea-field" placeholder="备注（选填）" data-field="note" value="{{note}}" bindinput="onInput"></textarea>
      </view>

      <view class="sheet-section payment-options">
        <view wx:if="{{isMember}}" class="payment-option {{payMode === 'balance' ? 'active' : ''}} {{!balanceAvailable ? 'disabled' : ''}}" data-mode="balance" bindtap="choosePayMode">
          <view>会员余额</view>
          <text>余额 ¥{{walletBalance}}{{balanceAvailable ? '' : ' · 不足'}}</text>
        </view>
        <view class="payment-option {{payMode === 'wechat' ? 'active' : ''}}" data-mode="wechat" bindtap="choosePayMode">
          <view>微信支付</view>
          <text>支付成功后确认</text>
        </view>
      </view>

      <view class="booking-note">无论是否用满，所选时段均归您；最短 {{minHours}} 小时。{{giftTeaCopy}}提交后需在 {{lockMinutes}} 分钟内完成{{payMode === 'balance' ? '余额支付' : '微信支付'}}，支付成功即确认预约。已支付预约须提前 {{cancelAdvanceHours}} 小时取消，费用原路退回。日间满时长起价 ¥{{dayBasePrice}}（以后台设置的预约规则为准）。</view>

      <button class="submit-reserve" hover-class="none" bindtap="submitReservation">{{payMode === 'balance' ? '余额支付' : '支付并预约'}} · ¥{{selectedPrice}}</button>
    </view>
  </view>

  <privacy-gate
    show="{{privacyGateOpen}}"
    purpose="{{privacyPurpose}}"
    contractName="{{privacyContractName}}"
    bindagree="onPrivacyAgree"
    bindcancel="onPrivacyCancel"
  />
</view>
