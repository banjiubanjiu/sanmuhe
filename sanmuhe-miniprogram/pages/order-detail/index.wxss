.detail-page {
  min-height: 100vh;
  padding: 0 28rpx calc(56rpx + env(safe-area-inset-bottom));
  color: var(--hx-ink);
  background: var(--hx-paper);
}

.detail-page.has-action-bar {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.detail-page.is-dinein {
  padding-right: 0;
  padding-left: 0;
  background: var(--hx-paper);
}

.detail-page.is-dinein.has-action-bar {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.detail-nav {
  min-height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
  margin: 0 -28rpx;
  padding-right: 28rpx;
  padding-bottom: 8rpx;
  padding-left: 28rpx;
  box-sizing: border-box;
  background: var(--hx-paper);
}

.nav-back {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back image {
  width: 42rpx;
  height: 42rpx;
}

.nav-title {
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
}

.status-hero {
  margin: 30rpx -28rpx 0;
  padding: 42rpx 34rpx 36rpx;
  border-top: 1rpx solid rgba(23, 59, 42, 0.06);
  border-bottom: 1rpx solid rgba(23, 59, 42, 0.08);
  background: var(--hx-sidebar);
}

.status-hero.status-warning {
  background: #f3ead9;
}

.status-hero.status-danger {
  background: #f2e4df;
}

.status-hero.status-quiet {
  background: #ebe9e3;
}

.status-topline {
  color: var(--hx-muted);
  font-size: 23rpx;
}

.status-title {
  margin-top: 14rpx;
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.08;
}

.status-copy {
  margin-top: 16rpx;
  color: var(--hx-text);
  font-size: 25rpx;
  line-height: 1.55;
}

/* 堂饮：氛围图 + 茶笺（对齐 HTML 设计稿） */
.dinein-hero {
  position: relative;
  height: 420rpx;
  overflow: hidden;
}

.dinein-hero-img {
  width: 100%;
  height: 118%;
  display: block;
  object-fit: cover;
  object-position: 50% 28%;
}

.dinein-hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(23, 59, 42, 0.22), rgba(23, 59, 42, 0.08) 40%, rgba(23, 59, 42, 0.55));
}

.dinein-nav {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  left: 0;
  margin: 0;
  padding-left: 20rpx;
  padding-right: 20rpx;
  background: transparent;
}

.dinein-nav-title {
  color: #fffdf8;
}

.dinein-nav .nav-back {
  color: #fffdf8;
}

.dinein-nav .nav-back image {
  filter: brightness(0) invert(1);
}

.dinein-sheet {
  position: relative;
  z-index: 3;
  margin: -64rpx 24rpx 0;
  padding: 46rpx 24rpx 18rpx;
  background: var(--hx-surface);
  text-align: center;
}

.dinein-brand {
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 16rpx;
  text-indent: 16rpx;
}

.dinein-status {
  margin-top: 24rpx;
  color: var(--hx-gold);
  font-size: 22rpx;
  letter-spacing: 12rpx;
  text-indent: 12rpx;
}

.dinein-table {
  margin: 10rpx 0 0;
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 128rpx;
  font-weight: 600;
  line-height: 0.95;
  letter-spacing: 8rpx;
}

.dinein-list {
  padding: 30rpx 28rpx 4rpx;
}

.dinein-list-cap {
  margin-bottom: 8rpx;
  color: var(--hx-muted);
  font-size: 21rpx;
  letter-spacing: 6rpx;
}

.dinein-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--hx-line);
}

.dinein-item:last-child {
  border-bottom: 0;
}

.dinein-pic {
  flex: 0 0 116rpx;
  width: 116rpx;
  height: 116rpx;
  object-fit: cover;
  background: #efe8da;
}

.dinein-pic-fallback {
  padding: 22rpx;
  box-sizing: border-box;
}

.dinein-copy {
  flex: 1;
  min-width: 0;
}

.dinein-name {
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 30rpx;
  font-weight: 600;
}

.dinein-meta {
  margin-top: 6rpx;
  color: var(--hx-muted);
  font-size: 23rpx;
}

.dinein-yen {
  flex: 0 0 auto;
  color: var(--hx-ink);
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 27rpx;
  font-weight: 600;
}

.dinein-bill {
  margin: 6rpx 28rpx 0;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--hx-ink);
}

.dinein-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  color: var(--hx-muted);
  font-size: 23rpx;
}

.dinein-sum {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 8rpx;
  padding-top: 20rpx;
}

.dinein-sum text:first-child {
  color: var(--hx-ink);
  font-size: 23rpx;
  letter-spacing: 8rpx;
}

.dinein-total {
  color: var(--hx-ink);
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 48rpx;
  font-weight: 600;
}

.dinein-cta-wrap {
  padding: 30rpx 28rpx 40rpx;
}

.dinein-cta {
  width: 100%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f8f0df;
  background: var(--hx-ink);
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  border-radius: 0;
  border: none;
}

.dinein-cta::after {
  border: none;
}

.dinein-after-sale {
  margin-right: 28rpx;
  margin-left: 28rpx;
}

.status-order-no {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 28rpx;
  color: var(--hx-muted);
  font-size: 22rpx;
}

.copy-link {
  color: var(--hx-action);
  font-weight: 600;
}

.detail-surface {
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid var(--hx-line);
  border-radius: 18rpx;
  background: var(--hx-surface);
}

.section-title {
  color: var(--hx-text);
  font-size: 30rpx;
  font-weight: 600;
}

.timeline-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.timeline-copy-link {
  color: var(--hx-action);
  font-size: 22rpx;
  padding: 10rpx 0 10rpx 24rpx;
}

.timeline {
  margin-top: 28rpx;
}

.timeline-row {
  display: grid;
  grid-template-columns: 30rpx 1fr;
  gap: 16rpx;
  min-height: 112rpx;
}

.timeline-track {
  position: relative;
  display: flex;
  justify-content: center;
}

.timeline-dot {
  position: relative;
  z-index: 1;
  width: 14rpx;
  height: 14rpx;
  margin-top: 8rpx;
  border: 4rpx solid #fffdf8;
  border-radius: 50%;
  background: #a7a197;
  box-shadow: 0 0 0 2rpx #a7a197;
}

.timeline-row.is-latest .timeline-dot {
  background: #2f633f;
  box-shadow: 0 0 0 2rpx #2f633f;
}

.timeline-line {
  position: absolute;
  top: 24rpx;
  bottom: 0;
  width: 1rpx;
  background: #d8d2c8;
}

.timeline-copy {
  padding-bottom: 24rpx;
}

.timeline-title {
  color: var(--hx-text);
  font-size: 26rpx;
  font-weight: 600;
}

.timeline-row.is-latest .timeline-title {
  color: var(--hx-ink);
}

.timeline-time,
.timeline-detail,
.section-empty {
  margin-top: 7rpx;
  color: var(--hx-muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.timeline-detail {
  color: var(--hx-muted);
  font-size: 23rpx;
}

.section-empty {
  margin-top: 20rpx;
}

.item-list {
  margin-top: 20rpx;
}

.item-row {
  display: grid;
  grid-template-columns: 104rpx 1fr auto;
  gap: 18rpx;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--hx-line);
}

.item-row:last-child {
  border-bottom: 0;
}

.item-image {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 14rpx;
  background: #ece7dc;
}

.item-image image {
  width: 100%;
  height: 100%;
}

.item-image .item-fallback {
  width: 48rpx;
  height: 48rpx;
}

.item-copy {
  min-width: 0;
}

.item-name {
  overflow: hidden;
  color: var(--hx-text);
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-option,
.item-quantity {
  margin-top: 7rpx;
  color: var(--hx-muted);
  font-size: 21rpx;
}

.item-price {
  color: #6f5635;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 25rpx;
  font-weight: 600;
}

.info-row,
.amount-row,
.amount-total {
  display: grid;
  grid-template-columns: 130rpx 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
  font-size: 24rpx;
}

.info-row > text,
.amount-row > text {
  color: var(--hx-muted);
}

.info-row > view,
.amount-row > view {
  color: var(--hx-text);
  line-height: 1.55;
  text-align: right;
}

.amount-row.saving > view {
  color: #9a6336;
}

.amount-total {
  align-items: end;
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--hx-line);
}

.amount-total > text {
  color: var(--hx-text);
  font-weight: 600;
}

.amount-total > view {
  color: #6f5635;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 40rpx;
  font-weight: 600;
  text-align: right;
}

.amount-total > view text {
  margin-right: 3rpx;
  font-size: 24rpx;
}

.created-time {
  margin-top: 18rpx;
  color: var(--hx-muted);
  font-size: 21rpx;
  text-align: right;
}

.logistics-hint-row {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--hx-line);
}

.logistics-hint-text {
  color: var(--hx-muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.logistics-hint-text.is-error {
  color: #a94a32;
}

.logistics-retry-link {
  margin-left: 12rpx;
  color: var(--hx-action);
  text-decoration: underline;
  padding: 8rpx 4rpx;
}

.logistics-hint-row-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logistics-updated {
  color: var(--hx-muted);
  font-size: 22rpx;
}

.logistics-no-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(23, 59, 42, 0.05);
}

.logistics-no-label {
  color: var(--hx-muted);
  font-size: 21rpx;
}

.logistics-no-value {
  color: var(--hx-ink);
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.logistics-no-company {
  margin-left: auto;
  color: var(--hx-muted);
  font-size: 21rpx;
}

.after-sale-status {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid #ead6cf;
  border-radius: 18rpx;
  background: #f7ebe7;
}

.after-sale-title {
  color: #87463c;
  font-size: 27rpx;
  font-weight: 600;
}

.after-sale-copy {
  margin-top: 8rpx;
  color: #7a625d;
  font-size: 22rpx;
  line-height: 1.5;
}

.refund-amount {
  flex: 0 0 auto;
  color: #87463c;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 600;
}

.after-sale-form {
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid #e2d3ca;
  border-radius: 18rpx;
  background: #fff9f4;
}

.after-sale-form textarea {
  width: 100%;
  min-height: 190rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  color: #3f3a34;
  border: 1rpx solid #e5dbcf;
  border-radius: 14rpx;
  background: #fffdf9;
  font-size: 25rpx;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.form-actions button {
  min-width: 150rpx;
  height: 70rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.form-cancel {
  color: #6f685f;
  border: 1rpx solid #d9d1c5;
}

.form-submit {
  color: #fffaf0;
  background: #173b2a;
}

.secondary-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.secondary-actions button {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0;
  padding: 0 24rpx;
  color: #536057;
  border: 1rpx solid #ddd5ca;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.78);
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 500;
}

.secondary-actions button::after {
  border: none;
}

.secondary-actions image {
  width: 28rpx;
  height: 28rpx;
}

.detail-action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--hx-line);
  background: var(--hx-surface);
  box-shadow: 0 -12rpx 32rpx rgba(61, 47, 31, 0.08);
}

.detail-action-bar button {
  min-width: 178rpx;
  height: 78rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  line-height: 78rpx;
}

.detail-action-bar button::after {
  border: none;
}

.detail-action-bar .primary-action {
  min-width: 178rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.primary-action {
  color: #fffaf0;
  background: var(--hx-ink);
}

.secondary-action {
  color: var(--hx-action);
  border: 1rpx solid var(--hx-action);
  background: var(--hx-surface);
  opacity: 0.92;
}

.danger-action {
  color: #a64b3c;
  border: 1rpx solid rgba(166, 75, 60, 0.4);
  background: #fffdf8;
}

.detail-loading,
.detail-state {
  padding: 160rpx 34rpx 80rpx;
  color: var(--hx-muted);
  text-align: center;
}

.loading-mark {
  width: 46rpx;
  height: 46rpx;
  margin: 0 auto 24rpx;
  border: 4rpx solid var(--hx-line);
  border-top-color: var(--hx-action);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.detail-state image {
  width: 82rpx;
  height: 82rpx;
  opacity: 0.65;
}

.state-title {
  margin-top: 24rpx;
  color: #2d342e;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 600;
}

.state-copy {
  margin-top: 12rpx;
  color: #7b7266;
  font-size: 24rpx;
}

.state-action {
  min-width: 200rpx;
  height: 74rpx;
  margin: 30rpx auto 0;
  color: #fffaf0;
  border-radius: 999rpx;
  background: #173b2a;
  font-size: 25rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
