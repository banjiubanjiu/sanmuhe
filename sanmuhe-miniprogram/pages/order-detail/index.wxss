.detail-page {
  min-height: 100vh;
  padding: 88rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  color: #173b2a;
  background: #f7f4ec;
}

.detail-page.has-action-bar {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.detail-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.nav-back {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back image {
  width: 42rpx;
  height: 42rpx;
}

.nav-title {
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
}

.status-hero {
  margin: 30rpx -28rpx 0;
  padding: 42rpx 34rpx 36rpx;
  border-top: 1rpx solid rgba(23, 59, 42, 0.06);
  border-bottom: 1rpx solid rgba(23, 59, 42, 0.08);
  background: #e8efe5;
}

.status-hero.status-warning {
  background: #f3ead9;
}

.status-hero.status-danger {
  background: #f2e4df;
}

.status-hero.status-quiet {
  background: #ebe9e3;
}

.status-topline {
  color: #6f685f;
  font-size: 23rpx;
}

.status-title {
  margin-top: 14rpx;
  color: #173b2a;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.08;
}

.status-copy {
  margin-top: 16rpx;
  color: #5e645e;
  font-size: 25rpx;
  line-height: 1.55;
}

.status-order-no {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 28rpx;
  color: #71695e;
  font-size: 22rpx;
}

.copy-link {
  color: #28583a;
  font-weight: 600;
}

.detail-surface {
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid #e8e1d5;
  border-radius: 18rpx;
  background: #fffdf8;
}

.section-title {
  color: #2b332e;
  font-size: 30rpx;
  font-weight: 600;
}

.timeline {
  margin-top: 28rpx;
}

.timeline-row {
  display: grid;
  grid-template-columns: 30rpx 1fr;
  gap: 16rpx;
  min-height: 112rpx;
}

.timeline-track {
  position: relative;
  display: flex;
  justify-content: center;
}

.timeline-dot {
  position: relative;
  z-index: 1;
  width: 14rpx;
  height: 14rpx;
  margin-top: 8rpx;
  border: 4rpx solid #fffdf8;
  border-radius: 50%;
  background: #a7a197;
  box-shadow: 0 0 0 2rpx #a7a197;
}

.timeline-row.is-latest .timeline-dot {
  background: #2f633f;
  box-shadow: 0 0 0 2rpx #2f633f;
}

.timeline-line {
  position: absolute;
  top: 24rpx;
  bottom: 0;
  width: 1rpx;
  background: #d8d2c8;
}

.timeline-copy {
  padding-bottom: 24rpx;
}

.timeline-title {
  color: #4f4a43;
  font-size: 26rpx;
  font-weight: 600;
}

.timeline-row.is-latest .timeline-title {
  color: #1e4b30;
}

.timeline-time,
.timeline-detail,
.section-empty {
  margin-top: 7rpx;
  color: #8a8176;
  font-size: 21rpx;
  line-height: 1.5;
}

.timeline-detail {
  color: #6f685f;
  font-size: 23rpx;
}

.section-empty {
  margin-top: 20rpx;
}

.item-list {
  margin-top: 20rpx;
}

.item-row {
  display: grid;
  grid-template-columns: 104rpx 1fr auto;
  gap: 18rpx;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee8dd;
}

.item-row:last-child {
  border-bottom: 0;
}

.item-image {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 14rpx;
  background: #ece7dc;
}

.item-image image {
  width: 100%;
  height: 100%;
}

.item-image .item-fallback {
  width: 48rpx;
  height: 48rpx;
}

.item-copy {
  min-width: 0;
}

.item-name {
  overflow: hidden;
  color: #302d28;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-option,
.item-quantity {
  margin-top: 7rpx;
  color: #81786d;
  font-size: 21rpx;
}

.item-price {
  color: #6f5635;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 25rpx;
  font-weight: 600;
}

.info-row,
.amount-row,
.amount-total {
  display: grid;
  grid-template-columns: 130rpx 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
  font-size: 24rpx;
}

.info-row > text,
.amount-row > text {
  color: #8a8176;
}

.info-row > view,
.amount-row > view {
  color: #4d4942;
  line-height: 1.55;
  text-align: right;
}

.amount-row.saving > view {
  color: #9a6336;
}

.amount-total {
  align-items: end;
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e8e1d5;
}

.amount-total > text {
  color: #514c44;
  font-weight: 600;
}

.amount-total > view {
  color: #6f5635;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 40rpx;
  font-weight: 600;
  text-align: right;
}

.amount-total > view text {
  margin-right: 3rpx;
  font-size: 24rpx;
}

.created-time {
  margin-top: 18rpx;
  color: #9a9185;
  font-size: 21rpx;
  text-align: right;
}

.logistics-block {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e8e1d5;
}

.logistics-label {
  color: #8a8176;
  font-size: 23rpx;
}

.logistics-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 14rpx;
}

.logistics-company {
  color: #33312c;
  font-size: 26rpx;
  font-weight: 600;
}

.tracking-no {
  margin-top: 6rpx;
  color: #756c61;
  font-size: 22rpx;
}

.logistics-main button {
  min-width: 130rpx;
  height: 60rpx;
  color: #28583a;
  border: 1rpx solid rgba(40, 88, 58, 0.34);
  border-radius: 999rpx;
  font-size: 22rpx;
}

.after-sale-status {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid #ead6cf;
  border-radius: 18rpx;
  background: #f7ebe7;
}

.after-sale-title {
  color: #87463c;
  font-size: 27rpx;
  font-weight: 600;
}

.after-sale-copy {
  margin-top: 8rpx;
  color: #7a625d;
  font-size: 22rpx;
  line-height: 1.5;
}

.refund-amount {
  flex: 0 0 auto;
  color: #87463c;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 600;
}

.after-sale-form {
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid #e2d3ca;
  border-radius: 18rpx;
  background: #fff9f4;
}

.after-sale-form textarea {
  width: 100%;
  min-height: 190rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  color: #3f3a34;
  border: 1rpx solid #e5dbcf;
  border-radius: 14rpx;
  background: #fffdf9;
  font-size: 25rpx;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.form-actions button {
  min-width: 150rpx;
  height: 70rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.form-cancel {
  color: #6f685f;
  border: 1rpx solid #d9d1c5;
}

.form-submit {
  color: #fffaf0;
  background: #173b2a;
}

.secondary-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.secondary-actions button {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0;
  padding: 0 24rpx;
  color: #536057;
  border: 1rpx solid #ddd5ca;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.78);
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 500;
}

.secondary-actions button::after {
  border: none;
}

.secondary-actions image {
  width: 28rpx;
  height: 28rpx;
}

.detail-action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5ddd2;
  background: rgba(255, 253, 248, 0.98);
  box-shadow: 0 -12rpx 32rpx rgba(61, 47, 31, 0.08);
}

.detail-action-bar button {
  min-width: 178rpx;
  height: 78rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  line-height: 78rpx;
}

.detail-action-bar button::after {
  border: none;
}

.detail-action-bar .primary-action {
  min-width: 178rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.primary-action {
  color: #fffaf0;
  background: #173b2a;
}

.secondary-action {
  color: #2d5a3b;
  border: 1rpx solid rgba(45, 90, 59, 0.4);
  background: #fffdf8;
}

.danger-action {
  color: #a64b3c;
  border: 1rpx solid rgba(166, 75, 60, 0.4);
  background: #fffdf8;
}

.detail-loading,
.detail-state {
  padding: 160rpx 34rpx 80rpx;
  color: #756c61;
  text-align: center;
}

.loading-mark {
  width: 46rpx;
  height: 46rpx;
  margin: 0 auto 24rpx;
  border: 4rpx solid #d8d0c4;
  border-top-color: #315d3d;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.detail-state image {
  width: 82rpx;
  height: 82rpx;
  opacity: 0.65;
}

.state-title {
  margin-top: 24rpx;
  color: #2d342e;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 600;
}

.state-copy {
  margin-top: 12rpx;
  color: #7b7266;
  font-size: 24rpx;
}

.state-action {
  min-width: 200rpx;
  height: 74rpx;
  margin: 30rpx auto 0;
  color: #fffaf0;
  border-radius: 999rpx;
  background: #173b2a;
  font-size: 25rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
