<view class="page event-detail-page" wx:if="{{event}}">
  <view class="design-sheet">
    <image class="detail-design" src="{{event.detailImage}}" mode="widthFix" bindtap="previewDesign"></image>
  </view>

  <view class="detail-safe-bar">
    <view class="bar-action">
      <image class="bar-action-icon" src="/assets/icons/service-line.png" mode="aspectFit"></image>
      <text>咨询</text>
      <button
        class="contact-hotspot"
        open-type="contact"
        session-from="{{contactSessionFrom}}"
        show-message-card="{{false}}"
        send-message-title="{{contactMessageTitle}}"
        send-message-path="{{contactMessagePath}}"
        send-message-img="{{contactMessageImg}}"
        hover-class="none"
        bindcontact="handleContact"
      ></button>
    </view>
    <button class="bar-action share-button" open-type="share">
      <image class="bar-action-icon" src="/assets/icons/share-line.png" mode="aspectFit"></image>
      <text>分享</text>
    </button>
    <view class="wait-pill {{event.joinClass}}">
      <image class="wait-pill-icon" src="/assets/icons/calendar-wait.png" mode="aspectFit"></image>
      <text>{{event.joinText}}</text>
    </view>
  </view>
</view>

<view class="page event-detail-page empty-page" wx:else>
  <view class="empty-copy">
    <view class="empty-title">活动暂不可见</view>
    <text>请返回活动列表查看当前茶事活动。</text>
  </view>
</view>
