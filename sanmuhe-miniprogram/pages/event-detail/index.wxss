.event-detail-page {
  min-height: 100vh;
  /* Fixed bar height (108rpx) plus a card-like 12rpx finishing gap. */
  padding: 0 0 calc(120rpx + env(safe-area-inset-bottom));
  background: #f4eee4;
}

.share-button::after {
  border: 0;
}

.design-sheet {
  margin: 0;
  overflow: hidden;
  border-radius: 0;
  background: #e7dfd1;
}

.detail-design {
  width: 100%;
  display: block;
  /* keep last part of the poster readable under the bar area */
  vertical-align: top;
}

.detail-safe-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(56, 42, 28, 0.08);
  background: rgba(255, 252, 246, 0.97);
  box-shadow: 0 -10rpx 28rpx rgba(56, 42, 28, 0.08);
  backdrop-filter: blur(10px);
}

.bar-action {
  width: 88rpx;
  min-height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin: 0;
  padding: 0;
  color: #3a342c;
  background: transparent;
  font-size: 20rpx;
  line-height: 1.1;
  font-weight: 500;
}

.bar-action-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.share-button {
  line-height: 1.1;
}

.wait-pill {
  flex: 1;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 1rpx solid rgba(184, 147, 88, 0.38);
  border-radius: 999rpx;
  background: #faf6ee;
}

.wait-pill-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.wait-pill text {
  color: #8a6230;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
}

.empty-page {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
}

.empty-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #756b5c;
  font-size: 26rpx;
  text-align: center;
}

.empty-title {
  color: #233b31;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 40rpx;
  font-weight: 600;
}
