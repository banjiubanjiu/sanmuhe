.event-detail-page {
  min-height: 100vh;
  padding: 18rpx 18rpx 178rpx;
  background: #f4eee4;
}

.share-button::after,
.signup-action::after,
.submit-signup::after {
  border: 0;
}

.design-sheet {
  margin-top: 0;
  overflow: hidden;
  border-radius: 22rpx;
  background: #e7dfd1;
  box-shadow: 0 18rpx 44rpx rgba(50, 39, 24, 0.12);
}

.detail-design {
  width: 100%;
  display: block;
}

.detail-safe-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(35, 59, 49, 0.1);
  background: rgba(255, 252, 246, 0.98);
  box-shadow: 0 -14rpx 40rpx rgba(56, 42, 28, 0.1);
}

.bar-icon {
  width: 82rpx;
  min-height: 82rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0;
  color: #312b23;
  background: transparent;
  font-size: 22rpx;
  line-height: 1.1;
}

.bar-icon image {
  width: 38rpx;
  height: 38rpx;
  display: block;
}

.share-button {
  margin: 0;
}

.signup-action {
  flex: 1;
  min-height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0;
  color: #fffaf0;
  border-radius: 999rpx;
  background: #385835;
  font-size: 30rpx;
  font-weight: 600;
}

.signup-action image {
  width: 34rpx;
  height: 34rpx;
}

.signup-action.disabled {
  color: #8b877e;
  background: #ede9e1;
}

.signup-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 80;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 19, 0.36);
}

.signup-sheet {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  padding: 34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.sheet-title {
  color: #111;
  font-size: 34rpx;
  font-weight: 600;
}

.sheet-event {
  margin-top: 10rpx;
  color: #4f7d43;
  font-size: 25rpx;
  font-weight: 600;
}

.sheet-close {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #555;
  border-radius: 50%;
  background: #f4f4f0;
  font-size: 40rpx;
}

.signup-summary {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #fffaf1;
  color: #233b31;
  font-size: 27rpx;
  font-weight: 600;
}

.signup-summary text {
  display: block;
  margin-top: 8rpx;
  color: #746a5c;
  font-size: 23rpx;
  font-weight: 500;
}

.form-fields {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.submit-signup {
  width: 100%;
  min-height: 86rpx;
  margin-top: 26rpx;
  color: #fff;
  border-radius: 999rpx;
  background: #4f7d43;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-page {
  padding-bottom: 88rpx;
}

.empty-copy {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #756b5c;
  font-size: 26rpx;
  text-align: center;
}

.empty-title {
  color: #233b31;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 40rpx;
  font-weight: 600;
}
