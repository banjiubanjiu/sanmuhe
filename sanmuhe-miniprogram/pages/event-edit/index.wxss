.edit-form {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: rgba(255, 252, 246, 0.9);
  border: 1rpx solid rgba(35, 59, 49, 0.08);
}

.category-row {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
}

.category-pill {
  flex: 0 0 auto;
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  color: #5f685e;
  border: 1rpx solid rgba(35, 59, 49, 0.14);
  border-radius: 999rpx;
  background: #fff;
  font-size: 25rpx;
  font-weight: 500;
}

.category-pill.active {
  color: #fff;
  border-color: #4f7d43;
  background: #4f7d43;
}

.two-cols {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.submit-btn {
  margin-top: 34rpx;
}
