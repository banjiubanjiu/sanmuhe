.member-page {
  padding: 88rpx 28rpx calc(160rpx + env(safe-area-inset-bottom));
  background: #faf8f2;
}

.member-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 150rpx;
  align-items: center;
}

.back-btn {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn image {
  width: 42rpx;
  height: 42rpx;
  display: block;
}

.page-title {
  color: #111;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
}

.nav-capsule {
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  justify-self: end;
  padding: 0 14rpx;
  border: 1rpx solid #e9e5dd;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
}

.nav-capsule text {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #111;
}

.nav-capsule view {
  width: 36rpx;
  height: 36rpx;
  margin-left: 12rpx;
  border: 6rpx solid #111;
  border-radius: 50%;
}

.member-hero-card {
  position: relative;
  min-height: 356rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #203927;
  box-shadow: 0 14rpx 0 #d8b36d, 0 22rpx 46rpx rgba(51, 42, 30, 0.12);
}

.hero-bg,
.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-bg {
  opacity: 0.66;
}

.hero-shade {
  background:
    radial-gradient(circle at 42% 44%, rgba(255, 244, 214, 0.08) 0%, rgba(255, 244, 214, 0) 34%),
    linear-gradient(90deg, rgba(33, 56, 40, 0.98) 0%, rgba(33, 56, 40, 0.86) 45%, rgba(33, 56, 40, 0.14) 100%);
}

.hero-content {
  position: relative;
  z-index: 1;
  min-height: 356rpx;
  padding: 30rpx 36rpx 28rpx;
  color: #f5dfae;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.tier-name {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #f0d4a0;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 42rpx;
  font-weight: 600;
}

.tier-name text {
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 44rpx;
}

.rights-pill {
  min-width: 168rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 22rpx;
  color: #f0d4a0;
  border: 1rpx solid rgba(240, 212, 160, 0.72);
  border-radius: 999rpx;
  background: rgba(38, 55, 35, 0.52);
  font-size: 25rpx;
  font-weight: 500;
}

.rights-pill text {
  font-size: 28rpx;
  line-height: 1;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 38rpx;
}

.member-name {
  color: #fff6e0;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1;
}

.leaf-dot {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff6e0;
  border-radius: 50%;
  background: #557c43;
  font-size: 19rpx;
  font-weight: 500;
}

.card-line {
  width: 34rpx;
  height: 2rpx;
  margin-top: 22rpx;
  background: #f0d4a0;
}

.card-no {
  margin-top: 22rpx;
  color: rgba(255, 246, 224, 0.78);
  font-size: 28rpx;
  letter-spacing: 0;
}

.points-block {
  margin-top: 34rpx;
}

.points-block text {
  color: rgba(255, 246, 224, 0.9);
  font-size: 25rpx;
}

.points-block view {
  margin-top: 8rpx;
  color: #f0d4a0;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1;
}

.highlight-card,
.level-card,
.benefit-card,
.recommend-card {
  margin-top: 28rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 34rpx rgba(51, 42, 30, 0.06);
}

.highlight-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 24rpx 14rpx 26rpx;
}

.highlight-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.highlight-icon {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f2f0eb;
}

.highlight-icon image {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.highlight-title {
  width: 100%;
  margin-top: 16rpx;
  overflow: hidden;
  color: #111;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.highlight-desc {
  width: 100%;
  margin-top: 6rpx;
  overflow: hidden;
  color: #756f66;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level-card,
.benefit-card,
.recommend-card {
  padding: 28rpx 24rpx;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.panel-title {
  color: #111;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
}

.panel-link {
  flex: 0 0 auto;
  color: #77736b;
  font-size: 25rpx;
}

.level-row {
  display: grid;
  grid-template-columns: 64rpx 1fr auto;
  gap: 20rpx;
  align-items: center;
  margin-top: 30rpx;
}

.level-badge {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f0d4a0;
  border-radius: 50%;
  background: #315f2f;
  font-size: 34rpx;
}

.level-copy {
  min-width: 0;
}

.level-title {
  color: #315f2f;
  font-size: 29rpx;
  font-weight: 600;
}

.progress-track {
  height: 10rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e6e0d5;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #315f2f;
}

.upgrade-text {
  margin-top: 14rpx;
  overflow: hidden;
  color: #77736b;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upgrade-text text {
  color: #b67b2d;
  font-weight: 500;
}

.level-points {
  align-self: end;
  color: #77736b;
  font-size: 25rpx;
  padding-bottom: 30rpx;
}

.benefit-list {
  margin-top: 18rpx;
}

.benefit-row {
  display: grid;
  grid-template-columns: 54rpx 1fr 34rpx;
  gap: 20rpx;
  align-items: center;
  min-height: 104rpx;
}

.benefit-row + .benefit-row {
  border-top: 1rpx solid #eeeae2;
}

.benefit-icon {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.benefit-copy {
  min-width: 0;
}

.benefit-title {
  overflow: hidden;
  color: #111;
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.benefit-desc {
  margin-top: 6rpx;
  overflow: hidden;
  color: #77736b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow {
  color: #9a978f;
  font-size: 46rpx;
  line-height: 1;
  text-align: right;
}

.coupon-card,
.notice-card {
  margin-top: 28rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 34rpx rgba(51, 42, 30, 0.06);
}

.coupon-card {
  padding: 28rpx 24rpx;
}

.coupon-list {
  display: grid;
  gap: 16rpx;
  margin-top: 22rpx;
}

.coupon-row {
  display: grid;
  grid-template-columns: 118rpx 1fr 128rpx;
  gap: 18rpx;
  align-items: center;
  min-height: 114rpx;
  padding: 18rpx;
  border: 1rpx solid #eee5d6;
  border-radius: 14rpx;
  background: #fffaf1;
}

.coupon-amount {
  color: #a94a32;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 42rpx;
  font-weight: 600;
}

.coupon-copy {
  min-width: 0;
}

.coupon-title,
.coupon-desc {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-title {
  color: #1f362d;
  font-size: 28rpx;
  font-weight: 600;
}

.coupon-desc {
  margin-top: 8rpx;
  color: #796f61;
  font-size: 23rpx;
}

.coupon-action,
.notice-action {
  height: 62rpx;
  color: #fffaf1;
  border-radius: 999rpx;
  background: #315f2f;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 62rpx;
}

.coupon-action[disabled] {
  color: #857c70;
  background: #eee8dc;
}

.empty-line {
  margin-top: 22rpx;
  color: #77736b;
  font-size: 25rpx;
}

.notice-card {
  display: grid;
  grid-template-columns: 1fr 168rpx;
  gap: 20rpx;
  align-items: center;
  padding: 26rpx 24rpx;
}

.notice-title {
  color: #1f362d;
  font-size: 30rpx;
  font-weight: 600;
}

.notice-copy {
  margin-top: 8rpx;
  color: #77736b;
  font-size: 24rpx;
  line-height: 1.45;
}

.recommend-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 22rpx;
}

.recommend-item {
  min-width: 0;
  display: grid;
  grid-template-columns: 134rpx 1fr;
  gap: 14rpx;
  align-items: stretch;
  overflow: hidden;
  border-radius: 14rpx;
  background: #fbf8f1;
}

.recommend-image {
  width: 134rpx;
  height: 132rpx;
  display: block;
  background: #eee9df;
}

.recommend-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 14rpx 14rpx 12rpx 0;
}

.recommend-name {
  overflow: hidden;
  color: #111;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-note {
  margin-top: 8rpx;
  overflow: hidden;
  color: #77736b;
  font-size: 22rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: auto;
}

.recommend-price {
  color: #111;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 27rpx;
  font-weight: 600;
}

.add-btn {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffaf1;
  border-radius: 50%;
  background: #315f2f;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1;
}
