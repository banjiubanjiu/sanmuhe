.member-page {
  padding: 88rpx 28rpx calc(160rpx + env(safe-area-inset-bottom));
  background: #faf8f2;
}

.member-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 150rpx;
  align-items: center;
}

.back-btn {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn image {
  width: 42rpx;
  height: 42rpx;
  display: block;
}

.page-title {
  color: #111;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
}

.nav-capsule {
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  justify-self: end;
  padding: 0 14rpx;
  border: 1rpx solid #e9e5dd;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
}

.nav-capsule text {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #111;
}

.nav-capsule view {
  width: 36rpx;
  height: 36rpx;
  margin-left: 12rpx;
  border: 6rpx solid #111;
  border-radius: 50%;
}

.member-hero-card {
  position: relative;
  min-height: 360rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #1c3324;
  box-shadow: 0 18rpx 40rpx rgba(40, 32, 22, 0.14);
}

.hero-bg,
.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-bg {
  opacity: 0.95;
}

.hero-shade {
  background:
    radial-gradient(circle at 78% 48%, rgba(255, 236, 190, 0.1) 0%, rgba(255, 236, 190, 0) 30%),
    linear-gradient(105deg, rgba(18, 36, 24, 0.95) 0%, rgba(18, 36, 24, 0.82) 40%, rgba(18, 36, 24, 0.28) 70%, rgba(18, 36, 24, 0.06) 100%);
}

.hero-content {
  position: relative;
  z-index: 1;
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  padding: 30rpx 32rpx 28rpx;
  color: #f5dfae;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.tier-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #f0d4a0;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.15;
}

.tier-icon {
  width: 36rpx;
  height: 36rpx;
  display: block;
  flex: 0 0 36rpx;
}

.rights-pill {
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  color: rgba(240, 212, 160, 0.95);
  border: 1rpx solid rgba(240, 212, 160, 0.48);
  border-radius: 999rpx;
  background: rgba(28, 48, 34, 0.38);
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
}

.member-name {
  color: #fff6e0;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.1;
}

.leaf-mark {
  width: 30rpx;
  height: 30rpx;
  display: block;
  opacity: 0.9;
}

.card-line {
  width: 36rpx;
  height: 2rpx;
  margin-top: 18rpx;
  background: rgba(240, 212, 160, 0.85);
}

.card-no {
  margin-top: 16rpx;
  color: rgba(255, 246, 224, 0.68);
  font-size: 24rpx;
  letter-spacing: 0.06em;
}

/* 卡底资产条：余额/积分 + 充值（替代第二张钱包卡） */
.asset-bar {
  margin-top: auto;
  padding-top: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.asset-cols {
  display: flex;
  align-items: flex-end;
  gap: 36rpx;
  min-width: 0;
}

.asset-item {
  min-width: 0;
}

.asset-k {
  display: block;
  color: rgba(255, 246, 224, 0.62);
  font-size: 22rpx;
  line-height: 1.2;
}

.asset-v {
  margin-top: 6rpx;
  color: #fff6e0;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.05;
}

.asset-yen {
  margin-right: 4rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.hero-recharge-btn {
  flex-shrink: 0;
  min-width: 120rpx;
  height: 64rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1c2e22;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #f7e7bf 0%, #e0bb73 100%);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.18);
  font-size: 26rpx;
  font-weight: 600;
}

.guest-tip-block {
  margin-top: auto;
  padding-top: 28rpx;
  color: rgba(255, 246, 224, 0.68);
  font-size: 24rpx;
  line-height: 1.45;
}

.activation-card {
  margin-top: 30rpx;
  padding: 34rpx 30rpx;
  border: 1rpx solid rgba(49, 95, 47, 0.14);
  border-radius: 20rpx;
  background: #fffdf8;
  box-shadow: 0 16rpx 38rpx rgba(51, 42, 30, 0.07);
}

.activation-kicker {
  color: #b27a32;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.activation-title {
  margin-top: 12rpx;
  color: #203927;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 40rpx;
  font-weight: 600;
}

.activation-input {
  height: 88rpx;
  margin-top: 28rpx;
  padding: 0 24rpx;
  color: #253b2e;
  border: 1rpx solid #e8dfd0;
  border-radius: 14rpx;
  background: #f8f4eb;
  font-size: 28rpx;
  box-sizing: border-box;
}

.agreement-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
  margin-top: 22rpx;
  color: #6f685f;
  font-size: 23rpx;
}

.agreement-row checkbox {
  transform: scale(0.78);
  transform-origin: left center;
}

.agreement-link {
  color: #315f2f;
  font-weight: 600;
}

.activation-action {
  display: block;
  width: 100%;
  max-width: 100%;
  height: 82rpx;
  margin: 24rpx 0 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  color: #fffaf1;
  border-radius: 999rpx;
  background: #315f2f;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 82rpx;
  overflow: hidden;
}

.activation-action.is-disabled {
  opacity: 0.45;
}

.activation-action::after {
  border: none;
}

.activation-note {
  margin-top: 16rpx;
  color: #8a8175;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

/* —— 充值底部弹层 —— */
.recharge-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 900;
  background: rgba(20, 24, 20, 0.42);
}

.recharge-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 910;
  padding: 16rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fffdf8;
  box-shadow: 0 -12rpx 40rpx rgba(40, 32, 22, 0.16);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: #e0d8ca;
}

.sheet-title {
  margin-bottom: 24rpx;
  color: #173b2a;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.sheet-plan-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.sheet-plan {
  position: relative;
  min-width: 0;
  padding: 28rpx 16rpx 24rpx;
  border: 1rpx solid #e8e1d5;
  border-radius: 18rpx;
  background: #faf7f0;
  text-align: center;
}

.sheet-plan.active {
  border-color: #315f2f;
  background: linear-gradient(180deg, #f4f8f2 0%, #fffdf8 100%);
  box-shadow: 0 0 0 1rpx rgba(49, 95, 47, 0.12);
}

.sheet-plan-tag {
  position: absolute;
  top: -1rpx;
  right: -1rpx;
  padding: 4rpx 12rpx;
  color: #fff;
  border-radius: 0 18rpx 0 12rpx;
  background: #315f2f;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.4;
}

.sheet-plan-principal {
  color: #173b2a;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.1;
}

.sheet-plan-bonus {
  margin-top: 10rpx;
  color: #b27a32;
  font-size: 24rpx;
  font-weight: 500;
}

.sheet-pay-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  margin: 28rpx 0 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  color: #fffaf1;
  border-radius: 18rpx;
  background: #173b2a;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.sheet-pay-btn::after {
  border: none;
}

.sheet-pay-hover {
  opacity: 0.92;
}

.sheet-cancel {
  margin-top: 12rpx;
  padding: 16rpx;
  color: #6f685f;
  font-size: 26rpx;
  text-align: center;
}

.highlight-card,
.level-card,
.benefit-card,
.recommend-card {
  margin-top: 28rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 34rpx rgba(51, 42, 30, 0.06);
}

.highlight-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 24rpx 14rpx 26rpx;
}

.highlight-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.highlight-icon {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f2f0eb;
}

.highlight-icon image {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.highlight-title {
  width: 100%;
  margin-top: 16rpx;
  overflow: hidden;
  color: #111;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.highlight-desc {
  width: 100%;
  margin-top: 6rpx;
  overflow: hidden;
  color: #756f66;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level-card,
.benefit-card,
.recommend-card {
  padding: 28rpx 24rpx;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.panel-title {
  color: #111;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
}

.panel-link {
  flex: 0 0 auto;
  color: #77736b;
  font-size: 25rpx;
}

.level-row {
  display: grid;
  grid-template-columns: 64rpx 1fr auto;
  gap: 20rpx;
  align-items: center;
  margin-top: 30rpx;
}

.level-badge {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #315f2f;
  flex: 0 0 58rpx;
}

.level-badge image {
  width: 30rpx;
  height: 30rpx;
  display: block;
}

.level-copy {
  min-width: 0;
}

.level-title {
  color: #315f2f;
  font-size: 29rpx;
  font-weight: 600;
}

.progress-track {
  height: 10rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e6e0d5;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #315f2f;
}

.upgrade-text {
  margin-top: 14rpx;
  overflow: hidden;
  color: #77736b;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upgrade-text text {
  color: #b67b2d;
  font-weight: 500;
}

.level-points {
  align-self: end;
  color: #77736b;
  font-size: 25rpx;
  padding-bottom: 30rpx;
}

.benefit-list {
  margin-top: 18rpx;
}

.benefit-row {
  display: grid;
  grid-template-columns: 54rpx 1fr 34rpx;
  gap: 20rpx;
  align-items: center;
  min-height: 104rpx;
}

.benefit-row + .benefit-row {
  border-top: 1rpx solid #eeeae2;
}

.benefit-icon {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.benefit-copy {
  min-width: 0;
}

.benefit-title {
  overflow: hidden;
  color: #111;
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.benefit-desc {
  margin-top: 6rpx;
  overflow: hidden;
  color: #77736b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow {
  color: #9a978f;
  font-size: 46rpx;
  line-height: 1;
  text-align: right;
}

.coupon-card,
.notice-card {
  margin-top: 28rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 34rpx rgba(51, 42, 30, 0.06);
}

.coupon-card {
  padding: 28rpx 24rpx;
}

.coupon-list {
  display: grid;
  gap: 16rpx;
  margin-top: 22rpx;
}

.coupon-row {
  display: grid;
  grid-template-columns: 118rpx 1fr 128rpx;
  gap: 18rpx;
  align-items: center;
  min-height: 114rpx;
  padding: 18rpx;
  border: 1rpx solid #eee5d6;
  border-radius: 14rpx;
  background: #fffaf1;
}

.coupon-amount {
  color: #a94a32;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 42rpx;
  font-weight: 600;
}

.coupon-copy {
  min-width: 0;
}

.coupon-title,
.coupon-desc {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-title {
  color: #1f362d;
  font-size: 28rpx;
  font-weight: 600;
}

.coupon-desc {
  margin-top: 8rpx;
  color: #796f61;
  font-size: 23rpx;
}

.coupon-action,
.notice-action {
  height: 62rpx;
  color: #fffaf1;
  border-radius: 999rpx;
  background: #315f2f;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 62rpx;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-action {
  width: 100%;
  max-width: 100%;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.notice-action::after {
  display: none;
}

.coupon-action[disabled] {
  color: #857c70;
  background: #eee8dc;
}

.empty-line {
  margin-top: 22rpx;
  color: #77736b;
  font-size: 25rpx;
}

.notice-card {
  display: grid;
  grid-template-columns: 1fr 168rpx;
  gap: 20rpx;
  align-items: center;
  padding: 26rpx 24rpx;
}

.notice-title {
  color: #1f362d;
  font-size: 30rpx;
  font-weight: 600;
}

.notice-copy {
  margin-top: 8rpx;
  color: #77736b;
  font-size: 24rpx;
  line-height: 1.45;
}

.recommend-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 22rpx;
}

.recommend-item {
  min-width: 0;
  display: grid;
  grid-template-columns: 134rpx 1fr;
  gap: 14rpx;
  align-items: stretch;
  overflow: hidden;
  border-radius: 14rpx;
  background: #fbf8f1;
}

.recommend-image {
  width: 134rpx;
  height: 132rpx;
  display: block;
  background: #eee9df;
}

.recommend-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 14rpx 14rpx 12rpx 0;
}

.recommend-name {
  overflow: hidden;
  color: #111;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-note {
  margin-top: 8rpx;
  overflow: hidden;
  color: #77736b;
  font-size: 22rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: auto;
}

.recommend-price {
  color: #111;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 27rpx;
  font-weight: 600;
}

.add-btn {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffaf1;
  border-radius: 50%;
  background: #315f2f;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1;
}
