<view class="page profile-page">
  <view class="page-nav">
    <view class="nav-placeholder"></view>
    <view class="page-title">我的</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="profile-head" bindtap="goMember">
    <view class="avatar-wrap">
      <image class="avatar" src="{{user.avatar}}" mode="aspectFill"></image>
    </view>
    <view class="user-copy">
      <view class="user-name">{{user.name}}</view>
      <view class="user-title">{{user.title}}</view>
    </view>
    <view class="tier-pill">
      <text>{{member.isMember ? member.tier : '禾煦茶友'}}</text>
      <text class="tier-arrow">›</text>
    </view>
  </view>

  <view id="member-card" class="member-card">
    <image class="member-card-deco" src="/assets/icons/cup-white.png" mode="aspectFit"></image>
    <view class="member-card-inner">
      <view class="member-card-title">{{member.isMember ? '禾煦会员卡' : '禾煦会员'}}</view>
      <view class="member-card-name-row">
        <text class="member-card-name">{{member.isMember ? (member.name || user.name) : '茶友'}}</text>
        <view class="member-tier-chip">{{member.isMember ? (member.tier || '禾煦会员') : '待开通'}}</view>
      </view>

      <view class="member-card-stats">
        <view class="member-kv">
          <text class="member-kv-label">积分</text>
          <text class="member-kv-value">{{member.points || 0}}</text>
        </view>
        <view class="member-kv">
          <text class="member-kv-label">储值</text>
          <text class="member-kv-value">{{member.isMember ? ('¥' + member.balance) : '—'}}</text>
        </view>
        <view class="member-kv">
          <text class="member-kv-label">权益</text>
          <text class="member-kv-value">{{member.isMember ? '尊享' : '充值有礼'}}</text>
        </view>
      </view>

      <view class="recharge-strip" bindtap="onMemberCardAction">
        <view class="recharge-strip-copy">
          <view class="recharge-strip-title">{{member.isMember ? '储值享特权' : '开通享特权'}}</view>
          <view class="recharge-strip-desc">{{member.isMember ? '充值储值，享更多礼遇' : '开通会员，享积分与储值礼遇'}}</view>
        </view>
        <view class="recharge-cta">
          <text class="recharge-cta-icon">¥</text>
          <text>{{member.isMember ? '立即充值' : '立即开通'}}</text>
          <text class="recharge-cta-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="order-section">
    <view class="section-header">
      <view class="section-title">我的订单</view>
      <view class="section-link" bindtap="handleOrderShortcut" data-key="all">全部订单 ›</view>
    </view>
    <view class="order-shortcuts">
      <view
        wx:for="{{orderShortcuts}}"
        wx:key="key"
        class="order-shortcut-item"
        data-key="{{item.key}}"
        bindtap="handleOrderShortcut"
      >
        <view class="order-shortcut-icon">
          <image src="{{item.icon}}" mode="aspectFit"></image>
        </view>
        <text class="order-label">{{item.label}}</text>
        <text wx:if="{{item.count > 0}}" class="order-count">{{item.count}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{staffNotice && staffNotice.isStaff}}" class="staff-notice-card">
    <view class="staff-notice-copy">
      <view class="staff-notice-title">店员接单提醒</view>
      <view class="staff-notice-desc">
        {{staffNotice.remaining > 0
          ? ('剩余可提醒 ' + staffNotice.remaining + ' 次，新订单将推送到微信服务通知')
          : '授权后，顾客下单/付款时微信会提醒你'}}
      </view>
    </view>
    <button
      class="staff-notice-btn"
      loading="{{staffSubscribeSubmitting}}"
      disabled="{{staffSubscribeSubmitting}}"
      bindtap="subscribeStaffOrders"
    >{{staffNotice.remaining > 0 ? '续期授权' : '开启提醒'}}</button>
  </view>

  <view class="section">
    <view class="section-title">快捷服务</view>
    <view class="service-list">
      <view
        wx:for="{{services}}"
        wx:key="label"
        class="service-item"
        data-action="{{item.action}}"
        bindtap="handleService"
      >
        <image class="service-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <text class="service-label">{{item.label}}</text>
        <text class="service-arrow">›</text>
      </view>
    </view>
  </view>

  <privacy-gate
    show="{{privacyGateOpen}}"
    purpose="{{privacyPurpose}}"
    contractName="{{privacyContractName}}"
    bindagree="onPrivacyAgree"
    bindcancel="onPrivacyCancel"
  />
</view>
