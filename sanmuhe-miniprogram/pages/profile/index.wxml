<view class="page profile-page">
  <view class="page-nav">
    <view class="nav-placeholder"></view>
    <view class="page-title">我的</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="profile-head">
    <view class="avatar-wrap">
      <image class="avatar" src="{{user.avatar}}" mode="aspectFill"></image>
      <view class="avatar-badge">
        <image src="/assets/icons/profile-active.png" mode="aspectFit"></image>
      </view>
    </view>
    <view class="user-copy">
      <view class="user-name">{{user.name}}</view>
      <view class="user-title">{{user.title}}</view>
      <view class="tier-pill"><text class="tier-crown">♛</text>{{member.tier}}</view>
    </view>
    <view class="chevron" bindtap="goCloudStatus">›</view>
  </view>

  <view class="member-card" bindtap="showMemberBenefits">
    <image class="member-bg" src="https://7361-sanmuhe-env-d3g1nt3jsa1be67e3-1316449112.tcb.qcloud.la/assets/images/design-hero-tea.jpg" mode="aspectFill"></image>
    <view class="member-shade"></view>
    <view class="member-content">
      <view class="member-copy">
        <view class="member-title">雅客会员</view>
        <view class="member-subtitle">会员专享多重权益</view>
      </view>
      <view class="member-bottom">
        <view class="member-stat">
          <text>会员积分</text>
          <view class="member-stat-number">{{member.points}}</view>
        </view>
        <view class="member-divider"></view>
        <view class="member-stat">
          <text>优惠券</text>
          <view class="member-stat-number">{{member.coupons}}<text>张</text></view>
        </view>
        <view class="benefit-btn" catchtap="showMemberBenefits">查看权益</view>
      </view>
    </view>
  </view>

  <view class="order-panel">
    <view
      wx:for="{{orderShortcuts}}"
      wx:key="key"
      class="order-shortcut"
      data-key="{{item.key}}"
      bindtap="handleOrderShortcut"
    >
      <view class="order-icon-wrap">
        <image class="order-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <text wx:if="{{item.count > 0}}" class="count-dot">{{item.count}}</text>
      </view>
      <text>{{item.label}}</text>
    </view>
  </view>

  <view class="service-panel">
    <view class="panel-title">我的服务</view>
    <view class="service-grid">
      <view
        wx:for="{{services}}"
        wx:key="label"
        class="service-item"
        data-action="{{item.action}}"
        bindtap="handleService"
      >
        <view class="service-icon-wrap">
          <image class="service-icon" src="{{item.icon}}" mode="aspectFit"></image>
        </view>
        <text>{{item.label}}</text>
      </view>
    </view>
    <view wx:if="{{shippingAddress}}" class="address-line">{{shippingAddress}}</view>
  </view>

  <view class="recent-panel">
    <view class="panel-head">
      <view class="panel-title">最近预约</view>
      <view class="panel-link" bindtap="goReservation">全部预约 ›</view>
    </view>
    <view wx:if="{{recentReservation}}" class="recent-card" bindtap="goReservation">
      <image class="recent-image" src="{{recentReservation.image}}" mode="aspectFill"></image>
      <view class="recent-copy">
        <view class="recent-title">{{recentReservation.room}}</view>
        <view class="recent-line">
          <image src="/assets/icons/clock-line.png" mode="aspectFit"></image>
          <text>{{recentReservation.dateText}}</text>
        </view>
        <view class="recent-line">
          <image src="/assets/icons/users-line.png" mode="aspectFit"></image>
          <text>人数：{{recentReservation.people}}人</text>
        </view>
      </view>
      <view class="recent-status">
        <text>{{recentReservation.status}}</text>
        <view>查看详情</view>
      </view>
    </view>
    <view wx:if="{{!recentReservation}}" class="empty-card" bindtap="goReservation">
      <view class="empty-title">暂无茶室预约</view>
      <text>选择日期和时段后，门店会人工确认。</text>
    </view>
  </view>

  <view class="recent-panel">
    <view class="panel-head">
      <view class="panel-title">最近活动</view>
      <view class="panel-link" bindtap="goEvents">全部活动 ›</view>
    </view>
    <view wx:if="{{recentSignup}}" class="recent-card" bindtap="goEvents">
      <image class="recent-image" src="{{recentSignup.image}}" mode="aspectFill"></image>
      <view class="recent-copy">
        <view class="recent-title">{{recentSignup.title}}</view>
        <view class="recent-line">
          <image src="/assets/icons/clock-line.png" mode="aspectFit"></image>
          <text>{{recentSignup.dateText}}</text>
        </view>
        <view class="recent-line">
          <image src="/assets/icons/map-pin-line.png" mode="aspectFit"></image>
          <text>{{recentSignup.place}}</text>
        </view>
      </view>
      <view class="recent-status">
        <text>{{recentSignup.status}}</text>
        <view>查看详情</view>
      </view>
    </view>
    <view wx:if="{{!recentSignup}}" class="empty-card" bindtap="goEvents">
      <view class="empty-title">暂无活动报名</view>
      <text>茶会、讲座和体验活动可在线提交报名。</text>
    </view>
  </view>

</view>
