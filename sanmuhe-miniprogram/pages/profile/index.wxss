.profile-page {
  padding: 88rpx 28rpx calc(160rpx + env(safe-area-inset-bottom));
  background: #faf8f2;
}

.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.page-title {
  text-align: center;
  color: #111;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
}

.profile-head {
  min-height: 164rpx;
  display: grid;
  grid-template-columns: 144rpx 1fr 44rpx;
  gap: 30rpx;
  align-items: center;
  margin-top: 28rpx;
}

.avatar-wrap {
  position: relative;
  width: 144rpx;
  height: 144rpx;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  display: block;
  border-radius: 50%;
  background: #eee9df;
  box-shadow: 0 12rpx 26rpx rgba(52, 47, 38, 0.1);
}

.avatar-badge {
  position: absolute;
  right: -4rpx;
  bottom: 4rpx;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #faf8f2;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 8rpx 18rpx rgba(31, 54, 45, 0.18);
}

.avatar-badge image {
  width: 24rpx;
  height: 24rpx;
  display: block;
}

.user-copy {
  min-width: 0;
}

.user-name {
  color: #163a24;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 50rpx;
  font-weight: 600;
  line-height: 1.08;
}

.user-title {
  margin-top: 10rpx;
  overflow: hidden;
  color: #59564f;
  font-size: 29rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tier-pill {
  min-height: 42rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  color: #a46b32;
  border: 1rpx solid rgba(171, 121, 64, 0.28);
  border-radius: 12rpx;
  background: #f8ead5;
  font-size: 25rpx;
  font-weight: 500;
}

.tier-crown {
  color: #b9853d;
  font-size: 24rpx;
  line-height: 1;
}

.chevron {
  color: #8d8a84;
  font-size: 58rpx;
  line-height: 1;
  text-align: right;
}

.member-card {
  position: relative;
  min-height: 206rpx;
  margin-top: 34rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #203927;
  box-shadow: 0 18rpx 42rpx rgba(51, 42, 30, 0.11);
}

.member-bg,
.member-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.member-bg {
  opacity: 0.62;
}

.member-shade {
  background: linear-gradient(90deg, rgba(31, 54, 45, 0.98) 0%, rgba(31, 54, 45, 0.86) 40%, rgba(31, 54, 45, 0.22) 100%);
}

.member-content {
  position: relative;
  z-index: 1;
  min-height: 206rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 28rpx 34rpx 26rpx;
  color: #f7edd8;
}

.member-title {
  color: #fff9ea;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.15;
}

.member-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 246, 225, 0.88);
  font-size: 26rpx;
}

.member-bottom {
  display: flex;
  align-items: flex-end;
  gap: 32rpx;
}

.member-stat {
  min-width: 120rpx;
}

.member-stat text {
  color: rgba(255, 246, 225, 0.86);
  font-size: 24rpx;
}

.member-stat-number {
  margin-top: 8rpx;
  color: #f0d7a1;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
}

.member-stat-number text {
  margin-left: 6rpx;
  color: #f0d7a1;
  font-size: 22rpx;
  font-weight: 500;
}

.member-divider {
  width: 1rpx;
  height: 58rpx;
  background: rgba(240, 215, 161, 0.44);
}

.benefit-btn {
  min-width: 144rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  color: #213728;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #fff1cf 0%, #efd197 100%);
  font-size: 25rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(14, 28, 20, 0.18);
}

.order-panel,
.service-panel,
.recent-panel {
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 34rpx rgba(51, 42, 30, 0.06);
}

.order-panel {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 24rpx 18rpx 22rpx;
}

.order-shortcut,
.service-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #4d4a43;
  font-size: 26rpx;
}

.order-icon-wrap {
  position: relative;
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.order-icon {
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.count-dot {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  min-width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  color: #fff;
  border-radius: 999rpx;
  background: #b04737;
  font-size: 18rpx;
  font-weight: 500;
}

.service-panel,
.recent-panel {
  padding: 26rpx 22rpx;
}

.panel-title {
  color: #111;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 24rpx;
}

.service-item {
  min-height: 150rpx;
  padding: 20rpx 8rpx 18rpx;
  border-right: 1rpx solid #f0ede6;
}

.service-item:nth-child(4n) {
  border-right: 0;
}

.service-item:nth-child(n+5) {
  border-top: 1rpx solid #f0ede6;
}

.service-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.service-icon {
  width: 54rpx;
  height: 54rpx;
  display: block;
}

.service-item text {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-line {
  margin: 22rpx 8rpx 0;
  padding-top: 18rpx;
  overflow: hidden;
  color: #746a5c;
  border-top: 1rpx solid #eee9df;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.panel-link {
  flex: 0 0 auto;
  color: #77736b;
  font-size: 25rpx;
}

.recent-card {
  display: grid;
  grid-template-columns: 196rpx 1fr 124rpx;
  gap: 20rpx;
  align-items: center;
  margin-top: 22rpx;
}

.recent-image {
  width: 196rpx;
  height: 124rpx;
  display: block;
  border-radius: 12rpx;
  background: #eee9df;
}

.recent-copy {
  min-width: 0;
}

.recent-title {
  overflow: hidden;
  color: #111;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  color: #666;
  font-size: 24rpx;
}

.recent-line image {
  width: 24rpx;
  height: 24rpx;
  flex: 0 0 24rpx;
}

.recent-line text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-status {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 28rpx;
}

.recent-status text {
  color: #4f7d43;
  font-size: 24rpx;
  font-weight: 500;
}

.recent-status view {
  min-width: 112rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4f7d43;
  border: 1rpx solid rgba(79, 125, 67, 0.45);
  border-radius: 12rpx;
  font-size: 23rpx;
  font-weight: 500;
}

.empty-card {
  margin-top: 20rpx;
  padding: 34rpx 24rpx;
  color: #746a5c;
  border-radius: 14rpx;
  background: #fbf8f1;
  font-size: 25rpx;
  line-height: 1.45;
  text-align: center;
}

.empty-title {
  color: #233b31;
  font-size: 28rpx;
  font-weight: 500;
}

.empty-card text {
  display: block;
  margin-top: 10rpx;
  color: #746a5c;
  font-size: 24rpx;
}
