.profile-page {
  padding: 88rpx 28rpx calc(132rpx + env(safe-area-inset-bottom));
  color: #233b31;
  background: #f7f6f2;
}

/* ===== Nav ===== */
.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.nav-placeholder {
  width: 72rpx;
  height: 72rpx;
}

.page-title {
  text-align: center;
  color: #1f4a34;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1;
}

/* ===== User head ===== */
.profile-head {
  min-height: 132rpx;
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 120rpx 1fr auto;
  gap: 20rpx;
  align-items: center;
}

.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  display: block;
  border-radius: 50%;
  background: #ece7dc;
  box-shadow: 0 6rpx 18rpx rgba(52, 47, 38, 0.08);
}

.user-copy {
  min-width: 0;
}

.user-name {
  color: #163a24;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.1;
}

.user-title {
  margin-top: 8rpx;
  overflow: hidden;
  color: #7a7369;
  font-size: 24rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tier-pill {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  max-width: 200rpx;
  padding: 10rpx 18rpx;
  color: #8f6a35;
  border-radius: 999rpx;
  background: #f4ead7;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.2;
}

.tier-arrow {
  color: #b08a4d;
  font-size: 24rpx;
  line-height: 1;
}

/* ===== Member card ===== */
.member-card {
  position: relative;
  margin-top: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #1f4a34 0%, #234f38 48%, #1b3f2c 100%);
  box-shadow: 0 16rpx 40rpx rgba(28, 55, 38, 0.22);
  color: #f8f0df;
  overflow: hidden;
}

.member-card-deco {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 140rpx;
  height: 140rpx;
  opacity: 0.14;
  pointer-events: none;
}

.member-card-inner {
  position: relative;
  z-index: 1;
  padding: 30rpx 28rpx 24rpx;
}

.member-card-title {
  color: #f3e6c4;
  font-size: 34rpx;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.member-card-name-row {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.member-card-name {
  color: #fffaf1;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}

.member-tier-chip {
  padding: 4rpx 14rpx;
  color: #e8d5a0;
  border: 1rpx solid rgba(232, 213, 160, 0.35);
  border-radius: 999rpx;
  background: rgba(255, 246, 224, 0.08);
  font-size: 20rpx;
  line-height: 1.4;
}

.member-card-stats {
  margin-top: 30rpx;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8rpx;
}

.member-kv {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.member-kv-label {
  color: rgba(243, 230, 196, 0.72);
  font-size: 22rpx;
  line-height: 1;
}

.member-kv-value {
  color: #fffaf1;
  font-size: 34rpx;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-weight: 600;
  line-height: 1;
}

/* cream strip + green recharge CTA (reference design) */
.recharge-strip {
  margin-top: 28rpx;
  min-height: 108rpx;
  padding: 18rpx 18rpx 18rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #f7f1e4 0%, #efe6d4 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.recharge-strip-copy {
  min-width: 0;
  flex: 1;
}

.recharge-strip-title {
  color: #1f3d2c;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.25;
}

.recharge-strip-desc {
  margin-top: 6rpx;
  overflow: hidden;
  color: #7d756a;
  font-size: 22rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recharge-cta {
  flex: 0 0 auto;
  min-height: 64rpx;
  padding: 0 22rpx 0 18rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: #f7f1e4;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #2f5a3f 0%, #234a34 100%);
  box-shadow: 0 8rpx 18rpx rgba(24, 48, 34, 0.22);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1;
}

.recharge-cta-icon {
  width: 28rpx;
  height: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #234a34;
  background: #f0e2bd;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 16rpx;
  font-weight: 700;
}

.recharge-cta-arrow {
  margin-left: 2rpx;
  font-size: 28rpx;
  font-weight: 400;
  opacity: 0.9;
}

/* ===== Order section ===== */
.order-section {
  margin-top: 28rpx;
  border-radius: 22rpx;
  background: #fff;
  padding: 26rpx 22rpx 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(45, 40, 31, 0.04);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.section-title {
  color: #1d3628;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}

.section-link {
  color: #8a9380;
  font-size: 24rpx;
}

.order-shortcuts {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}

.order-shortcut-item {
  min-height: 112rpx;
  padding: 16rpx 4rpx 12rpx;
  border-radius: 14rpx;
  background: #fafaf7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  position: relative;
  box-sizing: border-box;
}

.order-shortcut-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.88;
}

.order-shortcut-icon image {
  width: 100%;
  height: 100%;
  display: block;
}

.order-label {
  color: #4f4a43;
  font-size: 22rpx;
  line-height: 1;
}

.order-count {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  min-width: 32rpx;
  padding: 2rpx 6rpx;
  border-radius: 999rpx;
  background: #c26a45;
  color: #fff;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.5;
}

/* ===== Service section ===== */
.section {
  margin-top: 30rpx;
}

.service-list {
  margin-top: 16rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(45, 40, 31, 0.04);
}

.service-item {
  min-height: 100rpx;
  padding: 0 24rpx;
  display: grid;
  grid-template-columns: 42rpx 1fr auto;
  gap: 16rpx;
  align-items: center;
  border-top: 1rpx solid #f0ebe3;
}

.service-item:first-child {
  border-top: none;
}

.service-icon {
  width: 38rpx;
  height: 38rpx;
  display: block;
}

.service-label {
  color: #1f362d;
  font-size: 28rpx;
}

.service-arrow {
  color: #b5aea3;
  font-size: 34rpx;
  line-height: 1;
}
