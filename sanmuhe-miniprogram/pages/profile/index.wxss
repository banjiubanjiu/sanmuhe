.profile-page {
  padding: 88rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.page-title {
  text-align: center;
  color: #111;
  font-size: 32rpx;
  font-weight: 800;
}

.profile-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.head-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.small-btn {
  width: 150rpx;
  min-height: 76rpx;
  font-size: 24rpx;
}

.member-card {
  display: flex;
  gap: 22rpx;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-radius: 16rpx;
  color: #f8f0df;
  background:
    linear-gradient(135deg, rgba(160, 85, 55, 0.28), transparent 58%),
    #233b31;
}

.member-kicker {
  color: #d9c28d;
  font-size: 22rpx;
  font-weight: 800;
}

.member-title {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.member-copy {
  margin-top: 10rpx;
  color: #e4d8bd;
  font-size: 24rpx;
  line-height: 1.45;
}

.member-action {
  flex: 0 0 150rpx;
  min-height: 74rpx;
  color: #233b31;
  background: #e7d1a0;
  box-shadow: none;
}

.compact {
  margin-top: 18rpx;
  padding: 34rpx 24rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.record {
  padding: 22rpx;
  border-radius: 16rpx;
  background: rgba(255, 252, 246, 0.9);
  border: 1rpx solid rgba(35, 59, 49, 0.08);
}

.record-title {
  color: #233b31;
  font-size: 29rpx;
  font-weight: 800;
}

.record-items {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 16rpx;
  color: #756b5c;
  font-size: 24rpx;
}
