.profile-page {
  padding: 88rpx 28rpx calc(132rpx + env(safe-area-inset-bottom));
  color: #233b31;
  background: #f7f4ec;
}

/* ===== Nav ===== */
.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.nav-placeholder {
  width: 72rpx;
  height: 72rpx;
}

.page-title {
  text-align: center;
  color: #173b2a;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1;
}

/* ===== User head ===== */
.profile-head {
  min-height: 140rpx;
  margin-top: 30rpx;
  display: grid;
  grid-template-columns: 128rpx 1fr auto;
  gap: 22rpx;
  align-items: center;
}

.avatar-wrap {
  width: 128rpx;
  height: 128rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  display: block;
  border-radius: 50%;
  background: #ece7dc;
  box-shadow: 0 8rpx 22rpx rgba(52, 47, 38, 0.10);
}

.user-copy {
  min-width: 0;
}

.user-name {
  color: #163a24;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.08;
}

.user-title {
  margin-top: 6rpx;
  overflow: hidden;
  color: #675f56;
  font-size: 25rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.head-extra {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 12rpx;
}

.tier-pill {
  display: inline-flex;
  align-items: center;
  color: #8f6a35;
  border: 1rpx solid rgba(171, 121, 64, 0.22);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  background: #f7f0e4;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 500;
}

/* ===== Member card ===== */
.member-card {
  margin-top: 26rpx;
  border-radius: 20rpx;
  background: linear-gradient(155deg, #1e3825 0%, #273d2b 40%, #2c432f 100%);
  box-shadow: 0 12rpx 36rpx rgba(28, 36, 22, 0.22);
  color: #f8f0df;
  overflow: hidden;
}

.member-card-inner {
  padding: 26rpx 28rpx 22rpx;
}

.member-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.member-card-title {
  font-size: 34rpx;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.member-card-badge {
  min-width: 100rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(246, 217, 161, 0.28);
  background: rgba(246, 217, 161, 0.12);
  color: #f4ddaa;
  text-align: center;
  font-size: 22rpx;
  line-height: 42rpx;
}

.member-card-divider {
  margin-top: 18rpx;
  height: 1rpx;
  background: rgba(246, 217, 161, 0.28);
}

.member-card-name-row {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
}

.member-card-name {
  font-size: 32rpx;
  font-weight: 600;
}

.member-card-level {
  color: #e7cf99;
  font-size: 23rpx;
}

/* 3-column stats */
.member-card-stats {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8rpx;
}

.member-kv {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.member-kv text:first-child {
  color: #cbb885;
  font-size: 23rpx;
  line-height: 1;
}

.member-kv text:last-child {
  color: #fffaf1;
  font-size: 30rpx;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-weight: 600;
  line-height: 1;
}

/* card bottom button */
.member-btn {
  margin-top: 24rpx;
  width: 100%;
  min-height: 70rpx;
  height: 70rpx;
  border-radius: 999rpx;
  color: #2a3f2c;
  background: #efe5ce;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-btn::after {
  border: none;
}

/* ===== Order section ===== */
.order-section {
  margin-top: 30rpx;
  border-radius: 18rpx;
  background: #e9ede3;
  padding: 24rpx 22rpx 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.section-title {
  color: #1d3628;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}

.section-link {
  color: #7f8e71;
  font-size: 24rpx;
}

.order-shortcuts {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.order-shortcut-item {
  min-height: 100rpx;
  padding: 18rpx 6rpx 14rpx;
  border-radius: 14rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  position: relative;
  box-sizing: border-box;
}

.order-shortcut-icon {
  width: 38rpx;
  height: 38rpx;
  opacity: 0.82;
}

.order-shortcut-icon image {
  width: 100%;
  height: 100%;
  display: block;
}

.order-label {
  color: #4f4a43;
  font-size: 23rpx;
  line-height: 1;
}

.order-count {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  min-width: 32rpx;
  padding: 2rpx 6rpx;
  border-radius: 999rpx;
  background: #c26a45;
  color: #fff;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.5;
}

/* ===== Service section ===== */
.section {
  margin-top: 28rpx;
}

.service-list {
  margin-top: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
}

.service-item {
  min-height: 96rpx;
  padding: 0 20rpx;
  display: grid;
  grid-template-columns: 42rpx 1fr auto;
  gap: 14rpx;
  align-items: center;
  border-top: 1rpx solid #ede6dc;
}

.service-item:first-child {
  border-top: none;
}

.service-icon {
  width: 38rpx;
  height: 38rpx;
  display: block;
}

.service-label {
  color: #1f362d;
  font-size: 28rpx;
}

.service-arrow {
  color: #a39b91;
  font-size: 34rpx;
  line-height: 1;
}
