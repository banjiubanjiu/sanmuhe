<view class="page shop-page">
  <view class="page-nav">
    <view class="back-mark" bindtap="goBack">‹</view>
    <view class="page-title">茶叶商城</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="shop-tools">
    <view class="shop-search">
      <image src="/assets/icons/search-line.png" mode="aspectFit"></image>
      <input placeholder="搜索茶名、产地、口感" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
      <text wx:if="{{keyword}}" bindtap="clearSearch">×</text>
    </view>
  </view>

  <view class="category-shell">
    <scroll-view scroll-y class="side-cats">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="side-cat {{activeCategory === item ? 'active' : ''}}"
        data-category="{{item}}"
        bindtap="changeCategory"
      >{{item}}</view>
    </scroll-view>

    <scroll-view scroll-y class="goods-list">
      <view class="list-heading">{{activeCategory}}</view>
      <view wx:for="{{filteredProducts}}" wx:key="id" class="goods-item">
        <view class="goods-main" data-id="{{item.id}}" bindtap="viewProduct">
          <image class="goods-thumb" src="{{item.thumb}}" mode="aspectFill"></image>
          <view class="goods-copy">
            <view class="goods-name">{{item.name}}</view>
            <view class="goods-note">{{item.taste}}</view>
            <view class="goods-tags">
              <text>{{item.origin}}</text>
              <text wx:if="{{item.availableStock !== ''}}">可售 {{item.availableStock}}</text>
            </view>
            <view class="goods-bottom">
              <view class="goods-price">¥{{item.price}} <text>/ {{item.unit}}</text></view>
            </view>
          </view>
        </view>
        <view class="round-add" data-id="{{item.id}}" catchtap="addProduct">+</view>
      </view>
      <view wx:if="{{filteredProducts.length === 0}}" class="empty-list">
        <view>暂无匹配茶品</view>
        <text>换个关键词或查看全部分类</text>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{cartCount > 0}}" class="shop-cart-pill" bindtap="goCart">
    <view class="shop-cart-icon">
      <image src="/assets/icons/cart-white.png" mode="aspectFit"></image>
      <text>{{cartCount}}</text>
    </view>
    <view class="shop-cart-copy">
      <view class="shop-cart-title">购物车 {{cartCount}} 件</view>
      <view class="shop-cart-meta">合计 ¥{{cartTotal}}</view>
    </view>
    <view class="shop-cart-action">确认茶品</view>
  </view>
</view>
