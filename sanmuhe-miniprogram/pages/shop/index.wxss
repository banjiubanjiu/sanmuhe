.shop-page {
  height: 100vh;
  padding: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--hx-text);
  background: var(--hx-page-background);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-nav {
  flex: 0 0 auto;
  background: var(--hx-page-background);
}

.nav-inner {
  height: 88rpx;
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  padding: 0 20rpx;
}

.page-title {
  text-align: center;
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.shop-tools {
  flex: 0 0 auto;
  padding: 12rpx 28rpx 20rpx;
  background: var(--hx-page-background);
}

.shop-search {
  height: 88rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--hx-field);
  background: var(--hx-field);
}

.shop-search image {
  width: 28rpx;
  height: 28rpx;
}

.shop-search input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  color: var(--hx-text);
  font-size: 26rpx;
}

.shop-search input::placeholder {
  color: var(--hx-muted);
}

.search-clear {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--hx-muted);
  font-size: 34rpx;
  line-height: 1;
  padding: 0;
  margin: 0;
  background: transparent;
}

.category-shell {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr);
  overflow: hidden;
  background: var(--hx-page-background);
  border-top: 1rpx solid var(--hx-line);
}

.side-cats {
  height: 100%;
  min-width: 0;
  background: var(--hx-page-background);
}

.side-cat {
  position: relative;
  width: 100%;
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 16rpx 0 28rpx;
  color: var(--hx-muted);
  background: transparent;
  font-size: 28rpx;
  line-height: 1.2;
  word-break: break-all;
}

.side-cat.active {
  color: var(--hx-ink);
  background: var(--hx-page-background);
  font-weight: 600;
}

.side-safe {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.side-safe.with-cart {
  height: calc(280rpx + env(safe-area-inset-bottom));
}

.goods-list {
  width: 100%;
  height: 100%;
  min-width: 0;
  overflow-x: hidden;
  box-sizing: border-box;
  padding: 24rpx 24rpx 0;
}

.result-summary {
  min-width: 0;
  margin-bottom: 16rpx;
  overflow: hidden;
  color: var(--hx-muted);
  font-size: 24rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-item {
  position: relative;
  width: 100%;
  min-width: 0;
  min-height: 200rpx;
  padding: 26rpx 120rpx 26rpx 0;
  border-bottom: 1rpx solid var(--hx-line);
}

.goods-main {
  width: 100%;
  min-width: 0;
  display: flex;
  gap: 22rpx;
  text-align: left;
  color: inherit;
}

.goods-thumb {
  flex: 0 0 126rpx;
  width: 126rpx;
  height: 126rpx;
  border-radius: 50%;
  background: var(--hx-paper);
}

.goods-copy {
  flex: 1;
  min-width: 0;
}

.goods-name {
  display: -webkit-box;
  overflow: hidden;
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.25;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.goods-note {
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--hx-muted);
  font-size: 25rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-tags {
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.goods-tags text {
  max-width: 100%;
  padding: 4rpx 10rpx;
  overflow: hidden;
  color: var(--hx-action);
  border-radius: 6rpx;
  background: var(--hx-sidebar);
  font-size: 24rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-bottom {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
}

.goods-price {
  min-width: 0;
  overflow: hidden;
  color: var(--hx-ink);
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-price text {
  color: var(--hx-muted);
  font-size: 24rpx;
  font-weight: 500;
}

.product-action {
  position: absolute;
  right: 0;
  bottom: 52rpx;
  width: 96rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--hx-action);
  border: 1rpx solid var(--hx-action);
  border-radius: 999rpx;
  background: var(--hx-surface);
  font-size: 24rpx;
  font-weight: 600;
  opacity: 0.92;
}

.product-action image {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.product-action.add-product {
  width: 88rpx;
  border-color: transparent;
  background: transparent;
}

.product-action.sold-out {
  color: var(--hx-muted);
  border-color: var(--hx-line);
  background: var(--hx-paper);
  opacity: 1;
}

.empty-list {
  padding: 80rpx 0;
  color: var(--hx-muted);
  text-align: center;
  font-size: 26rpx;
}

.empty-list text {
  display: block;
  margin-top: 10rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
}

.empty-action {
  min-height: 88rpx;
  margin: 28rpx auto 0;
  padding: 0 30rpx;
  color: #f8f0df;
  border-radius: 999rpx;
  background: var(--hx-action);
  font-size: 25rpx;
  font-weight: 600;
  border: none;
}

.list-safe-space {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.list-safe-space.with-cart {
  height: calc(300rpx + env(safe-area-inset-bottom));
}

.shop-cart-pill {
  position: fixed;
  right: 28rpx;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 30;
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 20rpx 26rpx;
  min-height: 104rpx;
  color: #f8f0df;
  background: var(--hx-ink);
  border-radius: 16rpx;
  box-shadow: 0 16rpx 38rpx rgba(31, 54, 45, 0.24);
}

.shop-cart-copy {
  flex: 1;
  min-width: 0;
}

.shop-cart-title {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-cart-meta {
  margin-top: 4rpx;
  overflow: hidden;
  color: #d9c28d;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-cart-action {
  flex: 0 0 auto;
  min-width: 132rpx;
  font-size: 25rpx;
  font-weight: 600;
  text-align: right;
}
.goods-tags text.stock-low {
  color: #765d28;
  background: #f2e8cd;
}

.goods-tags text.stock-sold-out {
  color: #7b4741;
  background: #f3e2df;
}
