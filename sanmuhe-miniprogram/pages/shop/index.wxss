.shop-page {
  /* 固定视口高度 + 内部 scroll-view；勿混用全局 .page 的 padding/min-height */
  height: 100vh;
  max-height: 100vh;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--hx-text);
  background: var(--hx-page-background);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.shop-page scroll-view::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.page-nav {
  flex: 0 0 auto;
  background: var(--hx-page-background);
}

.nav-inner {
  height: 88rpx;
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  padding: 0 20rpx;
}

.page-title {
  text-align: center;
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.shop-tools {
  flex: 0 0 auto;
  padding: 12rpx 28rpx 20rpx;
  background: var(--hx-page-background);
}

.shop-search {
  height: 88rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--hx-field);
  background: var(--hx-field);
}

.shop-search image {
  width: 28rpx;
  height: 28rpx;
}

.shop-search input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  color: var(--hx-text);
  font-size: 26rpx;
}

.shop-search input::placeholder {
  color: var(--hx-muted);
}

.search-clear {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--hx-muted);
  font-size: 34rpx;
  line-height: 1;
  padding: 0;
  margin: 0;
  background: transparent;
}

.category-shell {
  /* scroll-view 绝对定位吃满剩余高度，避免 grid+height:100% 在微信里无法滚动 */
  flex: 1 1 auto;
  min-height: 0;
  height: 0;
  position: relative;
  overflow: hidden;
  background: var(--hx-page-background);
  border-top: 1rpx solid var(--hx-line);
}

.side-cats {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  min-width: 0;
  box-sizing: border-box;
  background: var(--hx-page-background);
}

.side-cat {
  position: relative;
  width: 100%;
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 16rpx 0 28rpx;
  color: var(--hx-muted);
  background: transparent;
  font-size: 28rpx;
  line-height: 1.2;
  word-break: break-all;
}

.side-cat.active {
  color: var(--hx-ink);
  background: var(--hx-page-background);
  font-weight: 600;
}

.side-safe {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.side-safe.with-cart {
  height: calc(280rpx + env(safe-area-inset-bottom));
}

.goods-list {
  position: absolute;
  left: 160rpx;
  top: 0;
  bottom: 0;
  width: calc(100% - 160rpx);
  max-width: calc(100vw - 160rpx);
  min-width: 0;
  box-sizing: border-box;
  overflow-x: hidden;
  padding: 24rpx 24rpx 0;
}

.result-summary {
  min-width: 0;
  margin-bottom: 16rpx;
  overflow: hidden;
  color: var(--hx-muted);
  font-size: 24rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-item {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 200rpx;
  padding: 26rpx 0;
  box-sizing: border-box;
  overflow: hidden;
  border-bottom: 1rpx solid var(--hx-line);
}

.goods-main {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 22rpx;
  overflow: hidden;
  text-align: left;
  color: inherit;
}

.goods-thumb {
  flex: 0 0 126rpx;
  width: 126rpx;
  height: 126rpx;
  overflow: hidden;
  border-radius: 50%;
  background: var(--hx-paper);
}

.goods-copy {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.goods-name {
  display: -webkit-box;
  overflow: hidden;
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.25;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.goods-tags {
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.goods-tags text {
  max-width: 100%;
  height: 40rpx;
  padding: 0 10rpx;
  display: inline-flex;
  align-items: center;
  overflow: hidden;
  color: var(--hx-action);
  border-radius: 6rpx;
  background: var(--hx-sidebar);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-bottom {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-end;
  min-width: 0;
}

.goods-price {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  color: var(--hx-ink);
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-price text {
  color: var(--hx-muted);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.goods-add,
.goods-cta {
  flex: 0 0 auto;
  margin-left: 12rpx;
  margin-right: 8rpx;
}

.goods-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  line-height: 1;
}

.goods-cta.spec {
  width: 120rpx;
  height: 48rpx;
  color: #416d38;
  border: 1rpx solid #416d38;
  border-radius: 999rpx;
  background: #fffdf8;
  font-size: 22rpx;
}

.goods-cta.soldout {
  width: 88rpx;
  height: 48rpx;
  color: #665f55;
  border: 1rpx solid #e8e1d5;
  border-radius: 999rpx;
  background: #f7f4ec;
  font-size: 22rpx;
}

.empty-list {
  padding: 80rpx 0;
  color: var(--hx-muted);
  text-align: center;
  font-size: 26rpx;
}

.empty-list text {
  display: block;
  margin-top: 10rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
}

.empty-action {
  min-height: 88rpx;
  margin: 28rpx auto 0;
  padding: 0 30rpx;
  color: #f8f0df;
  border-radius: 999rpx;
  background: var(--hx-action);
  font-size: 25rpx;
  font-weight: 600;
  border: none;
}

.list-safe-space {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.list-safe-space.with-cart {
  height: calc(300rpx + env(safe-area-inset-bottom));
}

.shop-cart-pill {
  position: fixed;
  right: 28rpx;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 30;
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 20rpx 26rpx;
  min-height: 104rpx;
  color: #f8f0df;
  background: var(--hx-ink);
  border-radius: 16rpx;
  box-shadow: 0 16rpx 38rpx rgba(31, 54, 45, 0.24);
}

.shop-cart-copy {
  flex: 1;
  min-width: 0;
}

.shop-cart-title {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-cart-meta {
  margin-top: 4rpx;
  overflow: hidden;
  color: #d9c28d;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-cart-action {
  flex: 0 0 auto;
  min-width: 132rpx;
  font-size: 25rpx;
  font-weight: 600;
  text-align: right;
}
