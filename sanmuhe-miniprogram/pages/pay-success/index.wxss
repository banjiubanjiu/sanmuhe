.success-page {
  min-height: 100vh;
  background: var(--hx-paper);
  padding: 88rpx 0 calc(48rpx + env(safe-area-inset-bottom));
}

.success-nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 28rpx 8rpx;
  background: var(--hx-paper);
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back image {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
}

.nav-balance {
  width: 64rpx;
}

.success-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 32rpx 40rpx;
}

.success-mark {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--hx-ink);
}

.success-mark-icon {
  color: #f8f0df;
  font-size: 60rpx;
  font-weight: 600;
  line-height: 1;
}

.success-amount {
  margin-top: 34rpx;
  color: var(--hx-ink);
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 84rpx;
  font-weight: 600;
  line-height: 1;
}

.success-paid {
  margin-top: 16rpx;
  color: var(--hx-muted);
  font-size: 26rpx;
  letter-spacing: 8rpx;
}

.success-card {
  margin: 6rpx 40rpx 0;
  padding: 4rpx 30rpx;
  background: var(--hx-surface);
  border: 1rpx solid var(--hx-line);
}

.success-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  color: var(--hx-ink);
  font-size: 27rpx;
}

.success-row + .success-row {
  border-top: 1rpx solid var(--hx-line);
}

.row-label {
  color: var(--hx-muted);
  font-size: 25rpx;
}

.order-no {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: var(--hx-ink);
  font-size: 25rpx;
  word-break: break-all;
}

.copy-link {
  color: var(--hx-gold);
  font-size: 23rpx;
  flex: 0 0 auto;
}

.success-fulfill {
  margin: 28rpx 40rpx 0;
  padding: 30rpx;
  background: #f3ecdb;
  color: #5d4a22;
}

.fulfill-title {
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
}

.fulfill-copy {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.success-actions {
  display: flex;
  gap: 22rpx;
  margin: 44rpx 40rpx 0;
}

.success-actions button {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.secondary-action {
  color: var(--hx-ink);
  border: 1rpx solid var(--hx-ink);
  background: transparent;
}

.primary-action {
  color: #f8f0df;
  background: var(--hx-ink);
}
