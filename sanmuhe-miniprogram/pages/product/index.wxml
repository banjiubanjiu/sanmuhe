<view class="page product-page" wx:if="{{product}}">
  <view class="page-nav">
    <view class="back-mark" bindtap="goBack">‹</view>
    <view class="page-title">商品详情</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="detail-hero">
    <image src="{{product.image}}" mode="aspectFill"></image>
    <view class="photo-count">实拍图</view>
  </view>

  <view class="section detail-copy">
    <view class="title-row">
      <view class="detail-title">{{product.name}}</view>
      <view class="green-tag">{{product.category}}</view>
    </view>
    <view class="muted detail-meta">产地：{{product.origin}}<text wx:if="{{product.year}}"> ｜ 年份：{{product.year}}</text></view>
    <view class="muted paragraph">{{product.taste}}</view>
    <view wx:if="{{product.detail}}" class="detail-story">{{product.detail}}</view>
    <view class="detail-price">
      <text class="price">¥{{displayPrice}}</text>
      <text class="muted">/{{selectedSpecDisplay}}</text>
      <text class="sold">已售 {{product.sold}}</text>
      <text wx:if="{{product.availableStock !== undefined}}" class="sold">可售 {{product.availableStock}}</text>
    </view>

    <view class="assurance-row">
      <view>正品好茶</view>
      <view>门店自提</view>
      <view>快递到家</view>
    </view>

    <view wx:if="{{product.hasMultiSpecs}}" class="section">
      <view class="h2">选择规格</view>
      <view class="spec-row">
        <view
          wx:for="{{product.specs}}"
          wx:key="label"
          class="spec {{selectedSpec === item.label ? 'active' : ''}}"
          data-spec="{{item.label}}"
          bindtap="chooseSpec"
        >
          <text>{{item.display}}</text>
          <text class="spec-price">¥{{item.price}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!product.hasMultiSpecs}}" class="section single-spec">
      <view class="h2">规格</view>
      <view class="single-spec-pill">{{selectedSpecDisplay}}</view>
    </view>

    <view class="section qty-section">
      <view class="h2">数量</view>
      <view class="qty-stepper">
        <view class="qty-btn" data-step="-1" bindtap="changeQuantity">−</view>
        <text>{{quantity}}</text>
        <view class="qty-btn" data-step="1" bindtap="changeQuantity">+</view>
      </view>
    </view>
  </view>

  <view class="safe-bar">
    <view class="mini-action service-action">
      <image class="mini-action-icon" src="/assets/icons/headset-ink.png" mode="aspectFit"></image>
      <text>客服</text>
      <button
        class="contact-hotspot"
        open-type="contact"
        session-from="{{contactSessionFrom}}"
        show-message-card="{{true}}"
        send-message-title="{{contactMessageTitle}}"
        send-message-path="{{contactMessagePath}}"
        send-message-img="{{contactMessageImg}}"
        hover-class="none"
        bindcontact="handleContact"
      ></button>
    </view>
    <view class="mini-action fav-action {{favored ? 'active' : ''}}" bindtap="toggleFavorite">
      <image class="mini-action-icon" src="/assets/icons/heart-ink.png" mode="aspectFit"></image>
      <text>{{favored ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="cart-action" bindtap="addProduct">加入购物车</button>
    <button class="buy-action" bindtap="buyNow">立即购买</button>
  </view>
</view>

<view class="page product-page product-empty" wx:else>
  <view class="page-nav">
    <view class="back-mark" bindtap="goBack">‹</view>
    <view class="page-title">商品详情</view>
    <view class="nav-placeholder"></view>
  </view>
  <view class="empty-copy">
    <view class="empty-title">商品已下架</view>
    <view class="empty-text">请返回商城查看当前可售商品</view>
  </view>
</view>
