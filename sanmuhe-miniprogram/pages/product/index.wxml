<view class="page product-page" wx:if="{{product}}">
  <view class="page-nav">
    <view class="back-mark" bindtap="goBack">‹</view>
    <view class="page-title">商品详情</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="detail-hero">
    <swiper
      wx:if="{{product.images.length > 1}}"
      class="detail-swiper"
      indicator-dots
      indicator-color="rgba(255,255,255,0.4)"
      indicator-active-color="#3c6b4f"
      circular
      interval="4000"
      duration="300"
    >
      <swiper-item wx:for="{{product.images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" lazy-load="{{true}}"></image>
      </swiper-item>
    </swiper>
    <image wx:else src="{{product.image}}" mode="aspectFill"></image>
  </view>

  <view class="section detail-copy">
    <view class="title-row">
      <view class="detail-title">{{product.name}}</view>
      <view class="green-tag">{{product.category}}</view>
    </view>
    <view wx:if="{{product.origin || product.year}}" class="muted detail-meta">
      <text wx:if="{{product.origin}}">产地：{{product.origin}}</text>
      <text wx:if="{{product.origin && product.year}}"> ｜ </text>
      <text wx:if="{{product.year}}">年份：{{product.year}}</text>
    </view>

    <view wx:if="{{product.taste}}" class="taste-block">
      <view class="muted paragraph {{tasteExpanded || !product.tasteExpandable ? '' : 'is-clamped'}}">{{product.taste}}</view>
      <view
        wx:if="{{product.tasteExpandable}}"
        class="text-toggle"
        bindtap="toggleTaste"
      >{{tasteExpanded ? '收起' : '展开'}}</view>
    </view>

    <view class="detail-price">
      <text class="price">¥{{displayPrice}}</text>
      <text wx:if="{{priceUnit}}" class="muted price-unit">/{{priceUnit}}</text>
      <text class="sold">已售 {{product.sold}}</text>
    </view>

    <view class="assurance-line">正品好茶 · 门店自提 · 快递到家</view>

    <!-- 短标签：设计稿式 4 列 pill，仅名称 -->
    <view wx:if="{{product.hasMultiSpecs && product.specLayout === 'pill'}}" class="section spec-section">
      <view class="h2">选择规格</view>
      <view class="spec-row spec-row-pill">
        <view
          wx:for="{{product.specs}}"
          wx:key="label"
          class="spec-pill {{selectedSpec === item.label ? 'active' : ''}}"
          data-spec="{{item.label}}"
          bindtap="chooseSpec"
        >{{item.pillText}}</view>
      </view>
    </view>

    <!-- 长标签：横向滑动，仅规格名；价格与克数只在上方主价行 -->
    <view wx:if="{{product.hasMultiSpecs && product.specLayout === 'chip'}}" class="section spec-section">
      <view class="h2">选择规格</view>
      <scroll-view class="spec-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="spec-chip-row">
          <view
            wx:for="{{product.specs}}"
            wx:key="label"
            class="spec-chip {{selectedSpec === item.label ? 'active' : ''}}"
            data-spec="{{item.label}}"
            bindtap="chooseSpec"
          >{{item.chipTitle}}</view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{!product.hasMultiSpecs && !giftBox}}" class="section single-spec">
      <view class="h2">规格</view>
      <view class="single-spec-pill">{{product.specs[0].chipTitle || selectedSpecDisplay}}</view>
    </view>

    <!-- 自选礼盒：茶池选择器 -->
    <view wx:if="{{giftBox}}" class="section giftbox-section">
      <view class="giftbox-head">
        <view class="h2">自选搭配</view>
        <view class="giftbox-rule">
          {{giftBox.mode === 'double' ? '选 ' + giftBox.minTypes + ' 款，每款 ' + giftBox.brewsPerType + ' 泡' : '选 1 款 × ' + giftBox.brewsPerType + ' 泡'}}
          <text wx:if="{{giftBox.boxFeeFen > 0}}" class="giftbox-fee">＋包装费 ¥{{giftBox.boxFeeFen / 100}}</text>
        </view>
        <view class="giftbox-picked {{giftBox.filled ? 'done' : ''}}">已选 {{giftBox.totalPicked}}/{{giftBox.minTypes}}</view>
      </view>
      <view wx:if="{{giftBox.note}}" class="giftbox-note">※ {{giftBox.note}}</view>
      <view class="giftbox-pool">
        <view
          wx:for="{{giftBox.pool}}"
          wx:key="teaId"
          class="giftbox-tea {{item.picked > 0 ? 'active' : ''}}"
        >
          <view class="giftbox-tea-copy">
            <view class="giftbox-tea-name">{{item.name}}</view>
            <view class="giftbox-tea-price">
              {{giftBox.wholeBox ? '整盒 ¥' + (item.priceFen / 100) : '¥' + (item.priceFen / 100) + ' / 泡'}}
            </view>
          </view>
          <view class="giftbox-stepper">
            <view
              class="giftbox-step-btn"
              data-tea-id="{{item.teaId}}"
              data-delta="-1"
              bindtap="toggleGiftTea"
            >−</view>
            <text>{{item.picked}}</text>
            <view
              class="giftbox-step-btn plus"
              data-tea-id="{{item.teaId}}"
              data-delta="1"
              bindtap="toggleGiftTea"
            >+</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section qty-section">
      <view class="h2">数量</view>
      <view class="qty-stepper">
        <view class="qty-btn" data-step="-1" bindtap="changeQuantity">−</view>
        <text>{{quantity}}</text>
        <view class="qty-btn" data-step="1" bindtap="changeQuantity">+</view>
      </view>
    </view>


  </view>

  <view class="safe-bar">
    <view class="mini-action service-action">
      <image class="mini-action-icon" src="/assets/icons/headset-ink.png" mode="aspectFit"></image>
      <text>客服</text>
      <button
        class="contact-hotspot"
        open-type="contact"
        session-from="{{contactSessionFrom}}"
        show-message-card="{{false}}"
        send-message-title="{{contactMessageTitle}}"
        send-message-path="{{contactMessagePath}}"
        send-message-img="{{contactMessageImg}}"
        hover-class="none"
        bindcontact="handleContact"
      ></button>
    </view>
    <view class="mini-action fav-action {{favored ? 'active' : ''}}" bindtap="toggleFavorite">
      <image class="mini-action-icon" src="/assets/icons/{{favored ? 'heart-active' : 'heart-ink'}}.png" mode="aspectFit"></image>
      <text>{{favored ? '已收藏' : '收藏'}}</text>
    </view>
    <text wx:if="{{selectedStockHint}}" class="stock-hint {{selectedSoldOut ? 'sold' : ''}}">{{selectedStockHint}}</text>
    <button class="cart-action" bindtap="addProduct" disabled="{{selectedSoldOut}}">{{selectedSoldOut ? '已售罄' : '加入购物车'}}</button>
    <button class="buy-action" bindtap="buyNow" disabled="{{selectedSoldOut}}">{{selectedSoldOut ? '已售罄' : '立即购买'}}</button>
  </view>
</view>

<view class="page product-page product-empty" wx:else>
  <view class="page-nav">
    <view class="back-mark" bindtap="goBack">‹</view>
    <view class="page-title">商品详情</view>
    <view class="nav-placeholder"></view>
  </view>
  <view class="empty-copy" wx:if="{{catalogLoading}}">
    <view class="empty-title">正在加载</view>
    <view class="empty-text">请稍候</view>
  </view>
  <view class="empty-copy" wx:elif="{{catalogError}}">
    <view class="empty-title">商品暂时无法加载</view>
    <view class="empty-text">请检查网络后重试</view>
    <button class="empty-action" bindtap="loadProduct">重新加载</button>
  </view>
  <view class="empty-copy" wx:else>
    <view class="empty-title">商品不存在或已下架</view>
    <view class="empty-text">请返回商城查看当前可售商品</view>
  </view>
</view>
