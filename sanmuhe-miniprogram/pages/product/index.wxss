.product-page {
  padding: 88rpx 24rpx 188rpx;
  background: #fff;
}

.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 132rpx;
  align-items: center;
}

.back-mark {
  color: #111;
  font-size: 46rpx;
  line-height: 1;
}

.page-title {
  text-align: center;
  color: #111;
  font-size: 32rpx;
  font-weight: 800;
}

.mini-capsule {
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
  font-weight: 800;
}

.detail-hero {
  position: relative;
  height: 590rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #ece8df;
}

.detail-hero image {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-count {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 6rpx 14rpx;
  color: #fff;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  font-size: 22rpx;
}

.detail-copy {
  padding: 0 18rpx;
}

.title-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.detail-title {
  color: #111;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.green-tag {
  padding: 6rpx 14rpx;
  color: #4f7d43;
  border-radius: 8rpx;
  background: #edf4ea;
  font-size: 22rpx;
  font-weight: 800;
}

.detail-meta {
  margin-top: 18rpx;
  font-size: 24rpx;
}

.paragraph {
  margin-top: 16rpx;
}

.detail-price {
  display: flex;
  align-items: baseline;
  margin-top: 46rpx;
}

.detail-price .price {
  color: #111;
  font-size: 54rpx;
  font-weight: 900;
}

.sold {
  margin-left: auto;
  color: #777;
  font-size: 24rpx;
}

.spec-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30rpx;
  margin-top: 26rpx;
}

.spec {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333;
  border: 1rpx solid #e5e5e5;
  border-radius: 10rpx;
  background: #fff;
  font-size: 30rpx;
}

.spec.active {
  color: #4f7d43;
  border-color: #4f7d43;
  background: #f5faf3;
  font-weight: 800;
}

.qty-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qty-stepper {
  display: grid;
  grid-template-columns: 58rpx 112rpx 58rpx;
  height: 58rpx;
  overflow: hidden;
  border: 1rpx solid #e5e5e5;
  border-radius: 10rpx;
}

.qty-stepper .qty-btn,
.qty-stepper text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111;
  font-size: 30rpx;
  border-right: 1rpx solid #e5e5e5;
}

.qty-stepper .qty-btn:last-child {
  border-right: 0;
}

.safe-bar {
  gap: 18rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eeeeee;
  box-shadow: none;
}

.mini-action {
  width: 72rpx;
  min-height: 82rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #333;
  font-size: 22rpx;
}

.mini-action.active {
  color: #4f7d43;
  font-weight: 800;
}

.mini-action-icon {
  width: 38rpx;
  height: 38rpx;
  display: block;
}

.cart-action,
.buy-action {
  flex: 1;
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.cart-action {
  color: #4f7d43;
  border: 2rpx solid #4f7d43;
  background: #fff;
}

.buy-action {
  color: #fff;
  background: #4f7d43;
}
