.product-page {
  padding: 88rpx 24rpx 188rpx;
  background: #fff;
}

.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.back-mark {
  color: #111;
  font-size: 46rpx;
  line-height: 1;
}

.page-title {
  text-align: center;
  color: #111;
  font-size: 32rpx;
  font-weight: 600;
}

.detail-hero {
  position: relative;
  height: 590rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #ece8df;
}

.detail-hero image {
  width: 100%;
  height: 100%;
  display: block;
}

.detail-copy {
  min-width: 0;
  max-width: 100%;
  padding: 0 18rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.detail-copy .section {
  min-width: 0;
  max-width: 100%;
}

.title-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.detail-title {
  color: #111;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.25;
}

.green-tag {
  padding: 6rpx 14rpx;
  color: #4f7d43;
  border-radius: 8rpx;
  background: #edf4ea;
  font-size: 22rpx;
  font-weight: 500;
}

.detail-meta {
  margin-top: 18rpx;
  font-size: 24rpx;
}

.paragraph {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.taste-block {
  margin-top: 16rpx;
}

.taste-block .paragraph {
  margin-top: 0;
}

.paragraph.is-clamped {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.text-toggle {
  margin-top: 10rpx;
  color: #4f7d43;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
}

.detail-price {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx 12rpx;
  margin-top: 36rpx;
}

.detail-price .price {
  color: #111;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 54rpx;
  font-weight: 600;
}

.price-unit {
  font-size: 26rpx;
}

.sold {
  margin-left: auto;
  color: #777;
  font-size: 24rpx;
}

.assurance-line {
  margin-top: 18rpx;
  color: #6f7f68;
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 0.02em;
}

/* 规格区整体锁宽，避免横向 scroll 把页面撑出屏幕 */
.spec-section {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}

/* 短规格：贴近设计稿的 4 列 pill */
.spec-row-pill {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
  min-width: 0;
}

.spec-pill {
  min-width: 0;
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 6rpx;
  color: #333;
  border: 1rpx solid #e5e5e5;
  border-radius: 10rpx;
  background: #fff;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: center;
  overflow: hidden;
  word-break: break-all;
}

.spec-pill.active {
  color: #4f7d43;
  border-color: #4f7d43;
  background: #f5faf3;
  font-weight: 600;
}

/* 长规格：横向滑动 chip（只在 scroll-view 内滚动，不撑破页面） */
.spec-scroll {
  width: 100%;
  max-width: 100%;
  margin-top: 22rpx;
  box-sizing: border-box;
}

.spec-chip-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 12rpx;
  width: max-content;
  max-width: none;
  padding: 2rpx 4rpx 10rpx 0;
  box-sizing: border-box;
}

.spec-chip {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  max-width: 260rpx;
  padding: 12rpx 20rpx;
  color: #333;
  border: 1rpx solid #e5e5e5;
  border-radius: 999rpx;
  background: #fff;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spec-chip.active {
  color: #4f7d43;
  border-color: #4f7d43;
  background: #f5faf3;
  font-weight: 600;
}

.single-spec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-width: 0;
}

.single-spec .h2 {
  flex-shrink: 0;
}

.single-spec-pill {
  min-width: 0;
  max-width: 62%;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  color: #4f7d43;
  border: 1rpx solid #4f7d43;
  border-radius: 10rpx;
  background: #f5faf3;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 600;
}

.qty-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qty-stepper {
  display: grid;
  grid-template-columns: 58rpx 112rpx 58rpx;
  height: 58rpx;
  overflow: hidden;
  border: 1rpx solid #e5e5e5;
  border-radius: 10rpx;
}

.qty-stepper .qty-btn,
.qty-stepper text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111;
  font-size: 30rpx;
  border-right: 1rpx solid #e5e5e5;
}

.qty-stepper .qty-btn:last-child {
  border-right: 0;
}

.safe-bar {
  gap: 18rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eeeeee;
  box-shadow: none;
}

.mini-action {
  position: relative;
  width: 72rpx;
  min-height: 82rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #333;
  font-size: 22rpx;
}

/* 透明热区：不改变原先客服/收藏排版，只承接 open-type="contact" */
.contact-hotspot {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  width: 100% !important;
  height: 100%;
  min-width: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
  opacity: 0;
  background: transparent;
}

.contact-hotspot::after {
  display: none;
  border: none;
}

.mini-action.active {
  color: #4f7d43;
  font-weight: 500;
}

.mini-action-icon {
  width: 38rpx;
  height: 38rpx;
  display: block;
}

.cart-action,
.buy-action {
  flex: 1;
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.cart-action {
  color: #4f7d43;
  border: 2rpx solid #4f7d43;
  background: #fff;
}

.buy-action {
  color: #fff;
  background: #4f7d43;
}

.product-empty {
  min-height: 100vh;
}

.empty-copy {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #77736b;
}

.empty-title {
  color: #163a24;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 42rpx;
  font-weight: 600;
}

.empty-text {
  font-size: 26rpx;
}
