<view class="page order-page">
  <view class="page-nav">
    <view class="back-mark" bindtap="goBack">‹</view>
    <view class="page-title">茶饮点单</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="order-shell">
    <scroll-view scroll-y class="side-cats">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="side-cat {{activeCategory === item ? 'active' : ''}}"
        data-category="{{item}}"
        bindtap="changeCategory"
      >{{item}}</view>
    </scroll-view>

    <scroll-view scroll-y class="drink-list">
      <view class="list-heading">{{activeCategory}}</view>
      <view wx:for="{{filteredDrinks}}" wx:key="id" class="drink-item {{activeDrink.id === item.id ? 'active' : ''}}">
        <view class="drink-main" data-id="{{item.id}}" bindtap="chooseDrink">
          <image class="drink-thumb" src="{{item.image}}" mode="aspectFill"></image>
          <view class="drink-copy">
            <view class="drink-name">{{item.name}}</view>
            <view class="drink-note">{{item.notes}}</view>
            <view class="drink-price">¥{{item.price}}</view>
          </view>
        </view>
        <view class="round-add" data-id="{{item.id}}" bindtap="quickAddDrink">
          <image class="plus-icon" src="/assets/icons/plus-white.png" mode="aspectFit"></image>
        </view>
      </view>
      <view wx:if="{{filteredDrinks.length === 0}}" class="empty-list">暂无商品</view>
    </scroll-view>
  </view>

  <view wx:if="{{cartCount > 0}}" class="order-cart-pill" bindtap="goCart">
    <view class="cart-icon-large">
      <image src="/assets/icons/cart-white.png" mode="aspectFit"></image>
      <text>{{cartCount}}</text>
    </view>
    <view class="bar-title">购物车</view>
    <view class="bar-total">¥{{cartTotal}}</view>
    <view class="checkout-chip">去结算</view>
  </view>

  <view class="order-tabbar">
    <view class="order-tab active" data-url="/pages/index/index" bindtap="switchOrderTab">
      <image class="order-tab-icon" src="/assets/icons/home-active.png" mode="aspectFit"></image>
      <text>首页</text>
    </view>
    <view class="order-tab" data-url="/pages/shop/index" bindtap="switchOrderTab">
      <image class="order-tab-icon" src="/assets/icons/category-line.png" mode="aspectFit"></image>
      <text>分类</text>
    </view>
    <view class="order-tab" data-url="/pages/cart/index" bindtap="switchOrderTab">
      <image class="order-tab-icon" src="/assets/icons/cart-line.png" mode="aspectFit"></image>
      <text>购物车</text>
    </view>
    <view class="order-tab" data-url="/pages/profile/index" bindtap="switchOrderTab">
      <image class="order-tab-icon" src="/assets/icons/profile-line.png" mode="aspectFit"></image>
      <text>我的</text>
    </view>
  </view>
</view>
