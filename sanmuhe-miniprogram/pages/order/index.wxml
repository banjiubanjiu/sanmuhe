<view class="page tea-menu-page">
  <view class="page-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-inner">
      <view class="nav-side">
        <view class="table-chip" bindtap="scanTable">
          <image src="/assets/icons/scan-ink.png" mode="aspectFit"></image>
          <text>{{tableLabel ? tableLabel : '扫桌'}}</text>
        </view>
      </view>
      <view class="page-title">堂饮点单</view>
      <view class="nav-side nav-side-right"></view>
    </view>
  </view>

  <view class="order-tools">
    <view class="order-search">
      <image src="/assets/icons/search-line.png" mode="aspectFit"></image>
      <input
        placeholder="搜索茶名、茶类、口感"
        value="{{keyword}}"
        bindinput="onSearch"
        confirm-type="search"
      />
      <text wx:if="{{keyword}}" bindtap="clearSearch">×</text>
    </view>
  </view>

  <view class="ordering-shell">
    <scroll-view scroll-y class="side-cats">
      <view
        wx:for="{{sideMenuItems}}"
        wx:key="id"
        class="side-cat {{activeDrinkId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectPackage"
      >{{item.name}}</view>
      <view class="side-safe"></view>
    </scroll-view>

    <scroll-view
      scroll-y
      class="goods-list"
      scroll-into-view="{{scrollIntoView}}"
      scroll-with-animation
    >
      <block wx:if="{{activeDrink}}">
        <view class="hero-card" id="hero" wx:if="{{!keyword}}">
          <image class="hero-image" src="{{activeDrink.image}}" mode="aspectFill"></image>
          <view class="hero-mask"></view>
          <view class="hero-copy">
            <view class="hero-name">{{activeDrink.name}}</view>
            <view class="hero-price">{{activeDrink.price}}元/{{activeDrink.unit}}</view>
            <view class="hero-line"></view>
            <view class="hero-hint">{{activeDrink.selectionHint}}</view>
            <view class="hero-tagline">{{activeDrink.tagline}}</view>
          </view>
        </view>

        <view class="list-heading">
          {{keyword ? ('搜索结果（' + filteredTeaOptions.length + '）') : ('可选茶款（' + filteredTeaOptions.length + '款）')}}
        </view>

        <view
          wx:for="{{filteredTeaOptions}}"
          wx:key="name"
          wx:for-item="tea"
          class="goods-item"
        >
          <view class="goods-main">
            <image class="goods-thumb" src="{{tea.image}}" mode="aspectFill"></image>
            <view class="goods-copy">
              <view class="goods-name">{{tea.name}}</view>
              <view class="goods-note">{{tea.subtitle}}</view>
              <view class="goods-tags">
                <text>{{tea.category}}</text>
                <text wx:for="{{tea.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
              </view>
              <view class="goods-bottom">
                <view class="goods-price">¥{{activeDrink.price}} <text>/ {{activeDrink.unit}}</text></view>
              </view>
            </view>
          </view>
          <view class="round-add" data-tea="{{tea.name}}" catchtap="addTea">+</view>
        </view>

        <view wx:if="{{!filteredTeaOptions.length}}" class="empty-list">
          <view>{{keyword ? '未找到相关茶款' : '本席暂无可选茶款'}}</view>
          <text>{{keyword ? '换个关键词或清空搜索' : '请切换左侧档位查看其他茶席'}}</text>
        </view>
      </block>

      <view wx:else class="empty-list">
        <view>{{keyword ? '未找到相关茶席' : '茶单加载中'}}</view>
        <text>{{keyword ? '换个关键词试试' : '请稍候'}}</text>
      </view>

      <view class="list-safe-space"></view>
    </scroll-view>
  </view>
</view>
