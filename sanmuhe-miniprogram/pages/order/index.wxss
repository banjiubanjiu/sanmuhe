.order-page {
  padding: 88rpx 0 calc(116rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.back-mark {
  color: #111;
  font-size: 46rpx;
  line-height: 1;
}

.page-title {
  text-align: center;
  color: #111;
  font-size: 32rpx;
  font-weight: 800;
}

.order-shell {
  position: fixed;
  top: 250rpx;
  right: 0;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  left: 0;
  display: grid;
  grid-template-columns: 186rpx 1fr;
  background: #fff;
  border-top: 1rpx solid #eeeeee;
}

.side-cats {
  height: 100%;
  background: #f8f8f7;
}

.side-cat {
  position: relative;
  width: 100%;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 34rpx;
  color: #333;
  background: transparent;
  font-size: 27rpx;
}

.side-cat.active {
  color: #244f2a;
  background: #fff;
  font-weight: 800;
}

.side-cat.active::before {
  position: absolute;
  top: 30rpx;
  bottom: 30rpx;
  left: 0;
  width: 6rpx;
  content: "";
  border-radius: 999rpx;
  background: #4f7d43;
}

.drink-list {
  height: 100%;
  padding: 24rpx 30rpx 150rpx;
}

.list-heading {
  margin-bottom: 16rpx;
  color: #111;
  font-size: 34rpx;
  font-weight: 800;
}

.drink-item {
  position: relative;
  min-height: 246rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.drink-item.active .drink-name {
  color: #4f7d43;
}

.drink-main {
  display: flex;
  gap: 30rpx;
  text-align: left;
}

.drink-thumb {
  flex: 0 0 184rpx;
  width: 184rpx;
  height: 216rpx;
  border-radius: 12rpx;
  background: #f0eee7;
}

.drink-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  min-height: 216rpx;
  flex-direction: column;
  justify-content: center;
  padding-right: 58rpx;
}

.drink-name {
  color: #111;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.25;
}

.drink-note {
  margin-top: 22rpx;
  overflow: hidden;
  color: #777;
  font-size: 24rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drink-price {
  margin-top: 42rpx;
  color: #111;
  font-size: 30rpx;
  font-weight: 800;
}

.round-add {
  position: absolute;
  right: 4rpx;
  bottom: 78rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 999rpx;
  background: #4f7d43;
  box-shadow: 0 4rpx 10rpx rgba(79, 125, 67, 0.24);
}

.plus-icon {
  width: 22rpx;
  height: 22rpx;
  display: block;
}

.order-cart-pill {
  position: fixed;
  right: 74rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  left: 74rpx;
  z-index: 20;
  min-height: 84rpx;
  display: grid;
  grid-template-columns: 58rpx 1fr auto auto;
  gap: 18rpx;
  align-items: center;
  padding: 12rpx 16rpx 12rpx 24rpx;
  color: #fff;
  border-radius: 24rpx;
  background: #223529;
  box-shadow: 0 16rpx 34rpx rgba(23, 44, 30, 0.2);
}

.cart-icon-large {
  position: relative;
  width: 54rpx;
  height: 54rpx;
}

.cart-icon-large image {
  width: 50rpx;
  height: 50rpx;
  display: block;
}

.cart-icon-large text {
  position: absolute;
  top: -20rpx;
  right: -18rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4f7d43;
  border-radius: 50%;
  background: #fff;
  font-size: 18rpx;
  font-weight: 800;
}

.bar-title {
  min-width: 0;
  color: #fff;
  font-size: 28rpx;
}

.bar-total {
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}

.checkout-chip {
  min-width: 136rpx;
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  border-radius: 999rpx;
  background: #6f9c55;
  font-size: 28rpx;
  font-weight: 800;
}

.order-tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 18;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eeeeee;
}

.order-tab {
  min-height: 78rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #777;
  font-size: 24rpx;
}

.order-tab.active {
  color: #4f7d43;
  font-weight: 800;
}

.order-tab-icon {
  width: 42rpx;
  height: 42rpx;
  display: block;
}

.empty-list {
  padding: 80rpx 0;
  color: #888;
  text-align: center;
  font-size: 26rpx;
}
