.tea-menu-page {
  height: 100vh;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #fff;
}

.page-nav {
  flex: 0 0 auto;
  background: #fff;
}

.nav-inner {
  height: 72rpx;
  display: grid;
  grid-template-columns: 160rpx 1fr 160rpx;
  align-items: center;
  padding: 0 16rpx;
}

.nav-side {
  min-width: 0;
  display: flex;
  align-items: center;
}

.nav-side-right {
  justify-content: flex-end;
}

.page-title {
  text-align: center;
  color: #111;
  font-size: 32rpx;
  font-weight: 600;
}

.table-chip {
  max-width: 150rpx;
  min-height: 52rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  color: #416d38;
  border-radius: 999rpx;
  background: #edf4ea;
  font-size: 20rpx;
  font-weight: 600;
}

.table-chip image {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.table-chip text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-tools {
  flex: 0 0 auto;
  padding: 12rpx 28rpx 16rpx;
  background: #fff;
}

.order-search {
  height: 66rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f0f0ef;
}

.order-search image {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.order-search input {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  color: #233b31;
  font-size: 24rpx;
}

.order-search text {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7b786f;
  font-size: 34rpx;
  line-height: 1;
}

.ordering-shell {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 176rpx minmax(0, 1fr);
  overflow: hidden;
  border-top: 1rpx solid #eeeeee;
  background: #fff;
}

.side-cats,
.goods-list {
  height: 100%;
}

.side-cats {
  min-width: 0;
  background: #f8f7f5;
}

.side-cat {
  position: relative;
  width: 100%;
  min-height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 16rpx 0 34rpx;
  color: #333;
  background: transparent;
  font-size: 27rpx;
  line-height: 1.2;
  word-break: break-all;
}

.side-cat.active {
  color: #244f2a;
  background: #fff;
  font-weight: 600;
}

.side-cat.active::before {
  position: absolute;
  top: 26rpx;
  bottom: 26rpx;
  left: 0;
  width: 6rpx;
  content: "";
  border-radius: 999rpx;
  background: #4f7d43;
}

.side-safe {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.goods-list {
  width: 100%;
  min-width: 0;
  overflow-x: hidden;
  box-sizing: border-box;
  padding: 20rpx 24rpx 32rpx;
  background: #fff;
}

.hero-card {
  position: relative;
  height: 260rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #f0eee7;
}

.hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    rgba(255, 255, 255, 0.94) 0%,
    rgba(255, 255, 255, 0.78) 38%,
    rgba(255, 255, 255, 0.18) 68%,
    rgba(255, 255, 255, 0) 100%
  );
}

.hero-copy {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 28rpx 30rpx;
  box-sizing: border-box;
}

.hero-name {
  color: #111;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.15;
}

.hero-price {
  margin-top: 12rpx;
  color: #416d38;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 600;
}

.hero-line {
  width: 36rpx;
  height: 3rpx;
  margin: 14rpx 0 12rpx;
  border-radius: 999rpx;
  background: rgba(79, 125, 67, 0.4);
}

.hero-hint {
  max-width: 58%;
  color: #555;
  font-size: 22rpx;
  line-height: 1.4;
}

.hero-tagline {
  max-width: 60%;
  margin-top: 6rpx;
  color: #888;
  font-size: 20rpx;
  line-height: 1.4;
}

.list-heading {
  min-width: 0;
  margin: 18rpx 0 8rpx;
  overflow: hidden;
  color: #111;
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-item {
  position: relative;
  width: 100%;
  min-width: 0;
  min-height: 188rpx;
  padding: 26rpx 56rpx 26rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.goods-main {
  width: 100%;
  min-width: 0;
  display: flex;
  gap: 22rpx;
  text-align: left;
}

.goods-thumb {
  flex: 0 0 126rpx;
  width: 126rpx;
  height: 126rpx;
  border-radius: 50%;
  background: #f0eee7;
}

.goods-copy {
  flex: 1;
  min-width: 0;
}

.goods-name {
  display: -webkit-box;
  overflow: hidden;
  color: #111;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.25;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.goods-note {
  margin-top: 10rpx;
  overflow: hidden;
  color: #777;
  font-size: 25rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-tags {
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.goods-tags text {
  max-width: 100%;
  padding: 4rpx 10rpx;
  overflow: hidden;
  color: #547946;
  border-radius: 6rpx;
  background: #edf4ea;
  font-size: 20rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-bottom {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
}

.goods-price {
  min-width: 0;
  overflow: hidden;
  color: #111;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-price text {
  color: #777;
  font-size: 22rpx;
  font-weight: 500;
}

.round-add {
  position: absolute;
  right: 0;
  bottom: 44rpx;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #fffaf1;
  border-radius: 50%;
  background: #416d38;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
}

.empty-list {
  padding: 80rpx 0;
  color: #888;
  text-align: center;
  font-size: 26rpx;
}

.empty-list text {
  display: block;
  margin-top: 10rpx;
  color: #aaa49a;
  font-size: 22rpx;
}

.list-safe-space {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
