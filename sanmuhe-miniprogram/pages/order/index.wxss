.tea-menu-page {
  height: 100vh;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--hx-text);
  background: var(--hx-page-background);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-nav {
  flex: 0 0 auto;
  background: var(--hx-page-background);
}

.nav-inner {
  height: 88rpx;
  display: grid;
  grid-template-columns: 160rpx 1fr 160rpx;
  align-items: center;
  padding: 0 20rpx;
}

.nav-side {
  min-width: 0;
  display: flex;
  align-items: center;
}

.nav-side-right {
  justify-content: flex-end;
}

.page-title {
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  letter-spacing: 2rpx;
}

/* 桌号为状态展示，不是主 CTA */
.table-chip {
  max-width: 156rpx;
  min-height: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  color: var(--hx-ink);
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.88);
  border: 1rpx solid rgba(82, 107, 69, 0.16);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.2;
}

.table-chip.is-bound {
  color: var(--hx-ink);
  border-color: rgba(82, 107, 69, 0.18);
  background: rgba(255, 253, 248, 0.92);
}

.table-chip.is-unbound {
  color: var(--hx-muted);
  border-style: dashed;
  border-color: rgba(82, 107, 69, 0.28);
  font-size: 20rpx;
}

.table-chip text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ordering-shell {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 148rpx minmax(0, 1fr);
  overflow: hidden;
  background: var(--hx-page-background);
}

.side-cats,
.menu-panel {
  height: 100%;
}

.side-cats {
  min-width: 0;
  background: var(--hx-page-background);
  padding-top: 4rpx;
}

.side-cat {
  position: relative;
  width: 100%;
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 16rpx 0 28rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.side-cat.active {
  color: var(--hx-ink);
  background: var(--hx-page-background);
  font-weight: 600;
}

.side-safe {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.side-safe.with-cart {
  height: calc(280rpx + env(safe-area-inset-bottom));
}

.menu-panel {
  min-width: 0;
  padding: 8rpx 18rpx 0 14rpx;
  box-sizing: border-box;
  background: var(--hx-page-background);
}

.hero-card {
  position: relative;
  height: 280rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--hx-paper);
  box-shadow: 0 8rpx 24rpx rgba(55, 45, 32, 0.06);
}

.hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    rgba(247, 244, 236, 0.96) 0%,
    rgba(247, 244, 236, 0.82) 36%,
    rgba(247, 244, 236, 0.22) 66%,
    rgba(247, 244, 236, 0) 100%
  );
}

.hero-copy {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 28rpx 30rpx;
  box-sizing: border-box;
}

.hero-name {
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: 4rpx;
}

.hero-line {
  width: 36rpx;
  height: 3rpx;
  margin: 16rpx 0 14rpx;
  border-radius: 999rpx;
  background: rgba(23, 59, 42, 0.28);
}

.hero-hint {
  max-width: 58%;
  color: var(--hx-muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.hero-tagline {
  max-width: 60%;
  margin-top: 8rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.option-heading {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 6rpx;
  padding: 18rpx 4rpx 14rpx;
}

.option-title {
  color: var(--hx-muted);
  font-size: 24rpx;
  font-weight: 500;
}

.brew-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: var(--hx-action);
  font-size: 24rpx;
}

.brew-badge image {
  width: 28rpx;
  height: 28rpx;
}

.tea-card {
  position: relative;
  display: grid;
  grid-template-columns: 28rpx 120rpx minmax(0, 1fr) 88rpx;
  gap: 14rpx;
  align-items: center;
  min-height: 200rpx;
  padding: 26rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--hx-line);
}

.tea-category {
  align-self: stretch;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
  line-height: 1.2;
}

.tea-category text {
  display: block;
}

.tea-thumb {
  width: 120rpx;
  height: 120rpx;
  display: block;
  border-radius: 50%;
  background: #f3efe6;
}

.tea-copy {
  min-width: 0;
  padding-right: 4rpx;
}

.tea-name {
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.25;
}

.tea-subtitle {
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--hx-muted);
  font-size: 25rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tea-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tea-tags text {
  max-width: 100%;
  padding: 4rpx 10rpx;
  overflow: hidden;
  color: var(--hx-action);
  border-radius: 6rpx;
  background: var(--hx-sidebar);
  font-size: 24rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tea-thumb {
  width: 120rpx;
  height: 120rpx;
  display: block;
  border-radius: 50%;
  background: var(--hx-paper);
}

.tea-price {
  min-width: 0;
  margin-top: 18rpx;
  overflow: hidden;
  color: var(--hx-ink);
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tea-price text {
  color: var(--hx-muted);
  font-size: 24rpx;
  font-weight: 500;
}

.tea-add {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tea-add image {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.empty-list {
  padding: 80rpx 12rpx;
  color: var(--hx-muted);
  text-align: center;
  font-size: 26rpx;
}

.empty-list text {
  display: block;
  margin-top: 10rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
}

.list-safe-space {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.list-safe-space.with-cart {
  height: calc(280rpx + env(safe-area-inset-bottom));
}

.order-cart-pill {
  position: fixed;
  right: 28rpx;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 30;
  display: flex;
  gap: 18rpx;
  align-items: center;
  min-height: 104rpx;
  padding: 18rpx 26rpx;
  color: #f8f0df;
  background: var(--hx-ink);
  border-radius: 16rpx;
  box-shadow: 0 16rpx 38rpx rgba(31, 54, 45, 0.24);
  text-align: left;
}

.order-cart-copy {
  flex: 1;
  min-width: 0;
}

.order-cart-title {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-cart-meta {
  margin-top: 4rpx;
  overflow: hidden;
  color: #e5cf9d;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-cart-action {
  flex: 0 0 auto;
  min-width: 112rpx;
  font-size: 25rpx;
  font-weight: 600;
  text-align: right;
}
