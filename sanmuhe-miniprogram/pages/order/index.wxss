.order-page {
  padding: 88rpx 0 calc(116rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.back-mark {
  color: #111;
  font-size: 46rpx;
  line-height: 1;
}

.page-title {
  text-align: center;
  color: #111;
  font-size: 32rpx;
  font-weight: 600;
}

.order-context {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 16rpx 28rpx 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fffaf1;
  border: 1rpx solid rgba(35, 59, 49, 0.08);
}

.order-context > view:first-child {
  min-width: 0;
}

.context-title {
  overflow: hidden;
  color: #233b31;
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.context-copy {
  margin-top: 6rpx;
  overflow: hidden;
  color: #746a5c;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.context-scan {
  flex: 0 0 auto;
  min-width: 118rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #4f7d43;
  border-radius: 999rpx;
  background: #edf4ea;
  font-size: 24rpx;
  font-weight: 500;
}

.context-scan image {
  width: 28rpx;
  height: 28rpx;
}

.order-shell {
  position: fixed;
  top: 298rpx;
  right: 0;
  bottom: env(safe-area-inset-bottom);
  left: 0;
  display: grid;
  grid-template-columns: 186rpx minmax(0, 1fr);
  overflow: hidden;
  background: #fff;
  border-top: 1rpx solid #eeeeee;
}

.side-cats {
  height: 100%;
  min-width: 0;
  background: #f8f8f7;
}

.side-cat {
  position: relative;
  width: 100%;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 16rpx 0 34rpx;
  color: #333;
  background: transparent;
  font-size: 27rpx;
  line-height: 1.2;
  word-break: break-all;
}

.side-cat.active {
  color: #244f2a;
  background: #fff;
  font-weight: 600;
}

.side-cat.active::before {
  position: absolute;
  top: 30rpx;
  bottom: 30rpx;
  left: 0;
  width: 6rpx;
  content: "";
  border-radius: 999rpx;
  background: #4f7d43;
}

.drink-list {
  width: 100%;
  height: 100%;
  min-width: 0;
  overflow-x: hidden;
  box-sizing: border-box;
  padding: 24rpx 24rpx 150rpx;
}

.list-heading {
  min-width: 0;
  margin-bottom: 16rpx;
  overflow: hidden;
  color: #111;
  font-size: 34rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drink-item {
  position: relative;
  width: 100%;
  min-width: 0;
  min-height: 246rpx;
  padding: 28rpx 56rpx 28rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.drink-item.active .drink-name {
  color: #4f7d43;
}

.drink-main {
  width: 100%;
  min-width: 0;
  display: flex;
  gap: 22rpx;
  text-align: left;
}

.drink-thumb {
  flex: 0 0 156rpx;
  width: 156rpx;
  height: 196rpx;
  border-radius: 12rpx;
  background: #f0eee7;
}

.drink-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  min-height: 196rpx;
  flex-direction: column;
  justify-content: center;
}

.drink-name {
  display: -webkit-box;
  overflow: hidden;
  color: #111;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.25;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.drink-note {
  margin-top: 22rpx;
  overflow: hidden;
  color: #777;
  font-size: 24rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drink-price {
  margin-top: 42rpx;
  color: #111;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 30rpx;
  font-weight: 600;
}

.round-add {
  position: absolute;
  right: 0;
  bottom: 94rpx;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #fffaf1;
  border-radius: 50%;
  background: #416d38;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
}

.order-cart-pill {
  position: fixed;
  right: 74rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  left: 74rpx;
  z-index: 20;
  min-height: 84rpx;
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr) auto auto;
  gap: 18rpx;
  align-items: center;
  padding: 12rpx 16rpx 12rpx 24rpx;
  color: #fff;
  border-radius: 24rpx;
  background: #223529;
  box-shadow: 0 16rpx 34rpx rgba(23, 44, 30, 0.2);
}

.cart-icon-large {
  position: relative;
  width: 54rpx;
  height: 54rpx;
}

.cart-icon-large image {
  width: 50rpx;
  height: 50rpx;
  display: block;
}

.cart-icon-large text {
  position: absolute;
  top: -20rpx;
  right: -18rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4f7d43;
  border-radius: 50%;
  background: #fff;
  font-size: 18rpx;
  font-weight: 500;
}

.bar-title {
  min-width: 0;
  overflow: hidden;
  color: #fff;
  font-size: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-total {
  color: #fff;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 600;
}

.checkout-chip {
  min-width: 136rpx;
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  border-radius: 999rpx;
  background: #6f9c55;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-list {
  padding: 80rpx 0;
  color: #888;
  text-align: center;
  font-size: 26rpx;
}
