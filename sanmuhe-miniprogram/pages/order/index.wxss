.tea-menu-page {
  height: 100vh;
  padding: 88rpx 0 calc(232rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f7f4ec;
}

.page-nav {
  flex: 0 0 80rpx;
  display: grid;
  grid-template-columns: 100rpx 1fr 100rpx;
  align-items: center;
  padding: 0 28rpx;
}

.nav-side {
  width: 100rpx;
  height: 80rpx;
}

.page-title {
  color: #173b2a;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.table-context {
  flex: 0 0 96rpx;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 8rpx 24rpx 18rpx;
  padding: 12rpx 16rpx 12rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #e8e1d5;
  border-radius: 14rpx;
  background: #fffdf8;
}

.table-copy {
  min-width: 0;
}

.table-title {
  overflow: hidden;
  color: #24392e;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.table-note {
  margin-top: 5rpx;
  overflow: hidden;
  color: #7d756a;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scan-action {
  flex: 0 0 auto;
  min-width: 102rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: #415e4d;
  border-radius: 10rpx;
  background: #edf1e8;
  font-size: 23rpx;
  font-weight: 600;
}

.scan-action image {
  width: 27rpx;
  height: 27rpx;
}

.ordering-shell {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 164rpx minmax(0, 1fr);
  overflow: hidden;
  border-top: 1rpx solid #e8e1d5;
  border-bottom: 1rpx solid #e8e1d5;
  background: #fffdf8;
}

.side-sections,
.menu-list {
  height: 100%;
}

.side-sections {
  min-width: 0;
  background: #f0ece3;
}

.side-section {
  position: relative;
  min-height: 112rpx;
  padding: 23rpx 20rpx 20rpx 30rpx;
  box-sizing: border-box;
  color: #746d63;
}

.side-section text {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
}

.side-section view {
  margin-top: 7rpx;
  color: #9b9388;
  font-size: 19rpx;
}

.side-section.active {
  color: #173b2a;
  background: #fffdf8;
}

.side-section.active::before {
  position: absolute;
  top: 34rpx;
  bottom: 34rpx;
  left: 0;
  width: 6rpx;
  content: "";
  border-radius: 999rpx;
  background: #173b2a;
}

.side-section.active view {
  color: #8b7448;
}

.menu-list {
  min-width: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.list-heading {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eee8de;
}

.list-heading view {
  color: #25372e;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 31rpx;
  font-weight: 600;
}

.list-heading text {
  color: #91887c;
  font-size: 20rpx;
}

.menu-item {
  position: relative;
  min-height: 218rpx;
  display: grid;
  grid-template-columns: 146rpx minmax(0, 1fr);
  gap: 20rpx;
  align-items: center;
  padding: 26rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid #eee8de;
}

.menu-image {
  width: 146rpx;
  height: 164rpx;
  display: block;
  border-radius: 12rpx;
  background: #eee8de;
}

.menu-copy {
  min-width: 0;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-right: 12rpx;
}

.menu-name {
  color: #1f3028;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 32rpx;
  font-weight: 600;
}

.menu-note {
  display: -webkit-box;
  min-height: 58rpx;
  margin-top: 10rpx;
  overflow: hidden;
  color: #777066;
  font-size: 22rpx;
  line-height: 1.35;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.menu-bottom {
  margin-top: 18rpx;
}

.menu-price {
  color: #795832;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 34rpx;
  font-weight: 600;
}

.menu-price > text:first-child {
  margin-right: 2rpx;
  font-size: 22rpx;
}

.menu-unit {
  color: #8c8378;
  font-size: 20rpx;
  font-weight: 400;
}

.round-add {
  position: absolute;
  right: 0;
  bottom: 30rpx;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #173b2a;
  box-shadow: 0 7rpx 16rpx rgba(23, 59, 42, 0.16);
}

.round-add image {
  width: 25rpx;
  height: 25rpx;
}

.empty-menu {
  padding: 90rpx 0;
  color: #4c5b52;
  text-align: center;
  font-size: 27rpx;
}

.empty-menu text {
  display: block;
  margin-top: 10rpx;
  color: #8c8479;
  font-size: 22rpx;
}

.list-safe-space {
  height: 30rpx;
}

.tea-cart-bar {
  position: fixed;
  right: 24rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 40;
  min-height: 94rpx;
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr) 152rpx;
  gap: 16rpx;
  align-items: center;
  padding: 13rpx 14rpx 13rpx 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #ded5c7;
  border-radius: 16rpx;
  background: #fffdf8;
  box-shadow: 0 14rpx 34rpx rgba(45, 40, 31, 0.16);
}

.tea-cart-icon {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tea-cart-icon image {
  width: 48rpx;
  height: 48rpx;
}

.tea-cart-icon text {
  position: absolute;
  top: -9rpx;
  right: -8rpx;
  min-width: 27rpx;
  height: 27rpx;
  padding: 0 5rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #fffdf8;
  border-radius: 999rpx;
  background: #b68e50;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 17rpx;
  font-weight: 600;
}

.tea-cart-copy {
  min-width: 0;
}

.tea-cart-copy view {
  overflow: hidden;
  color: #26382e;
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tea-cart-copy text {
  display: block;
  margin-top: 3rpx;
  overflow: hidden;
  color: #81796e;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tea-cart-action {
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffdf8;
  border-radius: 10rpx;
  background: #173b2a;
  font-size: 25rpx;
  font-weight: 600;
}

.tea-cart-bar.empty .tea-cart-action {
  color: #9b958c;
  background: #e7e2da;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(20, 24, 21, 0.48);
}

.tea-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 81;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  padding: 14rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 26rpx 26rpx 0 0;
  background: #fffdf8;
  box-shadow: 0 -18rpx 54rpx rgba(25, 31, 27, 0.2);
}

.sheet-handle {
  flex: 0 0 auto;
  width: 74rpx;
  height: 7rpx;
  margin: 0 auto 16rpx;
  border-radius: 999rpx;
  background: #d7d0c5;
}

.sheet-head {
  flex: 0 0 auto;
  min-height: 94rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 6rpx 0 20rpx;
  border-bottom: 1rpx solid #e8e1d5;
}

.sheet-title {
  color: #1f3028;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-subtitle {
  margin-top: 7rpx;
  color: #8a8176;
  font-size: 21rpx;
}

.sheet-close {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #675f56;
  font-size: 43rpx;
  line-height: 1;
}

.sheet-options {
  flex: 1;
  min-height: 0;
  max-height: 670rpx;
}

.tea-group {
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #eee8de;
}

.tea-group-name {
  padding-top: 19rpx;
  color: #584d40;
  font-size: 25rpx;
  font-weight: 600;
}

.tea-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.tea-option {
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 14rpx;
  box-sizing: border-box;
  color: #655f57;
  border: 1rpx solid #ded4c5;
  border-radius: 9rpx;
  background: #fffdf8;
  font-size: 23rpx;
  text-align: center;
}

.tea-option.active {
  color: #173b2a;
  border-color: #173b2a;
  background: #edf1e8;
  font-weight: 600;
}

.sheet-footer {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300rpx;
  gap: 24rpx;
  align-items: center;
  padding-top: 22rpx;
  border-top: 1rpx solid #e8e1d5;
}

.sheet-price {
  color: #795832;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 40rpx;
  font-weight: 600;
}

.sheet-price > text:first-child {
  margin-right: 2rpx;
  font-size: 23rpx;
}

.sheet-unit {
  color: #8c8378;
  font-size: 21rpx;
  font-weight: 400;
}

.add-menu-button {
  width: 100%;
  height: 78rpx;
  margin: 0;
  padding: 0;
  color: #fffdf8;
  border-radius: 10rpx;
  background: #173b2a;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.add-menu-button[disabled] {
  color: #9b958c;
  background: #e7e2da;
}

.add-menu-button::after {
  border: none;
}
