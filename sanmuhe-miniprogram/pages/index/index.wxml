<view class="page home">
  <view class="home-nav">
    <view class="brand-title">禾熙</view>
  </view>

  <swiper
    class="hero-swiper"
    autoplay="{{true}}"
    circular="{{true}}"
    interval="3600"
    duration="520"
    bindchange="onHeroChange"
  >
    <swiper-item wx:for="{{heroSlides}}" wx:key="id">
      <view class="hero-slide">
        <image class="hero-image" src="{{item.image}}" mode="aspectFill"></image>
      </view>
    </swiper-item>
  </swiper>
  <view class="hero-dots">
    <view
      wx:for="{{heroSlides}}"
      wx:key="id"
      class="hero-dot {{index === heroCurrent ? 'active' : ''}}"
    ></view>
  </view>

  <view class="quick-grid">
    <view
      wx:for="{{quickActions}}"
      wx:key="key"
      class="quick-item"
      data-key="{{item.key}}"
      bindtap="tapQuickAction"
    >
      <image class="quick-icon" src="{{item.icon}}" mode="aspectFit"></image>
      <view class="quick-title">{{item.title}}</view>
      <view class="quick-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="member-strip" bindtap="goMember">
    <view class="member-mark">
      <image src="/assets/icons/leaf-white.png" mode="aspectFit"></image>
    </view>
    <view class="member-copy">
      <view>
        <text class="member-name">禾熙会员</text>
        <text class="growth-pill">积分自动累计</text>
      </view>
      <view class="member-meta">支付成功后更新等级、积分与可用优惠券</view>
    </view>
    <view class="member-link">查看权益 ›</view>
  </view>

  <view class="section-head">
    <view class="section-title">本季推荐</view>
    <view class="section-link" bindtap="goShop">查看更多 ›</view>
  </view>

  <view class="recommend-grid">
    <view wx:for="{{recommendTeas}}" wx:key="id" class="recommend-card" data-id="{{item.id}}" bindtap="goProduct">
      <image class="recommend-image" src="{{item.displayImage}}" mode="aspectFill"></image>
      <view class="recommend-body">
        <view class="recommend-tag">{{item.seasonTag}}</view>
        <view class="recommend-name">{{item.name}}</view>
        <view class="recommend-note">{{item.shortNote}}</view>
        <view class="recommend-bottom">
          <view class="recommend-price">¥{{item.price}}<text>/{{item.unit}}</text></view>
          <view class="recommend-add" data-id="{{item.id}}" catchtap="addRecommended">+</view>
        </view>
      </view>
    </view>
  </view>

  <view class="scene-grid">
    <view class="scene-card room" bindtap="goReservation">
      <image src="https://7361-sanmuhe-env-d3g1nt3jsa1be67e3-1316449112.tcb.qcloud.la/assets/images/home-room-card.jpg" mode="aspectFill"></image>
    </view>
    <view class="scene-card event" bindtap="goEvents">
      <image src="https://7361-sanmuhe-env-d3g1nt3jsa1be67e3-1316449112.tcb.qcloud.la/assets/images/home-event-card.jpg" mode="aspectFill"></image>
    </view>
  </view>

  <view wx:if="{{cartCount > 0}}" class="floating-cart" bindtap="goCart">
    <view>
      <view class="cart-title">购物车 {{cartCount}} 件</view>
      <view class="cart-meta">合计 ¥{{cartTotal}}</view>
    </view>
    <view class="cart-arrow">去结算</view>
  </view>
</view>
