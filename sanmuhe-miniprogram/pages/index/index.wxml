<scroll-view
  scroll-y
  class="home-scroll"
  refresher-enabled="{{true}}"
  refresher-triggered="{{refreshing}}"
  refresher-default-style="black"
  refresher-background="#fffdf8"
  bindrefresherrefresh="onPullRefresh"
>
<view class="page home">
  <view class="home-nav">
    <image
      class="brand-lockup"
      src="/assets/images/home-brand-lockup.jpg"
      mode="widthFix"
      aria-role="img"
      aria-label="禾煦茶印，一杯好茶，日日相伴"
    ></image>
  </view>

  <swiper
    class="hero-swiper"
    autoplay="{{true}}"
    circular="{{true}}"
    interval="3600"
    duration="520"
    easing-function="easeOutCubic"
    bindchange="onHeroChange"
  >
    <swiper-item wx:for="{{heroSlides}}" wx:key="id">
      <view class="hero-slide">
        <!-- 首屏轮播禁止懒加载，避免先空白再出图的一晃 -->
        <image class="hero-image" src="{{item.image}}" mode="aspectFill" lazy-load="{{false}}"></image>
      </view>
    </swiper-item>
  </swiper>
  <view class="hero-dots">
    <view
      wx:for="{{heroSlides}}"
      wx:key="id"
      class="hero-dot {{index === heroCurrent ? 'active' : ''}}"
    ></view>
  </view>

  <view class="quick-grid">
    <view
      wx:for="{{quickActions}}"
      wx:key="key"
      class="quick-item"
      data-key="{{item.key}}"
      bindtap="tapQuickAction"
    >
      <image class="quick-icon" src="{{item.icon}}" mode="aspectFit"></image>
      <view class="quick-title">{{item.title}}</view>
      <view class="quick-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="member-strip" bindtap="goMember">
    <view class="member-mark">
      <image src="/assets/icons/leaf-white.png" mode="aspectFit"></image>
    </view>
    <view class="member-copy">
      <view>
        <text class="member-name">禾煦会员</text>
        <text class="growth-pill">积分自动累计</text>
      </view>
      <view class="member-meta">储值礼遇：充 500 送 100 · 充 1000 送 250</view>
    </view>
    <view class="member-link">查看权益 ›</view>
  </view>

  <view class="section-head">
    <view class="section-title">本季推荐</view>
    <view class="section-link" bindtap="goShop">查看更多 ›</view>
  </view>

  <view wx:if="{{recommendTeas.length}}" class="recommend-grid">
    <view wx:for="{{recommendTeas}}" wx:key="id" class="recommend-card" data-id="{{item.id}}" bindtap="goProduct">
      <image class="recommend-image" src="{{item.displayImage}}" mode="aspectFill"></image>
      <view class="recommend-body">
        <view class="recommend-tag">{{item.seasonTag}}</view>
        <view class="recommend-name">{{item.name}}</view>
        <view class="recommend-note">{{item.shortNote}}</view>
        <view class="recommend-bottom">
          <view class="recommend-price">¥{{item.price}}<text>/{{item.unit}}</text></view>
          <view class="recommend-add" data-id="{{item.id}}" catchtap="addRecommended">+</view>
        </view>
      </view>
    </view>
  </view>
  <view wx:else class="recommend-empty">
    <text wx:if="{{catalogError}}">推荐暂时无法加载</text>
    <text wx:elif="{{catalogLoading}}">正在更新推荐</text>
    <text wx:else>暂无在售茶品</text>
  </view>

</view>
</scroll-view>

  <!-- 首页小购物车：有货时显示，点击进购物车；放在 scroll-view 外以免跟着滚 -->
  <view
    wx:if="{{cartCount > 0}}"
    class="cart-fab"
    hover-class="cart-fab-hover"
    bindtap="goCart"
    aria-role="button"
    aria-label="购物车{{cartCount}}件，合计{{cartTotal}}元"
  >
    <image class="cart-fab-icon" src="/assets/icons/cart-white.png" mode="aspectFit"></image>
    <view class="cart-fab-badge">{{cartCount > 99 ? '99+' : cartCount}}</view>
  </view>
