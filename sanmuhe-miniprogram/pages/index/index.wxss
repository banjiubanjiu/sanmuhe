.home-scroll {
  height: 100vh;
  box-sizing: border-box;
  background: #fffdf8;
}

.home {
  padding: 88rpx 30rpx calc(142rpx + env(safe-area-inset-bottom));
  /* 与 logo 锁图底色、--hx-page-background 一致 */
  background: #fffdf8;
}

.home-nav {
  min-height: 148rpx;
  display: flex;
  align-items: center;
}

.brand-lockup {
  width: 342rpx;
  height: auto;
  display: block;
}

.hero-swiper {
  height: 368rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #d9ddd3;
  box-shadow: 0 10rpx 24rpx rgba(31, 54, 45, 0.08);
}

.hero-slide {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.hero-image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-dots {
  position: relative;
  z-index: 2;
  height: 44rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: -44rpx;
  margin-left: 42rpx;
}

.hero-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.42);
}

.hero-dot.active {
  background: #fff;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  margin-top: 42rpx;
  padding: 26rpx 0 24rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(48, 40, 30, 0.08);
}

.quick-item {
  position: relative;
  min-width: 0;
  padding: 0 8rpx;
  text-align: center;
}

.quick-icon {
  width: 104rpx;
  height: 104rpx;
  display: block;
  margin: 0 auto;
  border: 0;
  border-radius: 50%;
  background: transparent;
}

.quick-title {
  margin-top: 12rpx;
  overflow: hidden;
  color: #182f1f;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-desc {
  margin-top: 8rpx;
  overflow: hidden;
  color: #89857a;
  font-size: 20rpx;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-strip {
  min-height: 100rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr auto;
  gap: 18rpx;
  align-items: center;
  margin-top: 34rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #edf4e7 0%, #fbfbef 100%);
  box-shadow: 0 8rpx 22rpx rgba(48, 40, 30, 0.04);
}

.member-mark {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #416d38;
}

.member-mark image {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.member-copy {
  min-width: 0;
}

.member-name {
  color: #315f2f;
  font-size: 29rpx;
  font-weight: 600;
}

.growth-pill {
  display: inline-flex;
  margin-left: 16rpx;
  padding: 5rpx 12rpx;
  color: #7a632f;
  border-radius: 999rpx;
  background: #eee8d4;
  font-size: 22rpx;
}

.member-meta {
  margin-top: 8rpx;
  overflow: hidden;
  color: #68645b;
  font-size: 24rpx;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-link {
  color: #315f2f;
  font-size: 24rpx;
  font-weight: 600;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 36rpx;
}

.section-title {
  color: #111;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.section-link {
  color: #77736b;
  font-size: 25rpx;
  font-weight: 400;
}

.recommend-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 22rpx;
}

.recommend-empty {
  margin-top: 22rpx;
  padding: 48rpx 12rpx;
  color: #77736b;
  font-size: 24rpx;
  text-align: center;
}

.recommend-card {
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid #f0ede7;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(48, 40, 30, 0.04);
}

.recommend-image {
  width: 100%;
  height: 138rpx;
  display: block;
  overflow: hidden;
  background: #ece8df;
}

.recommend-body {
  padding: 12rpx 14rpx 14rpx;
}

.recommend-tag {
  display: inline-flex;
  max-width: 100%;
  padding: 4rpx 10rpx;
  overflow: hidden;
  color: #7c612d;
  border-radius: 4rpx;
  background: #f2ead9;
  font-size: 20rpx;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-name {
  margin-top: 11rpx;
  overflow: hidden;
  color: #111;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.22;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-note {
  margin-top: 8rpx;
  overflow: hidden;
  color: #77736b;
  font-size: 23rpx;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 16rpx;
}

.recommend-price {
  min-width: 0;
  overflow: hidden;
  color: #111;
  font-family: "DIN Alternate", "Georgia", "Times New Roman", serif;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-price text {
  margin-left: 4rpx;
  color: #756f66;
  font-size: 20rpx;
  font-weight: 400;
}

.recommend-add {
  flex: 0 0 42rpx;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffaf1;
  border-radius: 50%;
  background: #416d38;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
}

/* 首页小购物车角标 */
.cart-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(148rpx + env(safe-area-inset-bottom));
  z-index: 30;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #233b31;
  box-shadow: 0 12rpx 28rpx rgba(31, 54, 45, 0.28);
}

.cart-fab-hover {
  opacity: 0.9;
}

.cart-fab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.cart-fab-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #233b31;
  border-radius: 999rpx;
  background: #e8c988;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
}
