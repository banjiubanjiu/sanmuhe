.address-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(160rpx + env(safe-area-inset-bottom));
  background: #f7f4ec;
  box-sizing: border-box;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.addr-card {
  display: flex;
  align-items: stretch;
  gap: 0;
  padding: 0;
  border-radius: 16rpx;
  background: #fffdf8;
  border: 1rpx solid #e8e1d5;
  overflow: hidden;
}

.addr-main {
  flex: 1;
  min-width: 0;
  padding: 28rpx 24rpx 28rpx 28rpx;
}

.addr-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
}

.addr-name {
  color: #173b2a;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}

.addr-phone {
  color: #4a433b;
  font-size: 28rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.addr-default {
  padding: 2rpx 10rpx;
  color: #3f5b43;
  font-size: 20rpx;
  line-height: 1.4;
  border-radius: 6rpx;
  background: rgba(52, 75, 56, 0.1);
}

.addr-line {
  margin-top: 14rpx;
  color: #5c544b;
  font-size: 26rpx;
  line-height: 1.5;
}

.addr-edit {
  flex: 0 0 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6f685f;
  font-size: 26rpx;
  border-left: 1rpx solid #efe9de;
  background: rgba(247, 244, 236, 0.55);
}

.empty-state {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.35;
}

.empty-title {
  margin-top: 28rpx;
  color: #173b2a;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 10rpx;
  color: #9a9288;
  font-size: 24rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 244, 236, 0), #f7f4ec 28%);
  box-sizing: border-box;
}

.add-btn {
  margin: 0;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffaf0;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  background: #2f4734;
  box-shadow: 0 10rpx 24rpx rgba(47, 71, 52, 0.16);
}

.add-btn::after {
  border: none;
}

.footer-link {
  margin-top: 18rpx;
  text-align: center;
  color: #9a9288;
  font-size: 24rpx;
  line-height: 1.2;
  padding: 8rpx;
}
