.cart-page {
  padding: 88rpx 28rpx calc(230rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.page-title {
  text-align: center;
  color: #111;
  font-size: 32rpx;
  font-weight: 800;
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.cart-empty {
  padding: 70rpx 34rpx;
}

.empty-title {
  color: #233b31;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-copy {
  margin: 14rpx auto 0;
  max-width: 480rpx;
  color: #746a5c;
  font-size: 25rpx;
  line-height: 1.55;
}

.empty-action {
  width: 260rpx;
  margin: 34rpx auto 0;
}

.cart-item {
  display: flex;
  gap: 20rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: rgba(255, 252, 246, 0.92);
  border: 1rpx solid rgba(35, 59, 49, 0.08);
}

.cart-swatch,
.cart-image {
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 14rpx;
}

.cart-copy {
  flex: 1;
  min-width: 0;
}

.cart-name {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.28;
}

.cart-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.stepper {
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid rgba(35, 59, 49, 0.16);
  border-radius: 12rpx;
}

.step-btn,
.qty {
  width: 64rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #233b31;
  font-weight: 800;
}

.qty {
  width: 72rpx;
  background: #ead8b3;
}

.form-block {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 26rpx;
}

.bar-title {
  color: #233b31;
  font-weight: 800;
}

.bar-meta {
  margin-top: 4rpx;
  color: #a05537;
  font-size: 24rpx;
  font-weight: 700;
}
