.cart-page {
  min-height: 100vh;
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  padding: 88rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
  background: var(--hx-page-background);
  box-sizing: border-box;
}

.cart-page-empty {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.back-mark {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--hx-ink);
  font-size: 48rpx;
  line-height: 1;
}

.page-title {
  text-align: center;
  color: var(--hx-ink);
  font-size: 36rpx;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-weight: 600;
}

.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
}

.empty-cart {
  margin-top: 120rpx;
  padding: 0 24rpx;
  text-align: center;
}

.empty-title {
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 38rpx;
  font-weight: 600;
}

.empty-copy {
  margin-top: 18rpx;
  color: var(--hx-muted);
  font-size: 27rpx;
  line-height: 1.6;
}

.empty-action {
  width: 280rpx;
  height: 78rpx;
  margin: 42rpx auto 0;
  color: #fffaf1;
  border-radius: 999rpx;
  background: var(--hx-action);
  font-size: 30rpx;
  font-weight: 600;
}

.cart-group {
  margin-top: 28rpx;
}

.group-head {
  margin-bottom: 16rpx;
}

.group-title {
  color: var(--hx-text);
  font-size: 28rpx;
  font-weight: 600;
}

.group-card {
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--hx-surface);
  box-shadow: 0 10rpx 28rpx rgba(48, 40, 30, 0.05);
}

.cart-row {
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr) 44rpx;
  gap: 16rpx;
  align-items: center;
  padding: 22rpx 18rpx;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.cart-row + .cart-row {
  border-top: 1rpx solid var(--hx-line);
}

.cart-image,
.cart-swatch {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
}

.cart-image {
  display: block;
  background: #f3eee4;
}

.cart-copy {
  min-width: 0;
}

.cart-name {
  color: var(--hx-ink);
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-option {
  margin-top: 8rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-bottom {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
}

.row-price {
  flex: 0 1 auto;
  min-width: 0;
  color: #b04737;
  font-size: 30rpx;
  font-weight: 600;
}

.stepper {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  max-width: 100%;
}

/* 用 view 代替 button，避免小程序 button 默认 min-width 撑破布局 */
.step-btn {
  width: 48rpx;
  height: 48rpx;
  min-width: 48rpx;
  max-width: 48rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--hx-text);
  border-radius: 50%;
  background: var(--hx-sidebar);
  font-size: 30rpx;
  line-height: 1;
  overflow: hidden;
}

.step-btn-hover {
  opacity: 0.72;
}

.qty {
  min-width: 32rpx;
  max-width: 56rpx;
  padding: 0 2rpx;
  text-align: center;
  color: var(--hx-text);
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.delete-btn {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--hx-muted);
  font-size: 34rpx;
  line-height: 1;
}

.note-block {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: var(--hx-surface);
  box-shadow: 0 10rpx 28rpx rgba(48, 40, 30, 0.05);
  box-sizing: border-box;
}

.section-label {
  margin-bottom: 14rpx;
  color: var(--hx-text);
  font-size: 27rpx;
  font-weight: 600;
}

.section-label + .method-row,
.section-label + .pay-row {
  margin-top: 0;
}

.method-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.method-chip {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid var(--hx-line);
  background: var(--hx-field);
  color: var(--hx-text);
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.method-chip.active {
  color: var(--hx-action);
  border-color: var(--hx-action);
  background: var(--hx-sidebar);
  font-weight: 600;
}

.fulfill-card {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: var(--hx-field);
  border: 1rpx solid var(--hx-field-line);
  box-sizing: border-box;
}

.fulfill-card.table-card {
  margin-top: 0;
}

.fulfill-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 48rpx;
}

.fulfill-line + .fulfill-line {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--hx-line);
}

.fulfill-k {
  flex: 0 0 auto;
  width: 120rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
}

.fulfill-v {
  flex: 1 1 auto;
  min-width: 0;
  color: var(--hx-ink);
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fulfill-name {
  color: var(--hx-ink);
  font-size: 28rpx;
  font-weight: 600;
}

.fulfill-addr {
  margin-top: 8rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.fulfill-meta {
  margin-top: 10rpx;
  color: var(--hx-muted);
  font-size: 22rpx;
}

.fulfill-empty {
  color: var(--hx-muted);
  font-size: 28rpx;
  text-align: center;
  padding: 12rpx 0;
}

.fulfill-phone-btn {
  flex: 0 0 auto;
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  line-height: 56rpx;
  color: #fff;
  border-radius: 999rpx;
  background: var(--hx-action);
  font-size: 24rpx;
  font-weight: 600;
}

.fulfill-phone-btn::after,
.fulfill-link-btn::after {
  border: none;
}

.fulfill-link-btn {
  flex: 0 0 auto;
  height: 48rpx;
  margin: 0;
  padding: 0 12rpx;
  line-height: 48rpx;
  color: var(--hx-action);
  background: transparent;
  font-size: 24rpx;
  font-weight: 500;
}

.fulfill-link {
  flex: 0 0 auto;
  color: var(--hx-muted);
  font-size: 24rpx;
  padding: 0 4rpx;
}

/* 已绑定：一行淡提示，不占结算表单 */
.contact-bound-hint {
  margin-bottom: 16rpx;
  padding: 12rpx 4rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
}

.pickup-bind-note {
  margin-top: 10rpx;
  color: var(--hx-muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.field {
  height: 78rpx;
  padding: 0 22rpx;
  color: var(--hx-text);
  border-radius: 14rpx;
  background: var(--hx-field);
  font-size: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--hx-field-line);
}

.field-tight {
  margin-top: 12rpx;
  height: 72rpx;
}

.field-remark {
  margin-bottom: 20rpx;
  background: var(--hx-field);
}

.field + .field {
  margin-top: 14rpx;
}

.pay-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 20rpx 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--hx-line);
  background: var(--hx-surface);
  box-sizing: border-box;
}

.pay-row.active {
  border-color: var(--hx-action);
  background: var(--hx-sidebar);
}

.pay-row.disabled {
  opacity: 0.5;
}

.pay-row-main {
  flex: 1 1 auto;
  min-width: 0;
}

.pay-row-title {
  color: var(--hx-text);
  font-size: 28rpx;
  font-weight: 600;
}

.pay-row-sub {
  margin-top: 4rpx;
  color: var(--hx-muted);
  font-size: 22rpx;
}

.pay-row-amt {
  flex: 0 0 auto;
  color: #a94a32;
  font-size: 28rpx;
  font-weight: 600;
}

.address-block {
  margin-top: 8rpx;
}

.address-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.address-title {
  margin-top: 18rpx;
}

.address-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 18rpx;
}

.address-pick {
  color: var(--hx-action);
  font-size: 24rpx;
  font-weight: 600;
}

.address-pick.muted {
  color: var(--hx-muted);
  font-weight: 500;
}

.address-card {
  margin-top: 12rpx;
  margin-bottom: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: var(--hx-field);
  border: 1rpx solid var(--hx-field-line);
}

.address-card.soft {
  margin-bottom: 14rpx;
}

.address-name {
  color: var(--hx-ink);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.address-detail {
  margin-top: 8rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.address-source {
  margin-top: 10rpx;
  color: var(--hx-muted);
  font-size: 20rpx;
  opacity: 0.85;
}

.address-empty {
  margin-top: 12rpx;
  margin-bottom: 8rpx;
  padding: 28rpx 20rpx;
  border-radius: 14rpx;
  border: 1rpx dashed var(--hx-line);
  color: var(--hx-muted);
  font-size: 26rpx;
  text-align: center;
}

.pickup-phone-block {
  margin-bottom: 14rpx;
}

.pickup-phone-ok {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 14rpx;
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--hx-field);
  border: 1rpx solid var(--hx-field-line);
}

.pickup-phone-label {
  color: var(--hx-muted);
  font-size: 24rpx;
}

.pickup-phone-value {
  color: var(--hx-ink);
  font-size: 30rpx;
  font-weight: 600;
}

.pickup-phone-tag {
  color: var(--hx-action);
  font-size: 22rpx;
}

.pickup-phone-btn {
  width: 100%;
  height: 80rpx;
  margin: 0;
  padding: 0 20rpx;
  box-sizing: border-box;
  color: #fff;
  border-radius: 999rpx;
  background: var(--hx-action);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.pickup-phone-btn::after {
  border: none;
}

.pickup-phone-note {
  margin-top: 10rpx;
  color: var(--hx-muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.pickup-manual-link {
  margin-top: 12rpx;
  margin-bottom: 4rpx;
  color: var(--hx-action);
  font-size: 24rpx;
  text-align: center;
}

.payment-title {
  margin-top: 26rpx;
  color: var(--hx-text);
  font-size: 27rpx;
  font-weight: 600;
}

.payment-option {
  display: grid;
  grid-template-columns: 36rpx minmax(0, 1fr) auto;
  gap: 16rpx;
  align-items: center;
  margin-top: 14rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid var(--hx-line);
  border-radius: 14rpx;
  background: var(--hx-surface);
}

.payment-option.active {
  border-color: var(--hx-action);
  background: var(--hx-sidebar);
  box-shadow: inset 0 0 0 2rpx rgba(49, 95, 47, 0.1);
}

.payment-option.disabled {
  opacity: 0.55;
}

.payment-radio {
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #a49b8f;
  border-radius: 50%;
}

.payment-option.active .payment-radio {
  border-color: var(--hx-action);
}

.payment-option.active .payment-radio view {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--hx-action);
}

.payment-copy {
  min-width: 0;
}

.payment-copy view {
  color: var(--hx-text);
  font-size: 27rpx;
  font-weight: 600;
}

.payment-copy text {
  display: block;
  margin-top: 6rpx;
  color: var(--hx-muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.payment-amount {
  color: #a94a32;
  font-size: 26rpx;
  font-weight: 600;
}

.pay-hint {
  margin-top: 18rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.checkout-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 45;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--hx-surface);
  border-top: 1rpx solid var(--hx-line);
  box-shadow: 0 -12rpx 34rpx rgba(51, 42, 30, 0.08);
  overflow: hidden;
}

.checkout-total {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
}

.checkout-total view {
  color: var(--hx-muted);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-total text {
  display: block;
  margin-top: 4rpx;
  color: #b04737;
  font-size: 36rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 覆盖小程序 button 默认 min-width / margin，避免「去支付」撑出屏幕 */
.checkout-action {
  flex: 0 0 auto;
  width: 240rpx;
  min-width: 0;
  max-width: 42%;
  height: 84rpx;
  margin: 0 !important;
  padding: 0 20rpx;
  box-sizing: border-box;
  color: #fff;
  border-radius: 999rpx;
  background: var(--hx-action);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(51, 97, 45, 0.24);
  overflow: hidden;
}

.checkout-action::after {
  border: none;
}
