.cart-page {
  min-height: 100vh;
  padding: 88rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
  background: var(--hx-page-background);
  box-sizing: border-box;
}

.cart-page-empty {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.back-mark {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--hx-ink);
  font-size: 48rpx;
  line-height: 1;
}

.page-title {
  text-align: center;
  color: var(--hx-ink);
  font-size: 36rpx;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-weight: 600;
}

.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
}

.empty-cart {
  margin-top: 120rpx;
  padding: 0 24rpx;
  text-align: center;
}

.empty-title {
  color: var(--hx-ink);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 38rpx;
  font-weight: 600;
}

.empty-copy {
  margin-top: 18rpx;
  color: var(--hx-muted);
  font-size: 27rpx;
  line-height: 1.6;
}

.empty-action {
  width: 280rpx;
  height: 78rpx;
  margin: 42rpx auto 0;
  color: #fffaf1;
  border-radius: 999rpx;
  background: var(--hx-action);
  font-size: 30rpx;
  font-weight: 600;
}

.cart-group {
  margin-top: 28rpx;
}

.group-head {
  margin-bottom: 16rpx;
}

.group-title {
  color: var(--hx-text);
  font-size: 28rpx;
  font-weight: 600;
}

.group-card {
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--hx-surface);
  box-shadow: 0 10rpx 28rpx rgba(48, 40, 30, 0.05);
}

.cart-row {
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr) 48rpx;
  gap: 18rpx;
  align-items: center;
  padding: 22rpx 20rpx;
}

.cart-row + .cart-row {
  border-top: 1rpx solid var(--hx-line);
}

.cart-image,
.cart-swatch {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
}

.cart-image {
  display: block;
  background: #f3eee4;
}

.cart-copy {
  min-width: 0;
}

.cart-name {
  color: var(--hx-ink);
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-option {
  margin-top: 8rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-bottom {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.row-price {
  color: #b04737;
  font-size: 30rpx;
  font-weight: 600;
}

.stepper {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.step-btn {
  width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--hx-text);
  border-radius: 50%;
  background: var(--hx-sidebar);
  font-size: 30rpx;
  line-height: 1;
}

.step-btn::after {
  border: none;
}

.qty {
  min-width: 36rpx;
  text-align: center;
  color: var(--hx-text);
  font-size: 28rpx;
  font-weight: 600;
}

.delete-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--hx-muted);
  font-size: 34rpx;
}

.note-block {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: var(--hx-surface);
  box-shadow: 0 10rpx 28rpx rgba(48, 40, 30, 0.05);
}

.field {
  height: 78rpx;
  padding: 0 22rpx;
  color: var(--hx-text);
  border-radius: 14rpx;
  background: var(--hx-field);
  font-size: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--hx-field-line);
}

.field + .field {
  margin-top: 14rpx;
}

.payment-title {
  margin-top: 26rpx;
  color: var(--hx-text);
  font-size: 27rpx;
  font-weight: 600;
}

.payment-option {
  display: grid;
  grid-template-columns: 36rpx minmax(0, 1fr) auto;
  gap: 16rpx;
  align-items: center;
  margin-top: 14rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid var(--hx-line);
  border-radius: 14rpx;
  background: var(--hx-surface);
}

.payment-option.active {
  border-color: var(--hx-action);
  background: var(--hx-sidebar);
  box-shadow: inset 0 0 0 2rpx rgba(49, 95, 47, 0.1);
}

.payment-option.disabled {
  opacity: 0.55;
}

.payment-radio {
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #a49b8f;
  border-radius: 50%;
}

.payment-option.active .payment-radio {
  border-color: var(--hx-action);
}

.payment-option.active .payment-radio view {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--hx-action);
}

.payment-copy {
  min-width: 0;
}

.payment-copy view {
  color: var(--hx-text);
  font-size: 27rpx;
  font-weight: 600;
}

.payment-copy text {
  display: block;
  margin-top: 6rpx;
  color: var(--hx-muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.payment-amount {
  color: #a94a32;
  font-size: 26rpx;
  font-weight: 600;
}

.pay-hint {
  margin-top: 18rpx;
  color: var(--hx-muted);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.checkout-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 45;
  display: grid;
  grid-template-columns: 1fr 280rpx;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--hx-surface);
  border-top: 1rpx solid var(--hx-line);
  box-shadow: 0 -12rpx 34rpx rgba(51, 42, 30, 0.08);
}

.checkout-total view {
  color: var(--hx-muted);
  font-size: 24rpx;
}

.checkout-total text {
  display: block;
  margin-top: 4rpx;
  color: #b04737;
  font-size: 40rpx;
  font-weight: 600;
}

.checkout-action {
  height: 84rpx;
  margin: 0;
  color: #fff;
  border-radius: 999rpx;
  background: var(--hx-action);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(51, 97, 45, 0.24);
}

.checkout-action::after {
  border: none;
}
