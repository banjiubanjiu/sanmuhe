<view class="page cart-page {{items.length === 0 ? 'cart-page-empty' : ''}}">
  <view class="page-nav">
    <view class="back-mark" bindtap="goBack">‹</view>
    <view class="page-title">{{pageTitle}}</view>
    <view class="nav-placeholder"></view>
  </view>

  <block wx:if="{{items.length === 0}}">
    <view class="empty-cart">
      <view class="empty-title">{{emptyTitle}}</view>
      <view class="empty-copy">{{emptyCopy}}</view>
      <button class="empty-action" bindtap="goShop">{{isDineIn ? '返回堂饮茶单' : '去选茶品'}}</button>
    </view>
  </block>

  <block wx:if="{{items.length > 0}}">
    <view class="cart-group">
      <view class="group-head">
        <view class="group-title">已选 {{count}} 件</view>
      </view>
      <view class="group-card">
        <view wx:for="{{items}}" wx:key="key" class="cart-row">
          <image wx:if="{{item.image}}" class="cart-image" src="{{item.image}}" mode="aspectFill"></image>
          <view wx:if="{{!item.image}}" class="cart-swatch" style="background: {{item.color}};"></view>
          <view class="cart-copy">
            <view class="cart-name">{{item.name}}</view>
            <view class="cart-option">{{item.optionText}}</view>
            <view class="row-bottom">
              <view class="row-price">¥{{item.price}}</view>
              <view class="stepper">
                <view
                  class="step-btn"
                  hover-class="step-btn-hover"
                  data-key="{{item.key}}"
                  data-quantity="{{item.quantity}}"
                  bindtap="decrease"
                >−</view>
                <text class="qty">{{item.quantity}}</text>
                <view
                  class="step-btn"
                  hover-class="step-btn-hover"
                  data-key="{{item.key}}"
                  data-quantity="{{item.quantity}}"
                  bindtap="increase"
                >+</view>
              </view>
            </view>
          </view>
          <view class="delete-btn" data-key="{{item.key}}" bindtap="removeItem">×</view>
        </view>
      </view>
    </view>

    <view class="note-block">
      <!-- 商城：配送方式 -->
      <block wx:if="{{!isDineIn}}">
        <view class="payment-title">配送方式</view>
        <view
          class="payment-option {{deliveryMethod === 'pickup' ? 'active' : ''}}"
          data-method="pickup"
          bindtap="chooseDelivery"
        >
          <view class="payment-radio"><view></view></view>
          <view class="payment-copy">
            <view>到店自提</view>
            <text>{{storeAddress}}</text>
          </view>
        </view>
        <view
          class="payment-option {{deliveryMethod === 'shipping' ? 'active' : ''}}"
          data-method="shipping"
          bindtap="chooseDelivery"
        >
          <view class="payment-radio"><view></view></view>
          <view class="payment-copy">
            <view>快递邮寄</view>
            <text>需选择微信收货地址</text>
          </view>
        </view>

        <view wx:if="{{deliveryMethod === 'shipping'}}" class="address-block">
          <view class="address-head">
            <view class="payment-title address-title">收货地址</view>
            <view class="address-pick" bindtap="chooseAddress">{{hasAddress ? '更换地址' : '选择微信地址'}}</view>
          </view>
          <view wx:if="{{hasAddress}}" class="address-card">
            <view class="address-name">{{consignee}}　{{phone}}</view>
            <view class="address-detail">{{address}}</view>
          </view>
          <view wx:else class="address-empty" bindtap="chooseAddress">请选择收货地址 ›</view>
        </view>

        <view wx:if="{{deliveryMethod === 'pickup'}}" class="address-block">
          <view class="payment-title address-title">自提信息</view>
          <view class="address-card soft">
            <view class="address-detail">自提点：{{storeAddress}}</view>
          </view>
          <input
            class="field"
            placeholder="联系人姓名（必填）"
            data-field="consignee"
            value="{{consignee}}"
            bindinput="onInput"
          />
          <input
            class="field"
            placeholder="手机号（必填）"
            type="number"
            maxlength="11"
            data-field="phone"
            value="{{phone}}"
            bindinput="onInput"
          />
        </view>
      </block>

      <input
        wx:if="{{isDineIn}}"
        class="field"
        placeholder="桌号（选填）"
        data-field="tableNo"
        value="{{tableNo}}"
        bindinput="onInput"
      />
      <input
        class="field"
        placeholder="{{isDineIn ? '品饮备注（选填）' : '订单备注（选填）'}}"
        data-field="remark"
        value="{{remark}}"
        bindinput="onInput"
      />
      <view class="payment-title">支付方式</view>
      <view
        wx:if="{{isMember}}"
        class="payment-option {{payMode === 'balance' ? 'active' : ''}} {{!balanceAvailable ? 'disabled' : ''}}"
        data-mode="balance"
        bindtap="choosePayMode"
      >
        <view class="payment-radio"><view></view></view>
        <view class="payment-copy">
          <view>会员余额支付</view>
          <text>当前余额 ¥{{walletBalance}}{{balanceAvailable ? '，本单默认优先使用' : '，余额不足'}}</text>
        </view>
        <view class="payment-amount">-¥{{total}}</view>
      </view>
      <view
        class="payment-option {{payMode === 'wechat' ? 'active' : ''}}"
        data-mode="wechat"
        bindtap="choosePayMode"
      >
        <view class="payment-radio"><view></view></view>
        <view class="payment-copy">
          <view>微信支付</view>
          <text>确认后调起微信收银台，在线付款</text>
        </view>
        <view class="payment-amount">¥{{total}}</view>
      </view>
      <view
        class="payment-option {{payMode === 'manual' ? 'active' : ''}}"
        data-mode="manual"
        bindtap="choosePayMode"
      >
        <view class="payment-radio"><view></view></view>
        <view class="payment-copy">
          <view>柜台扫码付款</view>
          <text>{{isDineIn ? '确认茶单后由门店备茶并引导付款' : '确认茶品后由门店备货并引导付款'}}</text>
        </view>
      </view>
      <view class="pay-hint">{{payHintText}}</view>
    </view>

    <view class="checkout-bar simple">
      <view class="checkout-total">
        <view>合计 {{count}} 件</view>
        <text>¥{{total}}</text>
      </view>
      <button class="checkout-action" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitOrder">{{isDineIn ? '确认茶单' : '确认茶品'}}</button>
    </view>
  </block>

  <privacy-gate
    show="{{privacyGateOpen}}"
    purpose="{{privacyPurpose}}"
    contractName="{{privacyContractName}}"
    bindagree="onPrivacyAgree"
    bindcancel="onPrivacyCancel"
  />
</view>
