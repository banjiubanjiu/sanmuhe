<view class="page cart-page {{items.length === 0 ? 'cart-page-empty' : ''}}">
  <view class="page-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="back-mark" bindtap="goBack">‹</view>
    <view class="page-title">{{pageTitle}}</view>
    <view class="nav-placeholder"></view>
  </view>

  <block wx:if="{{items.length === 0}}">
    <view class="empty-cart">
      <view class="empty-title">{{emptyTitle}}</view>
      <view class="empty-copy">{{emptyCopy}}</view>
      <button class="empty-action" bindtap="goShop">{{isDineIn ? '返回堂饮茶单' : '去选茶品'}}</button>
    </view>
  </block>

  <block wx:if="{{items.length > 0}}">
    <view class="cart-group">
      <view class="group-head">
        <view class="group-title">已选 {{count}} 件</view>
      </view>
      <view class="group-card">
        <view wx:for="{{items}}" wx:key="key" class="cart-row">
          <image wx:if="{{item.image}}" class="cart-image" src="{{item.image}}" mode="aspectFill"></image>
          <view wx:if="{{!item.image}}" class="cart-swatch" style="background: {{item.color}};"></view>
          <view class="cart-copy">
            <view class="cart-name">{{item.name}}</view>
            <view class="cart-option">{{item.optionText}}</view>
            <view class="row-bottom">
              <view class="row-price">¥{{item.price}}</view>
              <view class="stepper">
                <view
                  class="step-btn"
                  hover-class="step-btn-hover"
                  data-key="{{item.key}}"
                  data-quantity="{{item.quantity}}"
                  bindtap="decrease"
                >−</view>
                <text class="qty">{{item.quantity}}</text>
                <view
                  class="step-btn"
                  hover-class="step-btn-hover"
                  data-key="{{item.key}}"
                  data-quantity="{{item.quantity}}"
                  bindtap="increase"
                >+</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="note-block">
      <!-- 商城：取茶方式（短、清晰） -->
      <block wx:if="{{!isDineIn}}">
        <view class="section-label">取茶方式</view>
        <view class="method-row">
          <view
            class="method-chip {{deliveryMethod === 'pickup' ? 'active' : ''}}"
            data-method="pickup"
            bindtap="chooseDelivery"
          >到店自提</view>
          <view
            class="method-chip {{deliveryMethod === 'shipping' ? 'active' : ''}}"
            data-method="shipping"
            bindtap="chooseDelivery"
          >快递到付</view>
        </view>

        <!-- 自提：等 contactReady 再渲染，避免未绑定→已绑定闪一下 -->
        <view
          wx:if="{{deliveryMethod === 'pickup' && contactReady && hasBoundPhone}}"
          class="contact-bound-hint"
        >
          <text>取货通知 {{phoneMasked || '已绑定手机'}}</text>
        </view>
        <view
          wx:if="{{deliveryMethod === 'pickup' && contactReady && !hasBoundPhone}}"
          class="fulfill-card"
        >
          <view class="fulfill-line">
            <text class="fulfill-k">取货手机</text>
            <button
              class="fulfill-phone-btn"
              open-type="getPhoneNumber"
              loading="{{phoneResolving}}"
              disabled="{{phoneResolving}}"
              bindgetphonenumber="handlePickupPhone"
            >微信手机号</button>
          </view>
          <view class="pickup-bind-note">取货通知用，授权一次后下次不用再填</view>
          <input
            wx:if="{{showManualPhone}}"
            class="field field-tight"
            placeholder="填写取货手机号"
            type="number"
            maxlength="11"
            focus="{{showManualPhone}}"
            data-field="phone"
            value="{{phone}}"
            bindinput="onInput"
          />
        </view>

        <!-- 快递：当前地址；选择、编辑与新增统一进入地址簿 -->
        <view wx:if="{{deliveryMethod === 'shipping'}}" class="shipping-block">
          <view class="address-entry" hover-class="address-entry-hover" bindtap="openAddressBook">
            <view wx:if="{{hasAddress}}" class="address-entry-body">
              <view class="address-entry-top">
                <text class="address-entry-name">{{consignee}}</text>
                <text class="address-entry-phone">{{phoneMasked || phone}}</text>
              </view>
              <view class="address-entry-line">{{address}}</view>
            </view>
            <view wx:else class="address-entry-placeholder">请选择地址</view>
            <text class="address-entry-arrow">›</text>
          </view>
        </view>
      </block>

      <!-- 堂饮：桌号只读一行 -->
      <view wx:if="{{isDineIn && tableDisplay}}" class="fulfill-card table-card">
        <view class="fulfill-line">
          <text class="fulfill-k">桌号</text>
          <text class="fulfill-v">{{tableDisplay}}</text>
        </view>
      </view>

      <input
        class="field field-remark"
        placeholder="{{isDineIn ? '备注（选填）' : '备注（选填）'}}"
        data-field="remark"
        value="{{remark}}"
        bindinput="onInput"
      />

      <view wx:if="{{!isDineIn}}" class="fee-card">
        <view class="fee-row">
          <text class="fee-k">商品金额</text>
          <text class="fee-v">¥{{goodsTotal}}</text>
        </view>
        <view class="fee-row">
          <text class="fee-k">运费</text>
          <text class="fee-v">{{deliveryMethod === 'shipping' ? (freightCollect ? '到付' : (shippingFee > 0 ? '¥' + shippingFee : '包邮')) : '自提免运费'}}</text>
        </view>
        <view wx:if="{{shippingHint}}" class="fee-hint">{{shippingHint}}</view>
        <!-- 到付时应付=商品金额，不再重复一行合计；仅预收运费时展示 -->
        <view wx:if="{{payableTotal != goodsTotal}}" class="fee-row fee-total">
          <text class="fee-k">应付合计</text>
          <text class="fee-v">¥{{payableTotal}}</text>
        </view>
      </view>

      <view class="section-label">支付</view>
      <view
        wx:if="{{isMember}}"
        class="pay-row {{payMode === 'balance' ? 'active' : ''}} {{!balanceAvailable ? 'disabled' : ''}}"
        data-mode="balance"
        bindtap="choosePayMode"
      >
        <view class="pay-row-main">
          <view class="pay-row-title">会员余额</view>
          <view class="pay-row-sub">余额 ¥{{walletBalance}}{{balanceAvailable ? '' : ' · 不足'}}</view>
        </view>
      </view>
      <view
        class="pay-row {{payMode === 'wechat' ? 'active' : ''}}"
        data-mode="wechat"
        bindtap="choosePayMode"
      >
        <view class="pay-row-main">
          <view class="pay-row-title">微信支付</view>
        </view>
      </view>
    </view>

    <view class="checkout-bar simple">
      <view class="checkout-total">
        <view>合计 {{count}} 件{{!isDineIn && deliveryMethod === 'shipping' && freightCollect ? ' · 运费到付' : (!isDineIn && deliveryMethod === 'shipping' && shippingFee > 0 ? ' · 含运费' : '')}}</view>
        <text>¥{{payableTotal || total}}</text>
      </view>
      <button class="checkout-action" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitOrder">{{payMode === 'balance' ? '余额支付' : '去支付'}}</button>
    </view>
  </block>

  <privacy-gate
    show="{{privacyGateOpen}}"
    purpose="{{privacyPurpose}}"
    contractName="{{privacyContractName}}"
    bindagree="onPrivacyAgree"
    bindcancel="onPrivacyCancel"
  />
</view>
