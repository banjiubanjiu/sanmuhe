.events-page {
  padding: 88rpx 28rpx calc(132rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 132rpx;
  align-items: center;
}

.back-mark {
  color: #111;
  font-size: 46rpx;
  line-height: 1;
}

.page-title {
  text-align: center;
  color: #111;
  font-size: 32rpx;
  font-weight: 800;
}

.mini-capsule {
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  border: 1rpx solid #4f7d43;
  border-radius: 999rpx;
  background: #4f7d43;
  font-size: 24rpx;
  font-weight: 800;
}

.event-tabs {
  margin-top: 34rpx;
  white-space: nowrap;
}

.event-tab {
  position: relative;
  display: inline-flex;
  min-height: 58rpx;
  align-items: center;
  margin-right: 70rpx;
  color: #777;
  font-size: 30rpx;
}

.event-tab.active {
  color: #111;
  font-weight: 800;
}

.event-tab.active::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 5rpx;
  content: "";
  border-radius: 999rpx;
  background: #4f7d43;
}

.event-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-top: 28rpx;
}

.event-card {
  display: flex;
  gap: 24rpx;
  min-height: 294rpx;
  padding: 0 18rpx 0 0;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
}

.event-image {
  flex: 0 0 306rpx;
  width: 306rpx;
  height: 293rpx;
  border-radius: 10rpx;
  background: #eee;
}

.event-main {
  flex: 1;
  min-width: 0;
  padding: 22rpx 0;
}

.event-title {
  color: #111;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.25;
}

.event-summary {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #666;
  font-size: 25rpx;
  line-height: 1.55;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.event-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  color: #666;
  font-size: 24rpx;
}

.event-line image,
.signup-line image {
  width: 20rpx;
  height: 20rpx;
  display: block;
}

.event-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  color: #666;
  font-size: 24rpx;
}

.signup-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.join-pill {
  min-width: 98rpx;
  min-height: 54rpx;
  color: #fff;
  border-radius: 999rpx;
  background: #4f7d43;
  font-size: 25rpx;
  font-weight: 800;
}

.join-pill.disabled {
  color: #777;
  background: #eeeeea;
}
