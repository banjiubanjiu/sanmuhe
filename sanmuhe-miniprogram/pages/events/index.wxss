.events-page {
  padding: 88rpx 32rpx calc(148rpx + env(safe-area-inset-bottom));
  background: #f8f3ea;
}

.page-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 120rpx 1fr 120rpx;
  align-items: center;
}

.page-title {
  color: #111;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
}

.nav-capsule {
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  justify-self: end;
  padding: 0 14rpx;
  border: 1rpx solid #e6dfd2;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
}

.nav-capsule text {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #111;
}

.nav-capsule view {
  width: 36rpx;
  height: 36rpx;
  margin-left: 12rpx;
  border: 6rpx solid #111;
  border-radius: 50%;
}

.event-intro {
  margin-top: 42rpx;
  text-align: center;
}

.event-place {
  color: #a57c3c;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
}

.event-slogan {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 24rpx;
  align-items: center;
  margin: 18rpx auto 0;
  color: #2f2922;
}

.event-slogan text {
  height: 1rpx;
  background: #b5a17e;
}

.event-slogan view {
  color: #2f2922;
  font-size: 25rpx;
  line-height: 1.2;
}

.event-hero {
  width: 100%;
  height: 285rpx;
  display: block;
  margin-top: 42rpx;
  border-radius: 18rpx;
  background: #d8d0bf;
  box-shadow: 0 16rpx 36rpx rgba(62, 47, 28, 0.11);
}

.event-tabs {
  width: 100%;
  margin-top: 34rpx;
  white-space: nowrap;
}

.event-tab {
  min-width: 126rpx;
  min-height: 62rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  padding: 0 34rpx;
  color: #4c453b;
  border: 1rpx solid #ddd4c4;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 27rpx;
}

.event-tab.active {
  color: #fffaf0;
  border-color: #385835;
  background: #385835;
  font-weight: 600;
}

.event-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 30rpx;
}

.event-card {
  min-height: 218rpx;
  display: grid;
  grid-template-columns: 288rpx 1fr 166rpx;
  gap: 22rpx;
  align-items: center;
  padding: 10rpx 22rpx 10rpx 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(87, 73, 52, 0.08);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 30rpx rgba(56, 42, 28, 0.07);
}

.event-image {
  width: 288rpx;
  height: 188rpx;
  display: block;
  border-radius: 14rpx;
  background: #eee8dc;
}

.event-main {
  min-width: 0;
  padding: 8rpx 0;
}

.event-title {
  overflow: hidden;
  color: #16120f;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.22;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-summary {
  display: -webkit-box;
  margin-top: 11rpx;
  overflow: hidden;
  color: #4b4238;
  font-size: 25rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.event-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  color: #5f584e;
  font-size: 24rpx;
  line-height: 1.2;
}

.event-line image {
  width: 24rpx;
  height: 24rpx;
  display: block;
  flex: 0 0 24rpx;
}

.event-line text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-action-col {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
}

.join-pill {
  min-width: 118rpx;
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.join-pill.primary {
  color: #fffaf0;
  background: #385835;
}

.join-pill.outline {
  color: #a57c3c;
  border: 1rpx solid #b89358;
  background: rgba(255, 252, 246, 0.8);
}

.join-pill.disabled {
  color: #8b877e;
  background: #ede9e1;
}

.event-arrow {
  color: #8b877e;
  font-size: 44rpx;
  line-height: 1;
}

.event-note {
  position: relative;
  min-height: 126rpx;
  display: grid;
  grid-template-columns: 82rpx 84rpx 1rpx 1fr;
  gap: 22rpx;
  align-items: center;
  margin-top: 30rpx;
  padding: 24rpx 30rpx;
  overflow: hidden;
  border: 1rpx solid rgba(87, 73, 52, 0.08);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 28rpx rgba(56, 42, 28, 0.06);
}

.note-mark {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #b89358;
  border-radius: 50%;
}

.note-mark image {
  width: 38rpx;
  height: 38rpx;
  display: block;
}

.note-title {
  color: #2d251d;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.25;
}

.note-divider {
  width: 1rpx;
  height: 86rpx;
  background: #e1d8ca;
}

.note-copy {
  position: relative;
  z-index: 1;
  color: #3f382f;
  font-size: 23rpx;
  line-height: 1.72;
}

.note-copy view::before {
  content: "•";
  margin-right: 12rpx;
}

.note-bamboo {
  position: absolute;
  right: 28rpx;
  bottom: -12rpx;
  color: rgba(56, 88, 53, 0.12);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 116rpx;
  line-height: 1;
}

.signup-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 80;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 19, 0.36);
}

.signup-sheet {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  padding: 34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.sheet-title {
  color: #111;
  font-size: 34rpx;
  font-weight: 600;
}

.sheet-event {
  margin-top: 10rpx;
  color: #4f7d43;
  font-size: 25rpx;
  font-weight: 600;
}

.sheet-close {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #555;
  border-radius: 50%;
  background: #f4f4f0;
  font-size: 40rpx;
}

.signup-summary {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #fffaf1;
  color: #233b31;
  font-size: 27rpx;
  font-weight: 600;
}

.signup-summary text {
  display: block;
  margin-top: 8rpx;
  color: #746a5c;
  font-size: 23rpx;
  font-weight: 500;
}

.form-fields {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.submit-signup {
  width: 100%;
  min-height: 86rpx;
  margin-top: 26rpx;
  color: #fff;
  border-radius: 999rpx;
  background: #4f7d43;
  font-size: 30rpx;
  font-weight: 600;
}

.submit-signup::after {
  border: 0;
}
