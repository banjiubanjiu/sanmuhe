<view class="page events-page">
  <view class="page-nav">
    <view class="back-mark" bindtap="goBack">‹</view>
    <view class="page-title">活动发布</view>
    <view class="mini-capsule" bindtap="publishEvent">发布</view>
  </view>

  <scroll-view scroll-x class="event-tabs">
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="event-tab {{activeCategory === item ? 'active' : ''}}"
      data-category="{{item}}"
      bindtap="changeCategory"
    >{{item}}</view>
  </scroll-view>

  <view class="event-list section">
    <view wx:for="{{events}}" wx:key="id" class="event-card">
      <image class="event-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="event-main">
        <view class="event-title">{{item.title}}</view>
        <view class="event-summary">{{item.summary}}</view>
        <view class="event-line">
          <image src="/assets/icons/clock-line.png" mode="aspectFit"></image>
          <text>{{item.date}} {{item.time}}</text>
        </view>
        <view class="event-line">
          <image src="/assets/icons/map-pin-line.png" mode="aspectFit"></image>
          <text>{{item.place}}</text>
        </view>
        <view class="event-foot">
          <view class="signup-line">
            <image src="/assets/icons/users-line.png" mode="aspectFit"></image>
            <text>已报名 {{item.signed}}/{{item.quota}}</text>
          </view>
          <button class="join-pill {{item.canJoin ? '' : 'disabled'}}" disabled="{{!item.canJoin}}" data-id="{{item.id}}" bindtap="joinEvent">{{item.joinText}}</button>
        </view>
      </view>
    </view>
    <view wx:if="{{events.length === 0}}" class="empty compact">暂无活动</view>
  </view>
</view>
