<view class="page events-page">
  <view class="page-nav">
    <view class="back-btn" bindtap="goBack" hover-class="back-btn-hover">
      <text class="back-mark">‹</text>
    </view>
    <view class="page-title">茶事活动</view>
    <view class="nav-side-right"></view>
  </view>

  <view class="event-intro">
    <view class="event-place">
      <text>禾煦</text>
      <view></view>
      <text>佛山</text>
    </view>
    <view class="event-lead">以茶养心</view>
    <view class="event-slogan">
      四时清雅，择一席茶会安放心绪
    </view>
  </view>

  <image class="event-hero" src="/assets/images/event-yangxin-tea.jpg" mode="aspectFill"></image>

  <scroll-view scroll-x class="event-tabs" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="event-tab {{activeCategory === item ? 'active' : ''}}"
      data-category="{{item}}"
      bindtap="changeCategory"
    >{{item}}</view>
  </scroll-view>

  <view class="event-list">
    <view wx:for="{{events}}" wx:key="id" class="event-card" data-id="{{item.id}}" bindtap="viewEvent">
      <image class="event-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="event-main">
        <view class="event-title">{{item.title}}</view>
        <view class="event-summary">{{item.summary}}</view>
        <view class="event-line">
          <image src="/assets/icons/clock-line.png" mode="aspectFit"></image>
          <text>{{item.date}} {{item.time}}</text>
        </view>
        <view class="event-line">
          <image src="/assets/icons/map-pin-line.png" mode="aspectFit"></image>
          <text>{{item.place}}</text>
        </view>
        <view class="event-line">
          <image src="/assets/icons/users-line.png" mode="aspectFit"></image>
          <text>{{item.limitText}}</text>
        </view>
      </view>
      <view class="event-action-col">
        <view class="join-pill wait">敬请期待</view>
        <view class="event-arrow">›</view>
      </view>
    </view>
    <view wx:if="{{events.length === 0}}" class="empty compact">暂无活动</view>
  </view>

  <view class="event-note">
    <image class="event-note-image" src="/assets/images/event-note.jpg" mode="widthFix"></image>
  </view>
</view>
