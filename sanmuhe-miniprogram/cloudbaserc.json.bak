{
  "version": "2.0",
  "envId": "cloudbase-d2gq023qn50e9d82f",
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "getOpenId",
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "getCatalog",
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "seedDemoData",
      "runtime": "Nodejs16.13",
      "handler": "index.main",
      "envVariables": {
        "SEED_DEMO_ENABLED": "false",
        "ADMIN_USERNAMES": "admin"
      },
      "installDependency": true,
      "timeout": 60
    },
    {
      "name": "manageCatalog",
      "type": "Event",
      "handler": "index.main",
      "timeout": 30,
      "runtime": "Nodejs16.13",
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "ADMIN_OPENIDS": "oKIOSxIJnzCHtDxNQrsUGWSLbkRM",
        "STAFF_OPENIDS": "oKIOSxIJnzCHtDxNQrsUGWSLbkRM",
        "ADMIN_UIDS": "",
        "ADMIN_USERNAMES": "admin"
      }
    },
    {
      "name": "manageOperations",
      "type": "Event",
      "handler": "index.main",
      "timeout": 30,
      "runtime": "Nodejs16.13",
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "ADMIN_OPENIDS": "oKIOSxIJnzCHtDxNQrsUGWSLbkRM",
        "STAFF_OPENIDS": "oKIOSxIJnzCHtDxNQrsUGWSLbkRM",
        "ADMIN_UIDS": "",
        "ADMIN_USERNAMES": "admin"
      }
    },
    {
      "name": "createOrder",
      "type": "Event",
      "handler": "index.main",
      "timeout": 30,
      "runtime": "Nodejs16.13",
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "FREE_SHIPPING_AMOUNT": "0",
        "ORDER_LOCK_MINUTES": "15",
        "SHIPPING_FEE": "0",
        "ADMIN_OPENIDS": "oKIOSxIJnzCHtDxNQrsUGWSLbkRM",
        "STAFF_OPENIDS": "oKIOSxIJnzCHtDxNQrsUGWSLbkRM"
      }
    },
    {
      "name": "createPayment",
      "runtime": "Nodejs16.13",
      "handler": "index.main",
      "timeout": 30,
      "installDependency": true,
      "envVariables": {
        "REAL_PAYMENT_ENABLED": "false"
      }
    },
    {
      "name": "wechatPayNotify",
      "runtime": "Nodejs16.13",
      "type": "HTTP"
    },
    {
      "name": "releaseOrderLocks",
      "runtime": "Nodejs16.13",
      "handler": "index.main",
      "triggers": [
        {
          "name": "release-order-locks-every-5-min",
          "type": "timer",
          "config": "0 */5 * * * * *"
        }
      ]
    },
    {
      "name": "createReservation",
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "listEvents",
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "createEvent",
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "joinEvent",
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "listMyRecords",
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "cleanupSmokeData",
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "serviceNotify",
      "type": "Event",
      "handler": "index.main",
      "timeout": 15,
      "runtime": "Nodejs16.13",
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "ADMIN_OPENIDS": "oKIOSxIJnzCHtDxNQrsUGWSLbkRM",
        "STAFF_OPENIDS": "oKIOSxIJnzCHtDxNQrsUGWSLbkRM",
        "MINIPROGRAM_STATE": "developer"
      }
    },
    {
      "name": "memberCenter",
      "type": "Event",
      "handler": "index.main",
      "timeout": 15,
      "runtime": "Nodejs16.13",
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "ADMIN_OPENIDS": "oKIOSxIJnzCHtDxNQrsUGWSLbkRM,o6zAJs5352XYBdvRcQrWzkCEZJRY",
        "STAFF_OPENIDS": "oKIOSxIJnzCHtDxNQrsUGWSLbkRM,o6zAJs5352XYBdvRcQrWzkCEZJRY",
        "MEMBER_TEST_MODE": "true",
        "MEMBER_TEST_OPENIDS": "oKIOSxIJnzCHtDxNQrsUGWSLbkRM,o6zAJs5352XYBdvRcQrWzkCEZJRY",
        "REAL_PAYMENT_ENABLED": "false"
      }
    }
  ]
}
