.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 10rpx 10rpx calc(10rpx + env(safe-area-inset-bottom));
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  border-top: 1rpx solid #e8e1d5;
  background: #fffdf8;
}

.tab-item {
  display: flex;
  min-width: 0;
  min-height: 94rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #665f55;
  font-weight: 500;
}

.tab-item.active {
  color: #416d38;
  background: transparent;
  font-weight: 600;
}

.tab-image {
  width: 42rpx;
  height: 42rpx;
  display: block;
}

.tab-label {
  font-size: 24rpx;
  line-height: 1.1;
}
