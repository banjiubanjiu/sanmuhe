.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 10rpx 10rpx calc(10rpx + env(safe-area-inset-bottom));
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", "PingFang SC", "Helvetica Neue", serif;
  border-top: 1rpx solid #eeeeee;
  background: #fff;
}

.tab-item {
  display: flex;
  min-width: 0;
  min-height: 94rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #777;
  font-weight: 500;
}

.tab-item.active {
  color: #4f7d43;
  background: transparent;
}

.tab-image {
  width: 42rpx;
  height: 42rpx;
  display: block;
}

.tab-label {
  font-size: 22rpx;
  line-height: 1.1;
}
