page {
  min-height: 100%;
  color: #233b31;
  background: #f7f7f4;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
  letter-spacing: 0;
}

button {
  width: auto;
  min-width: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  border: 0;
  line-height: inherit;
  background: transparent;
  border-radius: 0;
}

button::after {
  display: none;
}

.page {
  min-height: 100vh;
  padding: 34rpx 28rpx calc(132rpx + env(safe-area-inset-bottom));
}

.page.with-safe-bar {
  padding-bottom: calc(288rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  color: #9a6546;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.h1 {
  margin-top: 14rpx;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.08;
  color: #1f362d;
}

.h2 {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #1f362d;
}

.muted {
  color: #746a5c;
  line-height: 1.55;
}

.section {
  margin-top: 38rpx;
}

.surface {
  background: rgba(255, 252, 246, 0.92);
  border: 1rpx solid rgba(66, 49, 31, 0.1);
  border-radius: 16rpx;
  box-shadow: 0 12rpx 34rpx rgba(63, 48, 31, 0.07);
}

.ink-button,
.light-button,
.line-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  padding: 0 30rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.ink-button {
  color: #f9f2e3;
  background: linear-gradient(135deg, #1f362d 0%, #2e5040 100%);
  box-shadow: 0 12rpx 28rpx rgba(31, 54, 45, 0.22);
}

.light-button {
  color: #243b31;
  background: #e7d1a0;
}

.line-button {
  color: #243b31;
  border: 1rpx solid rgba(35, 59, 49, 0.22);
  background: rgba(255, 252, 246, 0.82);
}

.ink-button:active,
.light-button:active,
.line-button:active,
.pill:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.pill-row {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  padding: 2rpx 0 8rpx;
}

.pill {
  flex: 0 0 auto;
  min-height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(35, 59, 49, 0.16);
  color: #655c50;
  background: rgba(255, 252, 246, 0.86);
  font-size: 25rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pill.active {
  color: #f9f2e3;
  border-color: #233b31;
  background: #233b31;
}

.price {
  color: #a05537;
  font-size: 30rpx;
  font-weight: 800;
}

.field {
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(35, 59, 49, 0.14);
  color: #233b31;
  background: rgba(255, 252, 246, 0.94);
}

.textarea-field {
  width: 100%;
  min-height: 168rpx;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(35, 59, 49, 0.14);
  color: #233b31;
  background: rgba(255, 252, 246, 0.94);
}

input::placeholder,
textarea::placeholder {
  color: #a09583;
}

.safe-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(255, 252, 246, 0.97);
  border-top: 1rpx solid rgba(35, 59, 49, 0.1);
  box-shadow: 0 -14rpx 40rpx rgba(56, 42, 28, 0.1);
}

.safe-bar.tab-safe-bar {
  bottom: calc(108rpx + env(safe-area-inset-bottom));
}

.safe-bar-main {
  flex: 1;
}

.safe-bar-action {
  width: 240rpx;
}

.empty {
  padding: 56rpx 28rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(35, 59, 49, 0.08);
  background: rgba(255, 252, 246, 0.82);
  color: #756b5c;
  line-height: 1.5;
  text-align: center;
}
